<!DOCTYPE html>
<html lang="en">

<head>
    <title>AHMS :: IPD Billing List</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Iconic Bootstrap 4.5.0 Admin Template" />
    <meta name="author" content="WrapTheme, design by: ThemeMakker.com" />
    <link rel="icon" href="favicon.ico" type="image/x-icon" />

    <!-- VENDOR CSS -->
    <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="../dist/assets/css/tabulator_bootstrap5.css" />

    <!-- MAIN Project CSS file -->
    <link rel="stylesheet" href="../dist/assets/css/main.css" />
</head>

<body data-theme="light" class="font-nunito">
    <div id="wrapper" class="theme-cyan">
        <%- include('navbar') %>

        <div id="main-content">
            <div class="container-fluid">
                <div class="block-header">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <h2>Indoor Billing</h2>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/index"><i class="fa fa-dashboard"></i></a>
                                </li>
                                <li class="breadcrumb-item">Billing</li>
                                <li class="breadcrumb-item active">Indoor Billing</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="row clearfix">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="header">
                                <h2>IPD Payments List</h2>
                            </div>

                            <!-- Payment Modal -->
                            <div class="modal fade" id="payment" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="paymentModalLabel">
                                                Payment Details:
                                                <span id="transaction-id"></span>
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="btn-group" role="group" aria-label="Payment Method">
                                                <input type="radio" class="btn-check" name="paymentMethod" id="cash" value="CASH" checked />
                                                <label class="btn btn-outline-primary" for="cash">Cash</label>

                                                <input type="radio" class="btn-check" name="paymentMethod" id="upi" value="UPI" />
                                                <label class="btn btn-outline-primary" for="upi">UPI</label>

                                                <input type="radio" class="btn-check" name="paymentMethod" id="card" value="CARD" />
                                                <label class="btn btn-outline-primary" for="card">Card</label>
                                            </div>

                                            <div class="form-group mt-3">
                                                <label for="payment-amount">Payment Amount</label>
                                                <input type="number" class="form-control" id="payment-amount" required />
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <button type="button" class="btn btn-primary" onclick="processPayment()">Process Payment</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="body">
                                <div class="row g-2 align-items-end mb-3" id="bill-filters">
                                    <div class="col-md-4">
                                        <label for="billSearch" class="form-label small mb-1">Search</label>
                                        <input type="search" class="form-control form-control-sm" id="billSearch"
                                            placeholder="Bill no (e.g. 25-26/IPD/00003), patient ID, name or phone" autocomplete="off">
                                    </div>
                                    <div class="col-6 col-md-2">
                                        <label for="statusFilter" class="form-label small mb-1">Status</label>
                                        <select class="form-control form-control-sm" id="statusFilter">
                                            <option value="">All</option>
                                            <option value="Admitted">Admitted</option>
                                            <option value="Pending">Pending payment</option>
                                            <option value="Paid">Paid</option>
                                        </select>
                                    </div>
                                    <div class="col-6 col-md-2">
                                        <label for="dateFrom" class="form-label small mb-1">Admitted from</label>
                                        <input type="date" class="form-control form-control-sm" id="dateFrom">
                                    </div>
                                    <div class="col-6 col-md-2">
                                        <label for="dateTo" class="form-label small mb-1">Admitted to</label>
                                        <input type="date" class="form-control form-control-sm" id="dateTo">
                                    </div>
                                    <div class="col-6 col-md-auto">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="clearBillFilters">
                                            <i class="fa fa-times"></i> Clear filters
                                        </button>
                                    </div>
                                </div>
                                <div id="bills-table"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Javascript -->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>
    <script src="../dist/assets/js/tabulator.min.js"></script>
    <script>
        function getSelectedPaymentMethod() {
            return document.querySelector('input[name="paymentMethod"]:checked').value;
        }

        function processPayment() {
            const appointmentId = document.getElementById('transaction-id').textContent;
            const amount = document.getElementById('payment-amount').value;
            const paymentMethod = getSelectedPaymentMethod();

            fetch('/change-ipd-payment-status', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    appointment_id: appointmentId,
                    amount: amount,
                    payment_method: paymentMethod,
                }),
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('payment')).hide();
                    table.replaceData();
                } else {
                    alert('Error processing payment: ' + data.error);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error processing payment');
            });
        }

        function showPaymentModal(appointmentId, balance) {
            document.getElementById('transaction-id').textContent = appointmentId;
            document.getElementById('payment-amount').value = balance;
            new bootstrap.Modal(document.getElementById('payment')).show();
        }

        function printBill(appointmentId) {
            fetch(`/fetch-ipd-bill-by-id?appointment_id=${appointmentId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (!data.success || !data.data || !data.data.appointment) {
                        throw new Error('Invalid data structure received from server');
                    }

                    const { appointment, particulars } = data.data;
                    const totalBillAmount = particulars.reduce((sum, p) => sum + (p.rate * p.qty), 0);

                    const printWindow = window.open('', '_blank');
                    printWindow.document.write(`
                        <html>
                            <head>
                                <title>IPD Bill - Anugrah Hospital</title>
                                <style>
                                    @page { margin: 10mm; }
                                    body { 
                                        font-family: Arial, sans-serif; 
                                        padding: 10px;
                                        font-size: 12px;
                                        line-height: 1.3;
                                    }
                                    .header { 
                                        text-align: center;
                                        margin-bottom: 10px;
                                        border-bottom: 1px solid #000;
                                        padding-bottom: 5px;
                                    }
                                    .header h1 {
                                        margin: 0;
                                        font-size: 18px;
                                        font-weight: bold;
                                    }
                                    .header p {
                                        margin: 3px 0;
                                        font-size: 11px;
                                    }
                                    .header h2 {
                                        margin: 5px 0;
                                        font-size: 14px;
                                    }
                                    .details { 
                                        margin-bottom: 10px;
                                        display: grid;
                                        grid-template-columns: 1fr 1fr;
                                        gap: 5px;
                                    }
                                    .details p {
                                        margin: 3px 0;
                                    }
                                    .table { 
                                        width: 100%;
                                        border-collapse: collapse;
                                        margin-bottom: 10px;
                                        font-size: 11px;
                                    }
                                    .table th, .table td { 
                                        border: 1px solid #000;
                                        padding: 4px 6px;
                                        text-align: left;
                                    }
                                    .table th {
                                        background-color: #f0f0f0;
                                    }
                                    .footer { 
                                        margin-top: 15px;
                                        text-align: right;
                                        font-size: 11px;
                                    }
                                    .total-row { font-weight: bold; }
                                    .amount { text-align: right; }
                                    h3 { 
                                        margin: 5px 0;
                                        font-size: 13px;
                                    }
                                </style>
                            </head>
                            <body>
                                <div class="header">
                                    <h1>ANUGRAH HOSPITAL</h1>
                                    <p>Plot no. 39/40-7D, Gandhidham (Kutch) 370201</p>
                                    <p>For Appointment: +91 84698 79199, 02836 299350</p>
                                    <h2>IPD Bill</h2>
                                </div>
                                <div class="details">
                                    <p><strong>Bill No:</strong> ${appointment.bill_no}</p>
                                    <p><strong>Patient Name:</strong> ${appointment.patient_name}</p>
                                    <p><strong>Patient ID:</strong> ${appointment.patient_id}</p>
                                    <p><strong>Admission Date:</strong> ${appointment.formatted_admission_date}</p>
                                    <p><strong>Discharge Date:</strong> ${appointment.formatted_discharge_date || 'Not Discharged'}</p>
                                </div>

                                <h3>Particulars</h3>
                                <table class="table">
                                    <tr>
                                        <th>Description</th>
                                        <th>Rate</th>
                                        <th>Qty</th>
                                        <th>Amount</th>
                                    </tr>
                                    ${particulars.map(p => `
                                        <tr>
                                            <td>${p.indoor_service_name}</td>
                                            <td class="amount">₹${parseFloat(p.rate).toFixed(2)}</td>
                                            <td class="amount">${p.qty}</td>
                                            <td class="amount">₹${(p.rate * p.qty).toFixed(2)}</td>
                                        </tr>
                                    `).join('')}
                                    <tr class="total-row">
                                        <td colspan="3" style="text-align: right">Total Bill Amount:</td>
                                        <td class="amount">₹${totalBillAmount.toFixed(2)}</td>
                                    </tr>
                                </table>

                                <div class="footer">
                                    <p>Dr. ${appointment.doctor_name}</p>
                                </div>
                            </body>
                        </html>
                    `);
                    
                    printWindow.document.close();
                    printWindow.focus();

                    // Wait for content to load then print and close
                    printWindow.onload = function() {
                        printWindow.print();
                        // Close window after print dialog is closed
                        setTimeout(() => {
                            printWindow.close();
                        }, 250);
                    };
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error printing bill');
                });
        }

        function printPaymentReceipt(appointmentId) {
            fetch(`/fetch-ipd-bill-by-id?appointment_id=${appointmentId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (!data.success || !data.data || !data.data.appointment) {
                        throw new Error('Invalid data structure received from server');
                    }

                    const { appointment, transactions } = data.data;
                    // Filter only credit transactions
                    const creditTransactions = transactions.filter(t => t.transaction_type === 'credit');
                    const totalPaidAmount = creditTransactions.reduce((sum, t) => sum + parseFloat(t.amount), 0);

                    const printWindow = window.open('', '_blank');
                    printWindow.document.write(`
                        <html>
                            <head>
                                <title>Payment Receipt - Anugrah Hospital</title>
                                <style>
                                    @page { margin: 10mm; }
                                    body { 
                                        font-family: Arial, sans-serif; 
                                        padding: 10px;
                                        font-size: 12px;
                                        line-height: 1.3;
                                    }
                                    .header { 
                                        text-align: center;
                                        margin-bottom: 10px;
                                        border-bottom: 1px solid #000;
                                        padding-bottom: 5px;
                                    }
                                    .header h1 {
                                        margin: 0;
                                        font-size: 18px;
                                        font-weight: bold;
                                    }
                                    .header p {
                                        margin: 3px 0;
                                        font-size: 11px;
                                    }
                                    .header h2 {
                                        margin: 5px 0;
                                        font-size: 14px;
                                    }
                                    .details { 
                                        margin-bottom: 10px;
                                        display: grid;
                                        grid-template-columns: 1fr 1fr;
                                        gap: 5px;
                                    }
                                    .details p {
                                        margin: 3px 0;
                                    }
                                    .table { 
                                        width: 100%;
                                        border-collapse: collapse;
                                        margin-bottom: 10px;
                                        font-size: 11px;
                                    }
                                    .table th, .table td { 
                                        border: 1px solid #000;
                                        padding: 4px 6px;
                                        text-align: left;
                                    }
                                    .table th {
                                        background-color: #f0f0f0;
                                    }
                                    .footer { 
                                        margin-top: 15px;
                                        text-align: right;
                                        font-size: 11px;
                                        border-top: 1px solid #000;
                                        padding-top: 5px;
                                    }
                                    .total-row { font-weight: bold; }
                                    .amount { text-align: right; }
                                    h3 { 
                                        margin: 5px 0;
                                        font-size: 13px;
                                    }
                                </style>
                            </head>
                            <body>
                                <div class="header">
                                    <h1>ANUGRAH HOSPITAL</h1>
                                    <p>Plot no. 39/40-7D, Gandhidham (Kutch) 370201</p>
                                    <p>For Appointment: +91 84698 79199, 02836 299350</p>
                                    <h2>Payment Receipt</h2>
                                </div>
                                <div class="details">
                                    <p><strong>Bill No:</strong> ${appointment.bill_no}</p>
                                    <p><strong>Patient Name:</strong> ${appointment.patient_name}</p>
                                    <p><strong>Patient ID:</strong> ${appointment.patient_id}</p>
                                    <p><strong>Admission Date:</strong> ${appointment.formatted_admission_date}</p>
                                    <p><strong>Receipt Date:</strong> ${new Date().toLocaleDateString('en-IN')}</p>
                                </div>

                                <h3>Payment Details</h3>
                                <table class="table">
                                    <tr>
                                        <th>Date</th>
                                        <th>Payment Method</th>
                                        <th>Amount</th>
                                    </tr>
                                    ${creditTransactions.map(t => `
                                        <tr>
                                            <td>${t.formatted_date}</td>
                                            <td>${t.payment_method || '-'}</td>
                                            <td class="amount">₹${parseFloat(t.amount).toFixed(2)}</td>
                                        </tr>
                                    `).join('')}
                                    <tr class="total-row">
                                        <td colspan="2" style="text-align: right">Total Amount Paid:</td>
                                        <td class="amount">₹${totalPaidAmount.toFixed(2)}</td>
                                    </tr>
                                </table>

                                <div class="footer">
                                    <p>Received By: ${creditTransactions[0]?.user_name || 'Staff'}</p>
                                </div>
                            </body>
                        </html>
                    `);
                    
                    printWindow.document.close();
                    printWindow.focus();

                    // Wait for content to load then print and close
                    printWindow.onload = function() {
                        printWindow.print();
                        // Close window after print dialog is closed
                        setTimeout(() => {
                            printWindow.close();
                        }, 250);
                    };
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error printing payment receipt');
                });
        }
        const money = (value) => parseFloat(value || 0).toFixed(2);
        const STATUS_BADGES = { Admitted: 'badge-info', Pending: 'badge-warning', Paid: 'badge-success' };

        var table;
        $(document).ready(() => {
            initBillTable();
            initBillFilters();
        });

        // Paging, sorting and filtering all happen on the server (/get-ipd-bill-list).
        function initBillTable() {
            table = new Tabulator('#bills-table', {
                layout: 'fitDataFill',
                ajaxURL: '/get-ipd-bill-list',
                ajaxParams: function () {
                    return {
                        search: document.getElementById('billSearch').value.trim(),
                        status: document.getElementById('statusFilter').value,
                        dateFrom: document.getElementById('dateFrom').value,
                        dateTo: document.getElementById('dateTo').value,
                    };
                },
                pagination: true,
                paginationMode: 'remote',
                paginationSize: 50,
                paginationSizeSelector: [25, 50, 100],
                paginationCounter: 'rows',
                sortMode: 'remote',
                filterMode: 'remote',
                headerFilterLiveFilterDelay: 400,
                placeholder: 'No IPD bills found',
                columns: [
                    { title: 'Bill No', field: 'bill_no', headerFilter: 'input', headerHozAlign: 'center' },
                    { title: 'Patient ID', field: 'patient_id', headerFilter: 'input', headerHozAlign: 'center' },
                    { title: 'Patient Name', field: 'patient_name', headerFilter: 'input', headerHozAlign: 'center' },
                    { title: 'Admission Date', field: 'admission_date', headerHozAlign: 'center' },
                    { title: 'Discharge Date', field: 'discharge_date', headerHozAlign: 'center' },
                    { title: 'Total Bill', field: 'total_bill_amount', hozAlign: 'right', headerHozAlign: 'center', formatter: (cell) => money(cell.getValue()) },
                    { title: 'Paid Amount', field: 'total_paid_amount', hozAlign: 'right', headerHozAlign: 'center', formatter: (cell) => money(cell.getValue()) },
                    { title: 'Balance', field: 'remaining_amount', hozAlign: 'right', headerHozAlign: 'center', formatter: (cell) => money(cell.getValue()) },
                    {
                        title: 'Status', field: 'bill_status', headerHozAlign: 'center',
                        formatter: (cell) => `<span class="badge ${STATUS_BADGES[cell.getValue()] || 'badge-secondary'}">${cell.getValue()}</span>`,
                    },
                    {
                        title: 'Action', field: 'actions', headerSort: false, headerHozAlign: 'center',
                        formatter: function (cell) {
                            const item = cell.getRow().getData();
                            return `<div class="btn-group gap-2">
                                <button class="btn btn-sm btn-primary" onclick="printBill('${item.appointment_id}')">
                                    <i class="fa fa-print"></i> Print Bill
                                </button>
                                <button class="btn btn-sm btn-info" onclick="printPaymentReceipt('${item.appointment_id}')">
                                    <i class="fa fa-print"></i> Print Receipt
                                </button>
                                <a href="/view-ipd-appointment/${item.appointment_id}?tab=billings" class="btn btn-sm btn-secondary">
                                    <i class="fa fa-edit"></i> Edit
                                </a>
                                <button class="btn btn-sm btn-success" onclick="showPaymentModal('${item.appointment_id}', ${item.remaining_amount})">
                                    <i class="fa fa-money"></i> Pay
                                </button>
                            </div>`;
                        },
                    },
                ],
            });
        }

        function initBillFilters() {
            const reload = () => table.setData();

            let searchTimer;
            document.getElementById('billSearch').addEventListener('input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(reload, 400);
            });
            ['statusFilter', 'dateFrom', 'dateTo'].forEach((id) =>
                document.getElementById(id).addEventListener('change', reload)
            );

            document.getElementById('clearBillFilters').addEventListener('click', function () {
                document.querySelectorAll('#bill-filters input, #bill-filters select')
                    .forEach((input) => { input.value = ''; });
                table.clearHeaderFilter();
                table.clearSort();
                reload();
            });
        }
    </script>
</body>
</html> 