<!doctype html>
<html lang="en">

<head>
    <title>AHMS :: Add Doctor</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Iconic Bootstrap 4.5.0 Admin Template">
    <meta name="author" content="WrapTheme, design by: ThemeMakker.com">

    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <!-- VENDOR CSS -->
    <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/dropify/css/dropify.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap-datepicker/css/bootstrap-datepicker3.min.css">

    <!-- MAIN CSS -->
    <link rel="stylesheet" href="../dist/assets/css/main.css">
</head>

<body data-theme="light" class="font-nunito">

    <div id="wrapper" class="theme-cyan">

        <%- include('navbar') %>


        <!--main page content body part-->
        <div id="main-content">
            <div class="container-fluid">
                <div class="block-header">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <h2>Add Doctor</h2>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/index"><i class="fa fa-dashboard"></i></a>
                                </li>
                                <li class="breadcrumb-item">Doctor</li>
                                <li class="breadcrumb-item active">Add new</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="row clearfix">
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="card">
                            <div class="header">
                                <h2>Add Doctor</h2>
                            </div>
                            <div class="body">
                                <form id="doctorForm" class="needs-validation" novalidate>
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <input type="hidden" id="userId" name="userId" value=26>
                                            <label for="Fname" class="form-label">First Name</label>
                                            <input type="text" class="form-control" id="Fname" name="Fname" required>
                                            <div class="invalid-feedback">Please enter the first name.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="Lname" class="form-label">Last Name</label>
                                            <input type="text" class="form-control" id="Lname" name="Lname" required>
                                            <div class="invalid-feedback">Please enter the last name.</div>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label for="birthdate" class="form-label">Date of Birth</label>
                                            <input type="date" class="form-control" id="birthdate" name="birthdate"
                                                required>
                                            <div class="invalid-feedback">Please select the birthdate.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="age" class="form-label">Age</label>
                                            <input type="text" class="form-control" id="age" name="age" readonly>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label for="gender" class="form-label">Gender</label>
                                            <select class="form-control" id="gender" name="gender" required>
                                                <option value="" disabled selected>Select Gender</option>
                                                <option value="male">Male</option>
                                                <option value="female">Female</option>
                                                <option value="other">Other</option>
                                            </select>
                                            <div class="invalid-feedback">Please select the gender.</div>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="speciality" class="form-label">Speciality</label>
                                            <input type="text" class="form-control" name="speciality" id="speciality"
                                                id="speciality" required>
                                            <div class="invalid-feedback">Please select the speciality.</div>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="phoneno" class="form-label">Phone No.</label>
                                            <input type="tel" pattern="[0-9]{10}" class="form-control"
                                                placeholder="Phone No." name="phoneno" id="phoneno" required>
                                            <div class="invalid-feedback">Please enter a 10 digit phone no.</div>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label for="email" class="form-label">Email</label>
                                            <input type="email" class="form-control" placeholder="Enter Your Email"
                                                name="email" id="email" required>
                                            <div class="invalid-feedback">Please enter the email address.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="weburl" class="form-label">Website URL</label>
                                            <input type="url" class="form-control" placeholder="Website URL"
                                                name="weburl" id="weburl">
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-md-12">
                                            <label for="imageUpload">Upload Image</label>
                                            <input type="file" class="form-control dropify" id="imageUpload"
                                                name="imageUpload" accept=".jpg, .jpeg, .png, .svg">
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-12">
                                            <button type="submit" class="btn btn-primary" id="submitBtn">Submit</button>
                                            <button type="reset" class="btn btn-outline-secondary">Cancel</button>
                                        </div>
                                    </div>
                                </form>
                                <div id="result" class="mt-3"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!--Doctor's Account Information-->
                <div class="row clearfix">
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="card">
                            <div class="header">
                                <h2>Add Doctor</h2>
                            </div>
                            <div class="body">
                                <form id="docAccForm" name="docAccForm"  class="needs-validation" novalidate>
                                    <div class="row mb-3">
                                        <div class="col-md-12">
                                            <label for="uname" class="form-label">Username</label>
                                            <input type="text" class="form-control" id="uname" name="uname"
                                                placeholder="Enter the Username" required>
                                            <div class="invalid-feedback">Please enter the username.</div>
                                        </div>
                                    </div>
                                    <div class="row clearfix">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="password" class="form-label">Password</label>
                                                <input type="password" class="form-control" id="password"
                                                    name="password" placeholder="Enter the Password" pattern=".{8,15}"
                                                    required>
                                                <div class="invalid-feedback">Password must be between 8 and 15
                                                    characters long!</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="confirmPassword" class="form-label">Confirm Password</label>
                                                <input type="password" class="form-control" id="confirmPassword"
                                                    placeholder="Confirm Password" required>
                                                <div class="invalid-feedback">
                                                    Please confirm your password.
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <button type="submit" class="btn btn-primary"
                                                id="submitAccBtn">Submit</button>
                                            <button type="reset" class="btn btn-outline-secondary">Cancel</button>
                                        </div>
                                        <div id="credResult"></div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>

    </div>

    <!-- Javascript -->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>

    <script src="../dist/assets/vendor/dropify/js/dropify.min.js"></script>
    <script src="../dist/assets/vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
    <!-- bootstrap datepicker Plugin Js -->

    <!-- page js file -->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../../js/pages/forms/dropify.js"></script>
    <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>

    <script>
document.addEventListener("DOMContentLoaded", () => {
            fetch('get-user-name')
            .then(response => response.json())
            .then(data => {
                document.getElementById("login-name").innerHTML = data.name
                if(data.gender == "female"){
                    document.getElementById("login-img").src = "../dist/assets/images/user-f.jpg"
                } else if (data.gender == "male"){
                document.getElementById("login-img").src = "../dist/assets/images/user-m.jpg"

                }
            })
        })

        let userId;

        document.addEventListener('DOMContentLoaded', function () {
            const urlParams = new URLSearchParams(window.location.search);
            userId = urlParams.get('userId');
    
            // Populate form fields with fetched data
            fetch(`/getUserDetails/${userId}`)
                .then(response => response.json())
                .then(data => {
                    document.getElementById('Fname').value = data.firstname;
                    document.getElementById('Lname').value = data.lastname;
    
                    const isoDate = new Date(data.dob);
                    // Convert the date to UTC by creating a new date object with the time set to UTC
                    const utcDate = new Date(Date.UTC(isoDate.getFullYear(), isoDate.getMonth(), isoDate.getDate()));
                    // Format the UTC date as 'YYYY-MM-DD'
                    const dob = utcDate.toISOString().split('T')[0];
                    document.getElementById('birthdate').value = dob;
    
                    document.getElementById('age').value = data.age;
                    document.getElementById('phoneno').value = data.mobile;
    
                    const genderSelect = document.getElementById('gender');
                    if (data.gender) {
                        for (let i = 0; i < genderSelect.options.length; i++) {
                            if (genderSelect.options[i].value === data.gender) {
                                genderSelect.options[i].selected = true;
                                break;
                            }
                        }
                    }
                    document.getElementById('uname').value=data.username;
                    document.getElementById('speciality').value = data.speciality;
                    document.getElementById('weburl').value = data.website;
                    document.getElementById('email').value = data.email;
    
                    
                })
                .catch(error => console.error('Error fetching user details:', error));
        });
    
        document.getElementById('doctorForm').addEventListener('submit', updateDoctorDetails);
    
        async function updateDoctorDetails(event) {
            event.preventDefault();
            const formData = new FormData(document.getElementById('doctorForm'));
    
            try {
                const response = await fetch(`/updateUserAndDoctor/${userId}`, {
                    method: 'POST',
                    body: formData,
                });
    
                const result = await response.json();
    
                if (response.ok) {
                    document.getElementById('result').innerText = 'Doctor Details updated successfully!';
                } else {
                    document.getElementById('result').innerText = `Error updating doctor Details: ${result.error}`;
                }
            } catch (error) {
                console.error('Error updating doctor details:', error);
                document.getElementById('result').innerText = 'Error updating doctor details';
            }
        }    
        
        document.getElementById('docAccForm').addEventListener('submit', function (event) {
            event.preventDefault();
            if (this.checkValidity() && passwordCheck()) {
                updateDoctorCredentials();
            } else {
                event.stopPropagation();
            }
            this.classList.add('was-validated');
        });

        async function updateDoctorCredentials(event) {
            
            const formData = new FormData(document.getElementById('docAccForm'));
        
            try {
                const response = await fetch(`/updateDoctorCred/${userId}`, {
                    method: 'POST',
                    body: formData,
                });
        
                const result = await response.json();
        
                if (response.ok) {
                    document.getElementById('credResult').innerText = 'Doctor Credantials updated successfully!';
                } else {
                    document.getElementById('credResult').innerText = `Error updating doctorCredantials: ${result.error}`;
                }
            } catch (error) {
                console.error('Error updating doctor Credantials:', error);
                document.getElementById('credResult').innerText = 'Error updating doctor Credantials';
            }
        }
          //Calculate age based on birthdate
            document.getElementById('birthdate').addEventListener('change', function () {
                const birthdate = new Date(this.value);
                const today = new Date();
                let age = today.getFullYear() - birthdate.getFullYear();
                const monthDifference = today.getMonth() - birthdate.getMonth();
                if (monthDifference < 0 || (monthDifference === 0 && today.getDate() < birthdate.getDate())) {
                    age--;
                }
                if (age < 0) age = 0;
                document.getElementById('age').value = age;
            });

            

            // Array of random images
            const randomImages = [
                '../dist/assets/images/sm/avatar1.jpg',
                '../dist/assets/images/sm/avatar2.jpg',
                '../dist/assets/images/sm/avatar3.jpg',
                '../dist/assets/images/sm/avatar4.jpg',
                '../dist/assets/images/sm/avatar5.jpg'
            ];

           
            const forms = document.getElementsByClassName('needs-validation');
            Array.prototype.filter.call(forms, function (form) {
                form.addEventListener('submit', function (event) {
                    if (form.checkValidity() === false) {
                        event.preventDefault();
                        event.stopPropagation();
                    } else {
                        event.preventDefault();
                        handleImageUpload();
                    }
                    form.classList.add('was-validated');
                }, false);
            });

            // Handle image upload or random image selection
            function handleImageUpload() {
                const imageUpload = document.getElementById('imageUpload');
                let selectedFile;

                // Check if file was uploaded
                if (imageUpload.files.length > 0) {
                    selectedFile = imageUpload.files[0];
                    // Validate the file type
                   /* const validImageTypes = ['image/jpeg', 'image/png', 'image/svg+xml'];
                    if (!validImageTypes.includes(selectedFile.type)) {
                        alert('Please upload a valid image file (JPG, PNG, SVG)');
                        return;
                    }*/
                } else {
                    // Select a random image if no file was uploaded
                    const randomImage = randomImages[Math.floor(Math.random() * randomImages.length)];
                    selectedFile = randomImage;
                }

                // Display the selected file (for demonstration purposes)
                document.getElementById('result').innerText = `Selected file: ${selectedFile.name || selectedFile}`;
            }
       
        //Passwords match validation
        function passwordCheck() {
            const password = document.getElementById('password');
            const confirmPassword = document.getElementById('confirmPassword');
            if (password.value !== confirmPassword.value) {
                confirmPassword.setCustomValidity('Passwords do not match');
                confirmPassword.classList.add('is-invalid');
                confirmPassword.classList.remove('is-valid');
                return false;
            } else {
                confirmPassword.setCustomValidity('');
                confirmPassword.classList.remove('is-invalid');
                confirmPassword.classList.add('is-valid');
                return true;
            }
        }

        //Form input changes for confirm password
        document.getElementById('confirmPassword').addEventListener('input', passwordCheck);
        document.getElementById('password').addEventListener('input', passwordCheck);

    </script>
</body>

</html>