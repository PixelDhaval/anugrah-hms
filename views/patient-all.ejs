<!DOCTYPE html>
<html lang="en">
    <head>
        <title>AHMS :: All Patients</title>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, shrink-to-fit=no"
        />
        <meta
            name="description"
            content="Iconic Bootstrap 4.5.0 Admin Template"
        />
        <meta name="author" content="WrapTheme, design by: ThemeMakker.com" />
        <link rel="icon" href="favicon.ico" type="image/x-icon" />

        <!-- VENDOR CSS -->
        <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css" />
        <link
            rel="stylesheet"
            href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css"
        />
        <link
            rel="stylesheet"
            href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css"
        />

        <!-- MAIN Project CSS file -->
        <link rel="stylesheet" href="../dist/assets/css/main.css" />
        <link
            rel="stylesheet"
            href="../dist/assets/css/tabulator_bootstrap5.css"
        />

        <style>
            .tabulator {
                font-size: 12px;
                text-align: center;
            }
        </style>
    </head>

    <body data-theme="light" class="font-nunito">
        <div id="wrapper" class="theme-cyan">
            <%- include('navbar') %>

            <!--main page content body part-->
            <div id="main-content">
                <div class="container-fluid">
                    <div class="block-header">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-12">
                                <h2>All Patient</h2>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="/index"
                                            ><i class="fa fa-dashboard"></i
                                        ></a>
                                    </li>
                                    <li class="breadcrumb-item">Patient</li>
                                    <li class="breadcrumb-item active">
                                        All Patient
                                    </li>
                                </ul>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-12">
                                <div class="d-flex flex-row-reverse">
                                    <div class="p-2 d-flex"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row clearfix">
                        <div class="col-lg-12 col-md-12 col-sm-12">
                            <div class="card mt-4">
                                <div class="header">
                                    <h2>All Patients</h2>
                                </div>
                                <div class="body">
                                    <div class="row g-2 align-items-end mb-3" id="patient-filters">
                                        <div class="col-md-4">
                                            <label for="patientSearch" class="form-label small mb-1">Search</label>
                                            <input type="search" class="form-control form-control-sm" id="patientSearch"
                                                placeholder="ID, name, phone or address" autocomplete="off">
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <label for="statusFilter" class="form-label small mb-1">Status</label>
                                            <select class="form-control form-control-sm" id="statusFilter">
                                                <option value="">All</option>
                                                <option value="scheduled">Scheduled</option>
                                                <option value="billing">Billing</option>
                                                <option value="completed">Completed</option>
                                            </select>
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <label for="visitedFrom" class="form-label small mb-1">Last visit from</label>
                                            <input type="date" class="form-control form-control-sm" id="visitedFrom">
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <label for="visitedTo" class="form-label small mb-1">Last visit to</label>
                                            <input type="date" class="form-control form-control-sm" id="visitedTo">
                                        </div>
                                        <div class="col-6 col-md-auto">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="clearPatientFilters">
                                                <i class="fa fa-times"></i> Clear filters
                                            </button>
                                        </div>
                                    </div>
                                    <div id="patient-table"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!--Edit Modal-->
            <div
                class="modal fade"
                id="editPatientModal"
                tabindex="-1"
                aria-labelledby="editPatientModalLabel"
                aria-hidden="true"
            >
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="editPatientModalLabel">
                                Edit Patient Details
                            </h5>
                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"
                            ></button>
                        </div>
                        <div class="modal-body">
                            <form id="editPatientForm" novalidate>
                                <div class="mb-3">
                                    <label for="editName" class="form-label"
                                        >Name</label
                                    >
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="editName"
                                        required
                                    />
                                    <div class="invalid-feedback">
                                        Please provide a name.
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="editAge" class="form-label"
                                        >Age</label
                                    >
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="editAge"
                                        required
                                    />
                                    <div class="invalid-feedback">
                                        Please provide an age.
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="editWeight" class="form-label"
                                        >Weight</label
                                    >
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="editWeight"
                                        required
                                    />
                                    <div class="invalid-feedback">
                                        Please provide an Weight.
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label
                                        for="editGender"
                                        class="form-label"
                                        >Gender</label
                                    >
                                    <select
                                        class="form-control"
                                        id="editGender"
                                        name="editGender"
                                        required
                                    >
                                        <option
                                            value=""
                                            disabled
                                            selected
                                        >
                                            Select Gender
                                        </option>
                                        <option value="Male">
                                            Male
                                        </option>
                                        <option value="Female">
                                            Female
                                        </option>
                                        <option value="Other">
                                            Other
                                        </option>
                                    </select>
                                    <div class="invalid-feedback">
                                        Please select the gender.
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="editAddress" class="form-label"
                                        >Address</label
                                    >
                                    <textarea
                                        class="form-control"
                                        id="editAddress"
                                        name="address"
                                        rows="4"
                                        required
                                    ></textarea>
                                    <div class="invalid-feedback">
                                        Please provide an address.
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="editPhoneNo" class="form-label"
                                        >Phone No.</label
                                    >
                                    <input
                                        type="tel"
                                        pattern="[0-9]{10}"
                                        class="form-control"
                                        id="editPhoneNo"
                                        required
                                    />
                                    <div class="invalid-feedback">
                                        Please provide a number.
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label
                                        for="editLastVisit"
                                        class="form-label"
                                        >Last Visit</label
                                    >
                                    <input
                                        type="date"
                                        class="form-control"
                                        id="editLastVisit"
                                    />
                                    <div class="invalid-feedback">
                                        Please last visit date.
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label
                                        for="editDoctorAssigned"
                                        class="form-label"
                                        >Assign Doctor</label
                                    >
                                    <select
                                        class="form-control"
                                        id="editDoctorAssigned"
                                        name="edit_doctor_assigned"
                                        required
                                    >
                                        <option value="" disabled selected>
                                            Assign Doctor
                                        </option>
                                        <% doctors.forEach(doctor => { %>
                                        <option value="<%= doctor %>">
                                            <%= doctor %>
                                        </option>
                                        <% }); %>
                                    </select>
                                    <div class="invalid-feedback">
                                        Please assign the doctor.
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button
                                type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal"
                            >
                                Close
                            </button>
                            <button
                                type="button"
                                class="btn btn-primary"
                                id="saveChangesBtn"
                            >
                                Save changes
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Javascript -->
        <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
        <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>
        <!-- page vendor js file -->
        <script src="../dist/assets/bundles/apexcharts.bundle.js"></script>
        <!-- page js file -->
        <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
        <script src="../../js/hospital/index.js"></script>
        <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>
        <script src="../dist/assets/js/tabulator.min.js"></script>
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                fetch("get-user-name")
                    .then((response) => response.json())
                    .then((data) => {
                        document.getElementById("login-name").innerHTML =
                            data.name;
                        if (data.gender == "female") {
                            document.getElementById("login-img").src =
                                "../dist/assets/images/user-f.jpg";
                        } else if (data.gender == "male") {
                            document.getElementById("login-img").src =
                                "../dist/assets/images/user-m.jpg";
                        }
                    });
            });
            var table;
            document.addEventListener("DOMContentLoaded", function () {
                initPatientTable();
                initPatientFilters();
            });

            // Paging, sorting and filtering all happen on the server (/fetch-patients).
            function initPatientTable() {
                const doctorNames = Array.from(
                    document.querySelectorAll("#editDoctorAssigned option")
                )
                    .map((option) => option.value.trim())
                    .filter(Boolean);

                table = new Tabulator("#patient-table", {
                    layout: "fitDataFill",
                    ajaxURL: "/fetch-patients",
                    ajaxParams: function () {
                        return {
                            search: document.getElementById("patientSearch").value.trim(),
                            status: document.getElementById("statusFilter").value,
                            visitedFrom: document.getElementById("visitedFrom").value,
                            visitedTo: document.getElementById("visitedTo").value,
                        };
                    },
                    pagination: true,
                    paginationMode: "remote",
                    paginationSize: 50,
                    paginationSizeSelector: [25, 50, 100],
                    paginationCounter: "rows",
                    sortMode: "remote",
                    filterMode: "remote",
                    placeholder: "No patients found",
                    columns: [
                        {
                            title: "ID",
                            field: "patient_id",
                            headerHozAlign: "center",
                        },
                        {
                            title: "Name",
                            field: "name",
                            headerHozAlign: "center",
                        },

                        {
                            title: "Number",
                            field: "phone",
                            headerHozAlign: "center",
                        },
                        {
                            title: "Last Visit",
                            field: "last_visited",
                            headerHozAlign: "center",
                        },
                        {
                            title: "Doctor Assigned",
                            field: "doctor_assigned",
                            headerHozAlign: "center",
                        },
                        {
                            title: "Doctor ID",
                            field: "doctor_id",
                            visible: false,
                        },
                        {
                            title: "Actions",
                            field: "actions",
                            headerSort: false,
                            headerHozAlign: "center",
                            formatter: function (
                                cell,
                                formatterParams,
                                onRendered
                            ) {
                                const data = cell.getRow().getData();
                                let buttons = `
                                <button class="btn btn-sm btn-primary edit-btn"><i class="fa fa-pencil"></i> Edit</button>
                                
                            `;

                                if (
                                    data.appointment_status ===
                                    "completed"
                                ) {
                                    buttons += `
                                <button class="btn btn-sm btn-primary new-appointment-btn" data-patientid="${data.patient_id}" data-doctorid="${data.doctor_id}" data-w="${data.weight}"><i class="fa fa-calendar-plus"></i> New Appointment</button>
                                `;
                                } else if (
                                    data.appointment_status ==
                                    "scheduled"
                                ) {
                                    buttons += ` <button class="btn btn-sm btn-secondary" disabled><i class="fa fa-calendar-plus"></i>Scheduled</button>`;
                                    buttons += ` <button class="btn btn-sm btn-danger" onclick="cancelAppointment('${data.patient_id}')"><i class="fa fa-calendar-plus"></i>Cancel</button>`;
                                } else if (
                                    data.appointment_status == "billing"
                                ) {
                                    buttons +=
                                        `<a class="btn btn-sm btn-info billing-btn" href="billing/` +
                                        data.patient_id +
                                        `"><i class="fa fa-dollar-sign"></i> Billing</a>`;
                                    buttons += ` <button class="btn btn-sm btn-danger" onclick="cancelAppointment('${data.patient_id}')"><i class="fa fa-calendar-plus"></i>Cancel</button>`;
                                }

                                return buttons;
                            },
                            cellClick: function (e, cell) {
                                const actionButton =
                                    e.target.closest("button");

                                if (actionButton) {
                                    const data = cell
                                        .getRow()
                                        .getData();
                                    if (
                                        actionButton.classList.contains(
                                            "new-appointment-btn"
                                        )
                                    ) {
                                        const patientId =
                                            actionButton.getAttribute(
                                                "data-patientid"
                                            );
                                        const doctorId =
                                            actionButton.getAttribute(
                                                "data-doctorid"
                                            );
                                            const weight =
                                            actionButton.getAttribute(
                                                "data-w"
                                            );
                                        if (patientId && doctorId) {
                                            window.location.href = `/patient-complaints?patientId=${patientId}&doctorId=${doctorId}&w=${weight}`;
                                        } else {
                                            console.error(
                                                "Patient ID or Doctor ID not found."
                                            );
                                        }
                                    } else if (
                                        actionButton.classList.contains(
                                            "edit-btn"
                                        )
                                    ) {
                                        // Populate the edit modal fields
                                        document.getElementById(
                                            "editName"
                                        ).value = data.name;
                                        document.getElementById(
                                            "editAge"
                                        ).value = data.age;
                                        document.getElementById(
                                            "editAddress"
                                        ).value = data.address;
                                        document.getElementById(
                                            "editPhoneNo"
                                        ).value = data.phone;
                                        document.getElementById(
                                            "editWeight"
                                        ).value = data.weight;
                                        document.getElementById(
                                            "editGender"
                                        ).value = data.gender;
                                        if (data.last_visited) {
                                            const dateParts =
                                                data.last_visited
                                                    .split("T")[0]
                                                    .split("-");
                                            const formattedDate = `${dateParts[0]}-${dateParts[1]}-${dateParts[2]}`;
                                            document.getElementById(
                                                "editLastVisit"
                                            ).value = formattedDate;
                                        } else {
                                            document.getElementById(
                                                "editLastVisit"
                                            ).value = "";
                                        }

                                        document.getElementById(
                                            "editDoctorAssigned"
                                        ).value = data.doctor_assigned;

                                        document.getElementById(
                                            "editPatientForm"
                                        ).dataset.rowId =
                                            data.patient_id;

                                        const editModal =
                                            new bootstrap.Modal(
                                                document.getElementById(
                                                    "editPatientModal"
                                                )
                                            );
                                        editModal.show();
                                    } else if (
                                        actionButton.classList.contains(
                                            "billing-btn"
                                        )
                                    ) {
                                        window.location.href = `/`; //link of billing page
                                    }
                                }
                            },
                        },
                    ],
                });
            }

            function initPatientFilters() {
                const reload = () => table.setData();

                let searchTimer;
                document.getElementById("patientSearch").addEventListener("input", function () {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(reload, 400);
                });
                ["statusFilter", "visitedFrom", "visitedTo"].forEach((id) =>
                    document.getElementById(id).addEventListener("change", reload)
                );

                document.getElementById("clearPatientFilters").addEventListener("click", function () {
                    document.getElementById("patientSearch").value = "";
                    document.getElementById("statusFilter").value = "";
                    document.getElementById("visitedFrom").value = "";
                    document.getElementById("visitedTo").value = "";
                    table.clearHeaderFilter();
                    table.clearSort();
                    reload();
                });
            }

            function cancelAppointment(patient__id) {
                fetch("/cancel-appointment", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({
                        patient_id: patient__id,
                    }),
                })
                    .then((response) => {
                        window.location.reload();
                    })
                    .catch((error) => {
                        console.error("Error:", error);
                    });
            }

            document
                .getElementById("saveChangesBtn")
                .addEventListener("click", editPatient);
            function editPatient() {
                const editPatientForm =
                    document.getElementById("editPatientForm");
                if (editPatientForm.checkValidity() === false) {
                    editPatientForm.classList.add("was-validated");
                } else {
                    const rowId = editPatientForm.dataset.rowId;

                    const updatedData = {
                        patient_id: rowId,
                        name: document.getElementById("editName").value,
                        age: document.getElementById("editAge").value,
                        address: document.getElementById("editAddress").value,
                        phone: document.getElementById("editPhoneNo").value,
                        last_visit:
                            document.getElementById("editLastVisit").value,
                        doctor_assigned:
                            document.getElementById("editDoctorAssigned").value,
                        weight: document.getElementById("editWeight").value,
                        gender: document.getElementById("editGender").value
                    };

                    fetch(`/edit-patient/${rowId}`, {
                        method: "PUT",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(updatedData),
                    })
                        .then((response) => response.json())
                        .then((data) => {
                            if (data.success) {
                                table.replaceData();
                                const editModal = bootstrap.Modal.getInstance(
                                    document.getElementById("editPatientModal")
                                );
                                editModal.hide();
                            } else {
                                console.error(
                                    "Failed to update patient:",
                                    data.error
                                );
                            }
                        })
                        .catch((error) => {
                            console.error("Error updating patient:", error);
                        });
                }
            }
        </script>
    </body>
</html>
