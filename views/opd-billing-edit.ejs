                `);
                printWindow.document.close();
                printWindow.focus();
                printWindow.print();
                printWindow.close();
            }
            //Print bill
            document
                .getElementById("printBillBtn")
                .addEventListener("click", function () {

                    // html2pdf().from(document.getElementById("content")).save('sample.pdf')

                    const form = document.getElementById("patientForm");

                    const patientId =
                        document.getElementById("patientId").value;
                    var particulars = table.getSelectedData();
                    var discountPercent =
                        document.getElementById("discountPercent").value;
                    var discountAmount =
                        document.getElementById("discountAmount").value;
                    const paymentMethod = document.querySelectorAll(
                        'input[name="paymentMode"]'
                    );
                    const billId = document.getElementById("opdNo").value;

                    var total = document.getElementById("netAmount").value;

                    let selectedValue = null;

                    paymentMethod.forEach((radio) => {
                        if (radio.checked) {
                            selectedValue = radio.value;
                        }
                    });
                    var data = {
                        patientId: patientId,
                        particulars: particulars,
                        discountPercent: discountPercent,
                        discountAmount: discountAmount,
                        paymentMethod: selectedValue,
                        type: "opd",
                        total: total,
                        billId: billId,
                    };

                    fetch(`/edit-bill`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(data),
                    })
                        .then((response) => response.json())
                        .then((data) => {
                            if (data.success == false) {
                                alert("Error: ", data.err);
                            } else {
                                window.location.href = "opd-billing-list";
                            }
                        });
                });
        </script>
    </body>
</html>
