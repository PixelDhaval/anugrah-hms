                justify-content: space-between;
                padding: 0.5em 1em;
                border-inline: 1px solid black;
                font-size: 18px;
            }
            .billing {
                border: 1px solid black;
            }
            .title {
                border-inline: 1px solid black;
                text-align: center;
                font-size: 25px;
