        <script>
            document.addEventListener("DOMContentLoaded", () => {
    // Fetch user name and set image
    fetch("get-user-name")
        .then((response) => response.json())
        .then((data) => {
            document.getElementById("login-name").innerHTML = data.name;
            document.getElementById("login-img").src = data.gender === "female"
                ? "../dist/assets/images/user-f.jpg"
                : "../dist/assets/images/user-m.jpg";
        });

    // Fetch OPD master data and set up the table
    fetch("/get-opd-master")
        .then((response) => response.json())
        .then((data) => {
            serviceData = data.data.map((e) => ({
                ...e,
                qty: 1,
                rate: e.new_patient,
            }));
            console.log(serviceData);
            table.setData(serviceData);
        });

    // Fetch OPD particular data based on opdNo and update table
    setTimeout(() => {
        fetch(`/get-opd-particular/${$("#opdNo").val()}`)
            .then((response) => response.json())
            .then((data) => {
                
                
                // Clear existing selections first
                table.deselectRow();
                
                data.data.forEach((d) => {
                    const rows = table.getRows().filter((row) => row.getData().code === d.code);
                    if (rows.length > 0) {
                        rows.forEach((row) => {
                            row.select();
                            row.update({rate: d.rate});
                        });
                    } else {
                        console.warn(`No matching row found for code: ${d.code}`);
                    }
                });
                calculateAmounts();
            })
            .catch((error) => {
                console.error("Error loading particulars:", error);
            });
    }, 500); // Wait for 500ms to ensure table is loaded
});

var serviceData = []

            let currentRateType = "rateForNewPatient";

            //Current date
            document.getElementById("date").value =
                new Date().toLocaleDateString();

            //Unique OPD number

            //Fetch patient details when patient ID entered
            document
                .getElementById("patientId")
                .addEventListener("input", function () {
                    const patientId = this.value;
                    if (patientData[patientId]) {
                        document.getElementById("firstName").value =
                            patientData[patientId].firstName;
                        document.getElementById("lastName").value =
                            patientData[patientId].lastName;
                        document.getElementById("address").value =
                            patientData[patientId].address;
                    } else {
                        document.getElementById("firstName").value = "";
                        document.getElementById("lastName").value = "";
                        document.getElementById("address").value = "";
                    }
                });

            //Update rate
            const table = new Tabulator("#service-table", {
                data: serviceData,
                layout: "fitColumns",
                columns: [
                    {
                        title: "Sr No.",
                        field: "code",
                        headerHozAlign: "center",
                    },
                    {
                        title: "Service",
                        field: "opd_service",
                        headerHozAlign: "center",
                    },

                    {
                        title: "Rate",
                        field: "rate",
                        editor: true,
                        headerHozAlign: "center",
                        cellEdited: function (cell) {
                            calculateAmounts();
                        },
                        bottomCalc: "sum",
                    },

                    {
                        title: "Choose",
                        formatter: "rowSelection",
                        titleFormatter: "rowSelection",
                        hozAlign: "center",
                        headerHozAlign: "center",
                        cellClick: function (e, cell) {
                            cell.getRow().toggleSelect();
                        },
                    },
                ],

                selectable: true,
            });

            document.getElementById("newBtn").addEventListener("change", () => {
                table.setData(table.getData());
            });
            document.getElementById("oldBtn").addEventListener("change", () => {
                table.setData(table.getData());
            });

            //Calculate total, discount, and net amount
            function calculateAmounts() {
                const selectedRows = table.getSelectedData();
                console.log(selectedRows);
                const total = selectedRows.reduce(
                    (sum, row) => sum + parseInt(row.rate),
                    0
                );
                console.log(total);
                const discountPercent =
                    parseFloat(
                        document.getElementById("discountPercent").value
                    ) || 0;
                const discountAmount =
                    parseFloat(
                        document.getElementById("discountAmount").value
                    ) || 0;

                if (total === 0) {
                    document.getElementById("total").value = 0;
                    document.getElementById("netAmount").value = 0;
                    document.getElementById("discountPercent").value = 0;
                    document.getElementById("discountAmount").value = 0;

                    return;
                }

                if (discountPercent > 0) {
                    document.getElementById("discountAmount").value = 0;
                    const discount = (total * discountPercent) / 100;
                    const netAmount = total - discount;
                    document.getElementById("total").value = total;
                    document.getElementById("netAmount").value =
                        netAmount >= 0 ? netAmount : 0;
                } else if (discountAmount > 0) {
                    document.getElementById("discountPercent").value = 0;
                    const netAmount = total - discountAmount;
                    document.getElementById("total").value = total;
                    document.getElementById("netAmount").value =
                        netAmount >= 0 ? netAmount : 0;
                } else {
                    document.getElementById("total").value = total;
                    document.getElementById("netAmount").value = total;
                }
            }


            document
                .getElementById("discountPercent")
                .addEventListener("input", calculateAmounts);
            document
                .getElementById("discountAmount")
                .addEventListener("input", calculateAmounts);
            table.on("rowSelectionChanged", calculateAmounts);

            function printDiv(divId) {
                const divContent = document.getElementById(divId).innerHTML;
                const printWindow = window.open("", "", "height=600,width=800");
                printWindow.document.write(`
                    <!DOCTYPE html>
