    }
    
</style>
<body>
    <div class="container">
        <div class="header">
            <H1 class="h2">ANUGRAH HOSPITAL</H1>
            <h4>Plot no. 39/40 - 7D, Gandhidham (Kutch) 370 201</h4>
        </div>
        <div class="detail">
            <div>No. <span id="bill-no"></span></div>
            <div>Date: <span id="bill-date"></span></div>
        </div>
        <div class="detail">
            <div> Patient Name: <span id="patient-name"></span></div>
        </div>
        <div class="title">
            <b>BILL</b>
        </div>
        <div class="billing">
            <div class="row-title">
                <div class="w-70"> Particilar</div>
                <div class="w-10">QTY</div>
                <div class="w-10">Rate</div>
                <div class="w-10">Total</div>
            </div>
            <div class="row">
                <div id="particular" class="part-w-70"></div>
                <div id="qty" class="part-w-10"></div>
