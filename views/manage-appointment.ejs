    <script>
        document.addEventListener('DOMContentLoaded', () => {
            getPatientRecords();
        });
    
        document.getElementById('saveAppointmentChangesBtn').addEventListener('click', function () {
            var editAppointmentForm = document.getElementById('editAppointmentForm');
    
            if (editAppointmentForm.checkValidity() === false) {
                editAppointmentForm.classList.add('was-validated');
            } else {
                var updatedData = {
                    appointmentId: document.getElementById('editAppointmentId').value,
                    patientId: document.getElementById('editPatientId').value,
                    name: document.getElementById('editPatientName').value,
                    age: document.getElementById('editPatientAge').value,
                    address: document.getElementById('editPatientAddress').value,
                    number: document.getElementById('editPatientNumber').value,
                    lastVisit: document.getElementById('editLastVisit').value,
                    status: document.getElementById('editStatus').value
                };
    
                fetch('/update-appointment', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(updatedData),
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        var editAppointmentModal = bootstrap.Modal.getInstance(document.getElementById('editAppointmentModal'));
                        editAppointmentModal.hide();
                        getPatientRecords();
                    } else {
                        console.error('Error updating appointment and patient details:', data.error);
                    }
                })
                .catch(error => {
                    console.error('Error updating appointment and patient details:', error);
                });
            }
        });
    
        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            const appointmentId = this.dataset.rowId;
            
            fetch(`/delete-appointment/${appointmentId}`, {
                method: 'DELETE',
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Appointment deleted successfully.');
                    getPatientRecords();
                } else {
                    console.error('Error deleting appointment:', data.error);
                }
            })
            .catch(error => {
                console.error('Error deleting appointment:', error);
            });
    
            var deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteRecordModal'));
            deleteModal.hide();
        });
    
        function getPatientRecords() {
            fetch('/get-patient-records')
                .then(response => response.json())
                .then(data => {
                    const table = new Tabulator("#appointments-table", {
                        data: data,
                        layout: "fitDataFill",
                        columns: [
                            { title: "Appointment ID", field: "appointment_id", visible: false },
                            { title: "Patient ID", field: "patient_id", headerFilter: "input", headerHozAlign: "center" },
                            { title: "Name", field: "name", headerFilter: "input", headerHozAlign: "center" },
                            { title: "Age", field: "age", headerFilter: "input", headerHozAlign: "center" },
                            { title: "Address", field: "address", headerFilter: "input", headerHozAlign: "center" },
                            { title: "Number", field: "number", headerFilter: "input", headerHozAlign: "center" },
                            { title: "Last Visit", field: "last_visited", headerFilter: "input", headerHozAlign: "center" },
                            {
                                title: "Status", field: "status", headerFilter: "input", headerHozAlign: "center", formatter: function (cell, formatterParams, onRendered) {
                                    const value = cell.getValue();
                                    let badgeClass = "";
                                    switch (value) {
                                        case "Scheduled":
                                            badgeClass = "badge-primary";
                                            break;
                                        case "Re-schedule":
                                            badgeClass = "badge-warning";
                                            break;
                                        case "Completed":
                                            badgeClass = "badge-success";
                                            break;
                                        case "Cancelled":
                                            badgeClass = "badge-danger";
                                            break;
                                        default:
                                            badgeClass = "badge-secondary";
                                    }
                                    return `<span class="badge ${badgeClass}">${value}</span>`;
                                }
                            },
                            {
                                title: "Actions", field: "actions", headerHozAlign: "center", formatter: function (cell, formatterParams, onRendered) {
                                    const data = cell.getRow().getData();
                                    let buttons = `
                                        <button class="btn btn-sm btn-primary edit-btn"><i class="fa fa-pencil"></i> Edit</button>
                                        <button class="btn btn-sm btn-danger delete-btn"><i class="fa fa-trash"></i> Delete</button>`;
                                    if (data.status !== "Cancelled" && data.status !== "Completed") {
                                        buttons += `
                                        <button class="btn btn-sm btn-success prescribe-btn"><i class="fa fa-file-medical"></i> Prescribe</button>`;
                                    }
                                    return buttons;
                                },
                                cellClick: function (e, cell) {
                                    var data = cell.getRow().getData();
                                    if (e.target.classList.contains('edit-btn')) {
                                        document.getElementById('editAppointmentId').value = data.appointment_id;
                                        document.getElementById('editPatientId').value = data.patient_id;
                                        document.getElementById('editPatientName').value = data.name;
                                        document.getElementById('editPatientAge').value = data.age;
                                        document.getElementById('editPatientAddress').value = data.address;
                                        document.getElementById('editPatientNumber').value = data.number;
                                        if (data.last_visited) {
                                            const dateParts = data.last_visited.split('T')[0].split('-');
                                            const formattedDate = `${dateParts[0]}-${dateParts[1]}-${dateParts[2]}`;
                                            document.getElementById('editLastVisit').value = formattedDate;
                                        } else {
                                            document.getElementById('editLastVisit').value = '';
                                        }
                                        const statusSelect = document.getElementById('editStatus');
                                        const options = Array.from(statusSelect.options).map(option => option.value);
                                        if (options.includes(data.status)) {
                                            statusSelect.value = data.status;
                                        } else {
                                            console.error('Status value not found in options:', data.status);
                                        }
                                        var editAppointmentModal = new bootstrap.Modal(document.getElementById('editAppointmentModal'));
                                        editAppointmentModal.show();
                                    } else if (e.target.classList.contains('delete-btn')) {
                                        document.getElementById('confirmDeleteBtn').dataset.rowId = data.appointment_id;
                                        var deleteModal = new bootstrap.Modal(document.getElementById('deleteRecordModal'));
                                        deleteModal.show();
                                    } else if (e.target.classList.contains('prescribe-btn')) {
                                       const appointmentId=document.getElementById('editAppointmentId').value = data.appointment_id;
                                       const patientId=document.getElementById('editPatientId').value = data.patient_id;
                                       window.location.href=`/create-prescription?appointmentId=${appointmentId}&patientId=${patientId}`
                                    }
                                }
                            }
                        ]
                    });
                })
                .catch(error => {
                    console.error('Error fetching appointment data:', error);
                });
        }
    </script>
    </body>

</html>