<!doctype html>
<html lang="en">

<head>
    <title>AHMS :: Appointments</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Iconic Bootstrap 4.5.0 Admin Template">
    <meta name="author" content="WrapTheme, design by: ThemeMakker.com">
    <link rel="icon" href="favicon.ico" type="image/x-icon">

    <!-- VENDOR CSS -->
    <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css">

    <!-- MAIN Project CSS file -->
    <link rel="stylesheet" href="../dist/assets/css/main.css">
    <link rel="stylesheet" href="../dist/assets/css/tabulator_bootstrap5.css">
    <style>
        .tabulator {
            font-size: 12px;
            text-align: center;
        }
    </style>
</head>

<body data-theme="light" class="font-nunito">
    <div id="wrapper" class="theme-cyan">

        <%- include('navbar') %>


        <!--main page content body part-->
        <div id="main-content">
            <div class="container-fluid">
                <div class="block-header">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <h2>All Patient</h2>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a href="index.html"><i class="fa fa-dashboard"></i></a>
                                </li>
                                <li class="breadcrumb-item">Patient</li>
                                <li class="breadcrumb-item active">All Patient</li>
                            </ul>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <div class="d-flex flex-row-reverse">
                                <div class="p-2 d-flex">
                                    <a href="all-appointment" class="btn btn-primary">All Appointments</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row clearfix">
                    <div class="col-md-12">
                        <div class="card patients-list">
                            <div class="header">
                                <h2>Appointments</h2>
                            </div>
                            <div class="body">
                                <div id="appointments-table"></div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <!-- Edit Appointment Modal -->
        <div class="modal fade" id="editAppointmentModal" tabindex="-1" aria-labelledby="editAppointmentModalLabel"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editAppointmentModalLabel">Edit Appointment</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="editAppointmentForm" class="needs-validation" novalidate>
                            <div class="mb-3">
                                <label for="editAppointmentId" class="form-label">Appointment ID</label>
                                <input type="text" class="form-control" id="editAppointmentId" readonly>
                            </div>
                            <div class="mb-3">
                                <input type="hidden" class="form-control" id="editPatientId">
                            </div>
                            <div class="mb-3">
                                <label for="editPatientName" class="form-label">Patient Name</label>
                                <input type="text" class="form-control" id="editPatientName" required>
                                <div class="invalid-feedback">Please provide a patient name.</div>
                            </div>
                            <div class="mb-3">
                                <label for="editPatientAge" class="form-label">Age</label>
                                <input type="text" class="form-control" id="editPatientAge" required>
                                <div class="invalid-feedback">Please provide an age.</div>
                            </div>
                            <div class="mb-3">
                                <label for="editPatientAddress" class="form-label">Address</label>
                                <input type="text" class="form-control" id="editPatientAddress" required>
                                <div class="invalid-feedback">Please provide an address.</div>
                            </div>
                            <div class="mb-3">
                                <label for="editPatientNumber" class="form-label">Contact Number</label>
                                <input type="text" class="form-control" id="editPatientNumber" required>
                                <div class="invalid-feedback">Please provide a contact number.</div>
                            </div>
                            <div class="mb-3">
                                <label for="editLastVisit" class="form-label">Last Visit</label>
                                <input type="date" class="form-control" id="editLastVisit" required>
                                <div class="invalid-feedback">Please provide the last visit date.</div>
                            </div>
                            <div class="mb-3">
                                <label for="editStatus" class="form-label">Status</label>
                                <select class="form-control" id="editStatus" required>
                                    <option value="Scheduled">Scheduled</option>
                                    <option value="Re-schedule">Re-schedule</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Cancelled">Cancel</option>
                                </select>
                                <div class="invalid-feedback">Please select a status.</div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="saveAppointmentChangesBtn">Save
                            changes</button>
                    </div>
                </div>
            </div>
        </div>

        <!--Delete Appointment Modal-->
        <div class="modal fade" id="deleteRecordModal" tabindex="-1" aria-labelledby="deleteRecordModalLabel"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteRecordModalLabel">Delete Patient Record</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete this patient's record?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <!-- Javascript -->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>

    <!-- page vendor js file -->
    <script src="../dist/assets/bundles/apexcharts.bundle.js"></script>

    <!-- page js file -->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../../js/hospital/index.js"></script>
    <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>
    <script src="../dist/assets/js/tabulator.min.js"></script>
    <script>
document.addEventListener("DOMContentLoaded", () => {
            fetch('get-user-name')
            .then(response => response.json())
            .then(data => {
                document.getElementById("login-name").innerHTML = data.name
                if(data.gender == "female"){
                    document.getElementById("login-img").src = "../dist/assets/images/user-f.jpg"
                } else if (data.gender == "male"){
                document.getElementById("login-img").src = "../dist/assets/images/user-m.jpg"

                }
            })
        })
        document.addEventListener('DOMContentLoaded', () => {
            getPatientRecords();
        });
    
        document.getElementById('saveAppointmentChangesBtn').addEventListener('click', function () {
            var editAppointmentForm = document.getElementById('editAppointmentForm');
    
            if (editAppointmentForm.checkValidity() === false) {
                editAppointmentForm.classList.add('was-validated');
            } else {
                var updatedData = {
                    appointmentId: document.getElementById('editAppointmentId').value,
                    patientId: document.getElementById('editPatientId').value,
                    name: document.getElementById('editPatientName').value,
                    age: document.getElementById('editPatientAge').value,
                    address: document.getElementById('editPatientAddress').value,
                    number: document.getElementById('editPatientNumber').value,
                    lastVisit: document.getElementById('editLastVisit').value,
                    status: document.getElementById('editStatus').value
                };
    
                fetch('/update-appointment', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(updatedData),
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        var editAppointmentModal = bootstrap.Modal.getInstance(document.getElementById('editAppointmentModal'));
                        editAppointmentModal.hide();
                        getPatientRecords();
                    } else {
                        console.error('Error updating appointment and patient details:', data.error);
                    }
                })
                .catch(error => {
                    console.error('Error updating appointment and patient details:', error);
                });
            }
        });
    
        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            const appointmentId = this.dataset.rowId;
            
            fetch(`/delete-appointment/${appointmentId}`, {
                method: 'DELETE',
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Appointment deleted successfully.');
                    getPatientRecords();
                } else {
                    console.error('Error deleting appointment:', data.error);
                }
            })
            .catch(error => {
                console.error('Error deleting appointment:', error);
            });
    
            var deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteRecordModal'));
            deleteModal.hide();
        });
    
        function getPatientRecords() {
            fetch('/get-patient-records')
                .then(response => response.json())
                .then(data => {
                    const table = new Tabulator("#appointments-table", {
                        data: data,
                        layout: "fitDataFill",
                        columns: [
                            { title: "Doctor", field: 'doctor_name'},
                            { title: "Appointment ID", field: "appointment_id", visible: false },
                            { title: "Patient ID", field: "patient_id", headerFilter: "input", headerHozAlign: "center" },
                            { title: "Name", field: "name", headerFilter: "input", headerHozAlign: "center" },
                            { title: "Age", field: "age", headerFilter: "input", headerHozAlign: "center" },
                            { title: "Address", field: "address", headerFilter: "input", headerHozAlign: "center" },
                            { title: "Number", field: "number", headerFilter: "input", headerHozAlign: "center" },
                            { title: "Last Visit", field: "last_visited", headerFilter: "input", headerHozAlign: "center" },
                            {
                                title: "Status", field: "status", headerFilter: "input", headerHozAlign: "center", formatter: function (cell, formatterParams, onRendered) {
                                    const value = cell.getValue();
                                    let badgeClass = "";
                                    switch (value) {
                                        case "Scheduled":
                                            badgeClass = "badge-primary";
                                            break;
                                        case "Re-schedule":
                                            badgeClass = "badge-warning";
                                            break;
                                        case "Completed":
                                            badgeClass = "badge-success";
                                            break;
                                        case "Cancelled":
                                            badgeClass = "badge-danger";
                                            break;
                                        default:
                                            badgeClass = "badge-secondary";
                                    }
                                    return `<span class="badge ${badgeClass}">${value}</span>`;
                                }
                            },
                            {
                                title: "Actions",
                                field: "actions",
                                headerHozAlign: "center",
                                formatter: function (cell, formatterParams, onRendered) {
                                    const data = cell.getRow().getData();
                                    let buttons = `
                                        `;
                            
                                    if (data.status === "Completed" || data.status == "billing") {
                                        buttons += `
                                        <a class="btn btn-sm btn-info" href="edit-prescription?patientId=${data.patient_id}&appointmentId=${data.appointment_id}"><i class="fa fa-dollar-sign" ></i> View Prescription</a>`;
                                    } else if (data.status == "Scheduled" || data.status == "Re-schedule"){
                                        buttons +=`<button class="btn btn-sm btn-primary edit-btn"><i class="fa fa-pencil"></i> Edit</button>
                                        <button class="btn btn-sm btn-danger delete-btn"><i class="fa fa-trash"></i> Delete</button>
                                            <button class="btn btn-sm btn-success prescribe-btn"><i class="fa fa-file-medical"></i> Prescribe</button>`
                                    }
                            
                                    
                                    return buttons;   
                            }
                            ,
                            cellClick: function (e, cell) {
                                var data = cell.getRow().getData();
                                if (e.target.classList.contains('edit-btn')) {
                                    document.getElementById('editAppointmentId').value = data.appointment_id;
                                    document.getElementById('editPatientId').value = data.patient_id;
                                    document.getElementById('editPatientName').value = data.name;
                                    document.getElementById('editPatientAge').value = data.age;
                                    document.getElementById('editPatientAddress').value = data.address;
                                    document.getElementById('editPatientNumber').value = data.number;
                                        if (data.last_visited) {
                                            const dateParts = data.last_visited.split('T')[0].split('-');
                                            const formattedDate = `${dateParts[0]}-${dateParts[1]}-${dateParts[2]}`;
                                            document.getElementById('editLastVisit').value = formattedDate;
                                        } else {
                                            document.getElementById('editLastVisit').value = '';
                                        }
                                        const statusSelect = document.getElementById('editStatus');
                                        const options = Array.from(statusSelect.options).map(option => option.value);
                                        if (options.includes(data.status)) {
                                            statusSelect.value = data.status;
                                        } else {
                                            console.error('Status value not found in options:', data.status);
                                        }
                                        var editAppointmentModal = new bootstrap.Modal(document.getElementById('editAppointmentModal'));
                                        editAppointmentModal.show();
                                    } else if (e.target.classList.contains('delete-btn')) {
                                        document.getElementById('confirmDeleteBtn').dataset.rowId = data.appointment_id;
                                        var deleteModal = new bootstrap.Modal(document.getElementById('deleteRecordModal'));
                                        deleteModal.show();
                                    } else if (e.target.classList.contains('prescribe-btn')) {
                                       const appointmentId=document.getElementById('editAppointmentId').value = data.appointment_id;
                                       const patientId=document.getElementById('editPatientId').value = data.patient_id;
                                       window.location.href=`/create-prescription?appointmentId=${appointmentId}&patientId=${patientId}`
                                    }else if (e.target.classList.contains('billing-btn')) {
                                         window.location.href=`/` //link of billing page
                                     }
                                }
                            }
                        ]
                    });
                })
                .catch(error => {
                    console.error('Error fetching appointment data:', error);
                });
        }
    </script>
    </body>

</html>