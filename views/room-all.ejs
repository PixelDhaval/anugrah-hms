    <!-- Javascript -->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>

    <script src="../dist/assets/bundles/datatablescripts.bundle.js"></script>
    <script src="../dist/assets/vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>

    <!-- page js file -->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../dist/../js/pages/tables/jquery-datatable.js"></script>
    <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>
    <script src="../dist/assets/js/tabulator.min.js"></script>
    <script>
        const roomData = [
            { id: "1", roomNo: "101A", patientName: "Juan Freeman", roomType: "Delux", gender: "Male", adminDate: "2020-06-11", dischargeDate: "2020-06-18", status: "Occupied" },
            { id: "2", roomNo: "102A", patientName: "Juan Freeman", roomType: "Delux", gender: "Male", adminDate: "2020-06-11", dischargeDate: "2020-06-15", status: "Empty" },
            { id: "3", roomNo: "103A", patientName: "Frank Camly", roomType: "Super Delux", gender: "Male", adminDate: "2020-06-11", dischargeDate: "2020-06-21", status: "Occupied" },
            { id: "4", roomNo: "104A", patientName: "Juan Freeman", roomType: "Delux", gender: "Female", adminDate: "2020-06-13", dischargeDate: "2020-06-18", status: "Occupied" },
            { id: "5", roomNo: "105B", patientName: "Rose Rivera", roomType: "ICU", gender: "Male", adminDate: "2020-06-14", dischargeDate: "2020-06-18", status: "Occupied" },
            { id: "6", roomNo: "103A", patientName: "Richard Foos", roomType: "Super Delux", gender: "Female", adminDate: "2020-06-18", dischargeDate: "2020-06-18", status: "Empty" },
            { id: "7", roomNo: "106A", patientName: "Juan Freeman", roomType: "Delux", gender: "Female", adminDate: "2020-07-05", dischargeDate: "2020-07-11", status: "Occupied" },
            { id: "8", roomNo: "201A", patientName: "Brian Swader", roomType: "ICU", gender: "Male", adminDate: "2020-07-11", dischargeDate: "2020-07-18", status: "Empty" },
            { id: "9", roomNo: "204A", patientName: "Barbara Kelly", roomType: "Super Delux", gender: "Male", adminDate: "2020-07-11", dischargeDate: "2020-07-18", status: "Empty" },
            { id: "10", roomNo: "303A", patientName: "Orlando Lentz", roomType: "Delux", gender: "Female", adminDate: "2020-06-17", dischargeDate: "2020-06-18", status: "Occupied" },
            { id: "11", roomNo: "304A", patientName: "Robert Hammer", roomType: "ICU", gender: "Male", adminDate: "2020-06-16", dischargeDate: "2020-06-25", status: "Occupied" }
        ];

        // Initialize Tabulator
        const table = new Tabulator("#room-table", {
            data: roomData,
            layout: "fitDataFill",
            columns: [
                { title: "Room No", field: "roomNo", headerFilter: "input", headerHozAlign: "center" },
                { title: "Patient Name", field: "patientName", headerFilter: "input", headerHozAlign: "center" },
                { title: "Room Type", field: "roomType", headerFilter: "input", headerHozAlign: "center" },
                { title: "Gender", field: "gender", headerHozAlign: "center" },
                { title: "Admin Date", field: "adminDate", headerFilter: "input", headerHozAlign: "center" },
                { title: "Discharge Date", field: "dischargeDate", headerFilter: "input", headerHozAlign: "center" },
                {
                    title: "Status",
                    field: "status",
                    headerFilter: "input",
                    headerHozAlign: "center",
                    formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const badgeClass = value === "Empty" ? "badge-warning" : "badge-success";
                        return `<span class="badge ${badgeClass}">${value}</span>`;
                    }
                }, {
                    title: "Actions",
                    field: "actions",
                    headerHozAlign: "center",
                    formatter: function (cell, formatterParams, onRendered) {
                        return `
                        <button class="btn btn-sm btn-primary edit-btn"><i class="fa fa-pencil"></i> Edit</button>
                        <button class="btn btn-sm btn-danger delete-btn"><i class="fa fa-trash"></i> Delete</button>`;
                    },
                    cellClick: function (e, cell) {
                        var data = cell.getRow().getData();
                        if (e.target.classList.contains('edit-btn')) {

                            //Populate the modal fields
                            document.getElementById('editRoomNo').value = data.roomNo;
                            document.getElementById('editPatientName').value = data.patientName;
                            document.getElementById('editRoomType').value = data.roomType;
                            document.getElementById('editGender').value = data.gender;
                            document.getElementById('editAdminDate').value = data.adminDate;
                            document.getElementById('editDischargeDate').value = data.dischargeDate;
                            document.getElementById('editStatus').value = data.status;

                            //Store the row ID for update
                            document.getElementById('editRoomForm').dataset.rowId = data.id;

                            //Show the Edit modal
                            const editModal = new bootstrap.Modal(document.getElementById('editRoomModal'));
                            editModal.show();
                        } else if (e.target.classList.contains('delete-btn')) {
                            var deleteModal = new bootstrap.Modal(document.getElementById('deleteRoomModal'));
                            deleteModal.show();
                        }

                    }
                }
            ]
        });

        // Save changes button
        document.getElementById('saveRoomChangesBtn').addEventListener('click', function () {
            const editRoomForm = document.getElementById('editRoomForm');
            if (editRoomForm.checkValidity() === false) {
                editRoomForm.classList.add('was-validated');
            } else {
                const rowId = editRoomForm.dataset.rowId;
                const updatedData = {
                    id: rowId,
                    roomNo: document.getElementById('editRoomNo').value,
                    patientName: document.getElementById('editPatientName').value,
                    roomType: document.getElementById('editRoomType').value,
                    gender: document.getElementById('editGender').value,
                    adminDate: document.getElementById('editAdminDate').value,
                    dischargeDate: document.getElementById('editDischargeDate').value,
                    status: document.getElementById('editStatus').value,
                };
                table.updateRow(rowId, updatedData);

                const editModal = bootstrap.Modal.getInstance(document.getElementById('editRoomModal'));
                editModal.hide();
            }
        });

        //Confirm delete button
        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            var userId = this.dataset.userId;
            table.deleteRow(userId);
            var deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteRoomModal'));
            deleteModal.hide();
        });
    </script>
