<!doctype html>
<html lang="en">

<head>
    <title>AHMS :: Alloted Room</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Iconic Bootstrap 4.5.0 Admin Template">
    <meta name="author" content="WrapTheme, design by: ThemeMakker.com">

    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <!-- VENDOR CSS -->
    <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/jquery-datatable/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap-datepicker/css/bootstrap-datepicker3.min.css">

    <!-- MAIN CSS -->
    <link rel="stylesheet" href="../dist/assets/css/main.css">
    <link rel="stylesheet" href="../dist/assets/css/tabulator_bootstrap5.css">

    <style>
        .tabulator {
            font-size: 12px;
            text-align: center;
        }
    </style>

</head>

<body data-theme="light" class="font-nunito">

    <div id="wrapper" class="theme-cyan">

        <%- include('navbar') %>


        <!-- main page content body part -->
        <div id="main-content">
            <div class="container-fluid">
                <div class="block-header">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <h2>Allotted Room</h2>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/index"><i class="fa fa-dashboard"></i></a>
                                </li>
                                <li class="breadcrumb-item">Room</li>
                                <li class="breadcrumb-item active">Allotted Room</li>
                            </ul>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <div class="d-flex flex-row-reverse">
                                <div class="p-2 d-flex">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row clearfix">
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="card mt-4">
                            <div class="header">
                                <h2>Allotted Rooms</h2>
                            </div>
                            <div class="body">
                                <div id="room-table"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Edit Room Modal-->
        <div class="modal fade" id="editRoomModal" tabindex="-1" aria-labelledby="editRoomModalLabel"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editRoomModalLabel">Edit Room Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="editRoomForm" novalidate>
                            <div class="mb-3">
                                <label for="editRoomNo" class="form-label">Room No</label>
                                <input type="text" class="form-control" id="editRoomNo" readonly>
                            </div>
                            <div class="mb-3">
                                <label for="editPatientName" class="form-label">Patient Name</label>
                                <input type="text" class="form-control" id="editPatientName" required>
                                <div class="invalid-feedback">Please provide a name.</div>
                            </div>
                            <div class="mb-3">
                                <label for="editRoomType" class="form-label">Room Type</label>
                                <input type="text" class="form-control" id="editRoomType" required>
                                <div class="invalid-feedback">Please provide a room type.</div>
                            </div>
                            <div class="mb-3">
                                <label for="editGender" class="form-label">Gender</label>
                                <input type="text" class="form-control" id="editGender" required>
                                <div class="invalid-feedback">Please provide gender.</div>
                            </div>
                            <div class="mb-3">
                                <label for="editAdminDate" class="form-label">Admin Date</label>
                                <input type="date" class="form-control" id="editAdminDate" required>
                                <div class="invalid-feedback">Please provide an admin date.</div>
                            </div>
                            <div class="mb-3">
                                <label for="editDischargeDate" class="form-label">Discharge Date</label>
                                <input type="date" class="form-control" id="editDischargeDate" required>
                                <div class="invalid-feedback">Please provide a discharge date.</div>
                            </div>
                            <div class="mb-3">
                                <label for="editStatus" class="form-label">Status</label>
                                <select class="form-control" id="editStatus" required>
                                    <option value="Occupied">Occupied</option>
                                    <option value="Empty">Empty</option>
                                </select>
                                <div class="invalid-feedback">Please select a status.</div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="saveRoomChangesBtn">Save changes</button>
                    </div>
                </div>
            </div>
        </div>

        <!--Delete Room Modal -->
        <div class="modal fade" id="deleteRoomModal" tabindex="-1" aria-labelledby="deleteRoomModalLabel"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteRoomModalLabel">Delete User</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body m-3">
                        <p>Are you sure you want to delete this user?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <!-- Javascript -->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>

    <script src="../dist/assets/bundles/datatablescripts.bundle.js"></script>
    <script src="../dist/assets/vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>

    <!-- page js file -->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../dist/../js/pages/tables/jquery-datatable.js"></script>
    <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>
    <script src="../dist/assets/js/tabulator.min.js"></script>
    <script>
document.addEventListener("DOMContentLoaded", () => {
            fetch('get-user-name')
            .then(response => response.json())
            .then(data => {
                document.getElementById("login-name").innerHTML = data.name
                if(data.gender == "female"){
                    document.getElementById("login-img").src = "../dist/assets/images/user-f.jpg"
                } else if (data.gender == "male"){
                document.getElementById("login-img").src = "../dist/assets/images/user-m.jpg"

                }
            })
        })
        const roomData = [
            { id: "1", roomNo: "101A", patientName: "Juan Freeman", roomType: "Delux", gender: "Male", adminDate: "2020-06-11", dischargeDate: "2020-06-18", status: "Occupied" },
            { id: "2", roomNo: "102A", patientName: "Juan Freeman", roomType: "Delux", gender: "Male", adminDate: "2020-06-11", dischargeDate: "2020-06-15", status: "Empty" },
            { id: "3", roomNo: "103A", patientName: "Frank Camly", roomType: "Super Delux", gender: "Male", adminDate: "2020-06-11", dischargeDate: "2020-06-21", status: "Occupied" },
            { id: "4", roomNo: "104A", patientName: "Juan Freeman", roomType: "Delux", gender: "Female", adminDate: "2020-06-13", dischargeDate: "2020-06-18", status: "Occupied" },
            { id: "5", roomNo: "105B", patientName: "Rose Rivera", roomType: "ICU", gender: "Male", adminDate: "2020-06-14", dischargeDate: "2020-06-18", status: "Occupied" },
            { id: "6", roomNo: "103A", patientName: "Richard Foos", roomType: "Super Delux", gender: "Female", adminDate: "2020-06-18", dischargeDate: "2020-06-18", status: "Empty" },
            { id: "7", roomNo: "106A", patientName: "Juan Freeman", roomType: "Delux", gender: "Female", adminDate: "2020-07-05", dischargeDate: "2020-07-11", status: "Occupied" },
            { id: "8", roomNo: "201A", patientName: "Brian Swader", roomType: "ICU", gender: "Male", adminDate: "2020-07-11", dischargeDate: "2020-07-18", status: "Empty" },
            { id: "9", roomNo: "204A", patientName: "Barbara Kelly", roomType: "Super Delux", gender: "Male", adminDate: "2020-07-11", dischargeDate: "2020-07-18", status: "Empty" },
            { id: "10", roomNo: "303A", patientName: "Orlando Lentz", roomType: "Delux", gender: "Female", adminDate: "2020-06-17", dischargeDate: "2020-06-18", status: "Occupied" },
            { id: "11", roomNo: "304A", patientName: "Robert Hammer", roomType: "ICU", gender: "Male", adminDate: "2020-06-16", dischargeDate: "2020-06-25", status: "Occupied" }
        ];

        // Initialize Tabulator
        const table = new Tabulator("#room-table", {
            data: roomData,
            layout: "fitDataFill",
            columns: [
                { title: "Room No", field: "roomNo", headerFilter: "input", headerHozAlign: "center" },
                { title: "Patient Name", field: "patientName", headerFilter: "input", headerHozAlign: "center" },
                { title: "Room Type", field: "roomType", headerFilter: "input", headerHozAlign: "center" },
                { title: "Gender", field: "gender", headerHozAlign: "center" },
                { title: "Admin Date", field: "adminDate", headerFilter: "input", headerHozAlign: "center" },
                { title: "Discharge Date", field: "dischargeDate", headerFilter: "input", headerHozAlign: "center" },
                {
                    title: "Status",
                    field: "status",
                    headerFilter: "input",
                    headerHozAlign: "center",
                    formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const badgeClass = value === "Empty" ? "badge-warning" : "badge-success";
                        return `<span class="badge ${badgeClass}">${value}</span>`;
                    }
                }, {
                    title: "Actions",
                    field: "actions",
                    headerHozAlign: "center",
                    formatter: function (cell, formatterParams, onRendered) {
                        return `
                        <button class="btn btn-sm btn-primary edit-btn"><i class="fa fa-pencil"></i> Edit</button>
                        <button class="btn btn-sm btn-danger delete-btn"><i class="fa fa-trash"></i> Delete</button>`;
                    },
                    cellClick: function (e, cell) {
                        var data = cell.getRow().getData();
                        if (e.target.classList.contains('edit-btn')) {

                            //Populate the modal fields
                            document.getElementById('editRoomNo').value = data.roomNo;
                            document.getElementById('editPatientName').value = data.patientName;
                            document.getElementById('editRoomType').value = data.roomType;
                            document.getElementById('editGender').value = data.gender;
                            document.getElementById('editAdminDate').value = data.adminDate;
                            document.getElementById('editDischargeDate').value = data.dischargeDate;
                            document.getElementById('editStatus').value = data.status;

                            //Store the row ID for update
                            document.getElementById('editRoomForm').dataset.rowId = data.id;

                            //Show the Edit modal
                            const editModal = new bootstrap.Modal(document.getElementById('editRoomModal'));
                            editModal.show();
                        } else if (e.target.classList.contains('delete-btn')) {
                            var deleteModal = new bootstrap.Modal(document.getElementById('deleteRoomModal'));
                            deleteModal.show();
                        }

                    }
                }
            ]
        });

        // Save changes button
        document.getElementById('saveRoomChangesBtn').addEventListener('click', function () {
            const editRoomForm = document.getElementById('editRoomForm');
            if (editRoomForm.checkValidity() === false) {
                editRoomForm.classList.add('was-validated');
            } else {
                const rowId = editRoomForm.dataset.rowId;
                const updatedData = {
                    id: rowId,
                    roomNo: document.getElementById('editRoomNo').value,
                    patientName: document.getElementById('editPatientName').value,
                    roomType: document.getElementById('editRoomType').value,
                    gender: document.getElementById('editGender').value,
                    adminDate: document.getElementById('editAdminDate').value,
                    dischargeDate: document.getElementById('editDischargeDate').value,
                    status: document.getElementById('editStatus').value,
                };
                table.updateRow(rowId, updatedData);

                const editModal = bootstrap.Modal.getInstance(document.getElementById('editRoomModal'));
                editModal.hide();
            }
        });

        //Confirm delete button
        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            var userId = this.dataset.userId;
            table.deleteRow(userId);
            var deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteRoomModal'));
            deleteModal.hide();
        });
    </script>
</body>

</html>