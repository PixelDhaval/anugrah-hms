<!doctype html>
<html lang="en">

<head>
    <title>AHMS :: Create User</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Iconic Bootstrap 4.5.0 Admin Template">
    <meta name="author" content="WrapTheme, design by: ThemeMakker.com">
    <link rel="icon" href="favicon.ico" type="image/x-icon">

    <!-- VENDOR CSS -->
    <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css">

    <!-- MAIN Project CSS file -->
    <link rel="stylesheet" href="../dist/assets/css/main.css">
    <link rel="stylesheet" href="../dist/assets/css/tabulator_bootstrap5.css">
    <style>
        .tabulator {
            font-size: 12px;
            text-align: center;
        }
    </style>
</head>

<body data-theme="light" class="font-nunito">
    <div id="wrapper" class="theme-cyan">

        <%- include('navbar') %>


        <!-- main page content body part -->
        <div id="main-content">
            <div class="container-fluid">
                <div class="block-header">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <h2>User Authentication</h2>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a href="index.html"><i class="fa fa-dashboard"></i></a>
                                </li>
                                <li class="breadcrumb-item active">User Authentication</li>
                            </ul>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12">
                        </div>
                    </div>
                </div>

                <div class="row clearfix">
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="card mt-4">
                            <div class="header">
                                <h2>User Authentication</h2>
                            </div>
                            <div class="body">
                                <div id="user-table"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Edit User Modal-->
        <div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editUserModalLabel">Edit User Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body m-3">
                        <form id="editUserForm" novalidate>
                            <div class="mb-3">
                                <label for="editFullname" class="form-label">Name</label>
                                <input type="text" class="form-control" id="editFullname">
                            </div>
                            <div class="mb-3">
                                <label for="editUsername" class="form-label">Username</label>
                                <input type="text" class="form-control" id="editUsername">
                            </div>
                            <div class="mb-3">
                                <label for="editUserType" class="form-label">Type of User</label>
                                <select class="form-control" id="editUserType" required>
                                    <option value="Doctor">Doctor</option>
                                    <option value="Receptionist">Receptionist</option>
                                </select>
                                <div class="invalid-feedback">Please select a user type.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Permissions</label><br>
                                <div class="form-check d-inline-block me-3">
                                    <input type="checkbox" class="form-check-input" id="editPatients">
                                    <label class="form-check-label" for="editPatients">Patients</label>
                                </div>
                                <div class="form-check d-inline-block me-3">
                                    <input type="checkbox" class="form-check-input" id="editAppointments">
                                    <label class="form-check-label" for="editAppointments">Appointments</label>
                                </div>
                                <div class="form-check d-inline-block me-3">
                                    <input type="checkbox" class="form-check-input" id="editUserMgt">
                                    <label class="form-check-label" for="editUserMgt">User Management</label>
                                </div>
                                <div class="form-check d-inline-block me-3">
                                    <input type="checkbox" class="form-check-input" id="editRollAllot">
                                    <label class="form-check-label" for="editRollAllot">Roll Allotment</label>
                                </div>
                                <div class="form-check d-inline-block me-3">
                                    <input type="checkbox" class="form-check-input" id="editBilling">
                                    <label class="form-check-label" for="editBilling">Billing</label>
                                </div>
                                <div class="form-check d-inline-block me-3">
                                    <input type="checkbox" class="form-check-input" id="editReports">
                                    <label class="form-check-label" for="editReports">Reports</label>
                                </div>
                                <div class="form-check d-inline-block me-3">
                                    <input type="checkbox" class="form-check-input" id="editDoctors">
                                    <label class="form-check-label" for="editDoctors">Doctors</label>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="saveChangesBtn">Save changes</button>
                    </div>
                </div>
            </div>
        </div>

        <!--Change Password Modal-->
        <!--Change Password Modal-->
        <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="changePasswordModalLabel">Change Password</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body m-3">
                        <form id="changePasswordForm" class="needs-validation" novalidate>
                            <div class="mb-3">
                                <label for="newPassword" class="form-label">New Password</label>
                                <input type="password" class="form-control" id="newPassword" name="password"
                                    placeholder="Enter new password" pattern=".{8,15}" required>
                                <div class="invalid-feedback">Password must be between 8 and 15 characters long!</div>
                            </div>
                            <div class="mb-3">
                                <label for="confirmNewPassword" class="form-label">Confirm Password</label>
                                <input type="password" class="form-control" id="confirmNewPassword"
                                    placeholder="Confirm Password" required>
                                <div class="invalid-feedback">Please confirm your password.</div>
                            </div>
                            <div class="invalid-feedback d-none password-mismatch-feedback">
                                Passwords do not match!
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="savePasswordBtn">Save Password</button>
                    </div>
                </div>
            </div>
        </div>
        <!--Delete User Modal -->
        <div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteUserModalLabel">Delete User</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body m-3">
                        <p>Are you sure you want to delete this user?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                    </div>
                </div>
            </div>
        </div>


    </div>
    <!-- Javascript -->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>
    <!-- page vendor js file -->
    <script src="../dist/assets/bundles/apexcharts.bundle.js"></script>
    <!-- page js file -->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../../dist/assets/js/hospital/index.js"></script>
    <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>
    <script src="../dist/assets/js/tabulator.min.js"></script>
   <!-- Frontend script -->
    

<script>
document.addEventListener("DOMContentLoaded", () => {
            fetch('get-user-name')
            .then(response => response.json())
            .then(data => {
                document.getElementById("login-name").innerHTML = data.name
                if(data.gender == "female"){
                    document.getElementById("login-img").src = "../dist/assets/images/user-f.jpg"
                } else if (data.gender == "male"){
                document.getElementById("login-img").src = "../dist/assets/images/user-m.jpg"

                }
            })
        })
    
    let user_id = null;
    document.addEventListener('DOMContentLoaded', function () {
        const table = new Tabulator("#user-table", {
            layout: "fitDataFill",
            columns: [
                { title: "#", field: "user_id" },
                { title: "Username", field: "username", headerFilter: "input", headerHozAlign: "center" },
                { title: "First Name", field: "firstname", headerFilter: "input", headerHozAlign: "center" },
                { title: "Last Name", field: "lastname", headerFilter: "input", headerHozAlign: "center" },
                { title: "Role", field: "role", headerHozAlign: "center" },
                {
                    title: "Permissions",
                    field: "permissions",
                    headerHozAlign: "center",
                    columns: [
                        { title: "Patients", field: "patient", formatter: "tickCross" },
                        { title: "Appointments", field: "appointment", formatter: "tickCross" },
                        { title: "User Management", field: "user_management", formatter: "tickCross" },
                        { title: "Room Allotment", field: "room_allotment", formatter: "tickCross" },
                        { title: "Billing", field: "billing", formatter: "tickCross" },
                        { title: "Reports", field: "reports", formatter: "tickCross" },
                        { title: "Doctors", field: "doctor", formatter: "tickCross" }
                    ]
                },
                {
                    title: "Actions",
                    headerHozAlign: "center",
                    formatter: function (cell, formatterParams, onRendered) {
                        return `
                            <button class="btn btn-sm btn-primary edit-btn"><i class="fa fa-pencil"></i> Edit</button>
                            <button class="btn btn-sm btn-primary change-password-btn"><i class="fa fa-pencil"></i> Password</button>
                            <button class="btn btn-sm btn-danger delete-btn"><i class="fa fa-trash"></i> Delete</button>`;
                    },
                    cellClick: function (e, cell) {
                        var data = cell.getRow().getData();
                        user_id = data.user_id; // Set user_id globally
                        if (e.target.classList.contains('edit-btn')) {
                            // Populate edit modal fields
                            document.getElementById('editFullname').value = data.firstname + ' ' + data.lastname;
                            document.getElementById('editUsername').value = data.username;
                            var editUserType = document.getElementById('editUserType');
                            var roleValue = data.role.trim().toLowerCase();

                            for (var i = 0; i < editUserType.options.length; i++) {
                                if (editUserType.options[i].value.trim().toLowerCase() === roleValue) {
                                    editUserType.selectedIndex = i;
                                    break;
                                }
                            }

                            document.getElementById('editPatients').checked = data.patient;
                            document.getElementById('editAppointments').checked = data.appointment;
                            document.getElementById('editUserMgt').checked = data.user_management;
                            document.getElementById('editRollAllot').checked = data.room_allotment;
                            document.getElementById('editBilling').checked = data.billing;
                            document.getElementById('editReports').checked = data.reports;
                            document.getElementById('editDoctors').checked = data.doctor;

                            // Store row ID to update
                            document.getElementById('editUserForm').dataset.rowId = data.user_id;

                            var editModal = new bootstrap.Modal(document.getElementById('editUserModal'));
                            editModal.show();
                        } else if (e.target.classList.contains('delete-btn')) {

                            var deleteModal = new bootstrap.Modal(document.getElementById('deleteUserModal'));
                            deleteModal.show();

                            function handleConfirmDelete() {
                                deleteModal.hide();
                                deleteUsers(data.user_id);
                                document.getElementById('confirmDeleteBtn').removeEventListener('click', handleConfirmDelete);
                            }

                            document.getElementById('confirmDeleteBtn').addEventListener('click', handleConfirmDelete);
                        } else if (e.target.classList.contains('change-password-btn')) {

                            var changePasswordModal = new bootstrap.Modal(document.getElementById('changePasswordModal'));
                            changePasswordModal.show();
                        }
                    }
                }
            ]
        });

        function fetchUsers() {
            fetch('/showUsers')
                .then(response => response.json())
                .then(data => {
                    table.setData(data);
                })
                .catch(error => console.error('Error fetching user data:', error));
        }

        //function to update user
        function updateUser() {
            
            var form = document.getElementById('editUserForm');
            var rowId = form.dataset.rowId;
            var fullname = document.getElementById('editFullname').value.split(' ');
            var firstname = fullname[0];
            var lastname = fullname.length > 1 ? fullname.slice(1).join(' ') : '';
            var username = document.getElementById('editUsername').value;
            var role = document.getElementById('editUserType').value.toLowerCase();
            var patient = document.getElementById('editPatients').checked;
            var appointment = document.getElementById('editAppointments').checked;
            var userManagement = document.getElementById('editUserMgt').checked;
            var roomAllotment = document.getElementById('editRollAllot').checked;
            var billing = document.getElementById('editBilling').checked;
            var reports = document.getElementById('editReports').checked;
            var doctor = document.getElementById('editDoctors').checked;

            var payload = {
                user_id: rowId,
                username: username,
                firstname: firstname,
                lastname: lastname,
                role: role,
                patient: patient,
                appointment: appointment,
                user_management: userManagement,
                room_allotment: roomAllotment,
                billing: billing,
                reports: reports,
                doctor: doctor
            };
            var editModal = bootstrap.Modal.getInstance(document.getElementById('editUserModal'));
            editModal.hide();
            
            fetch('/updateUser', {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert("User Updated Successfully!");
                    fetchUsers();
                } else {
                    alert("Failed to Update User!");
                    console.error('Failed to update user:', data.message);
                }
            })
            .catch(error => console.error('Error:', error));
        }
        document.getElementById('saveChangesBtn').addEventListener('click', updateUser);

        //function to change password
        // Password button
    const newPassword = document.getElementById('newPassword');
    const confirmNewPassword = document.getElementById('confirmNewPassword');
    const passwordMismatchFeedback = document.querySelector('.password-mismatch-feedback');
    const changePasswordForm = document.getElementById('changePasswordForm');
    const savePasswordBtn = document.getElementById('savePasswordBtn');

    // Passwords match validation
    function passwordCheck() {
        if (newPassword.value !== confirmNewPassword.value) {
            confirmNewPassword.setCustomValidity('Passwords do not match');
            confirmNewPassword.classList.add('is-invalid');
            confirmNewPassword.classList.remove('is-valid');
            passwordMismatchFeedback.classList.remove('d-none');
        } else {
            confirmNewPassword.setCustomValidity('');
            confirmNewPassword.classList.remove('is-invalid');
            confirmNewPassword.classList.add('is-valid');
            passwordMismatchFeedback.classList.add('d-none');
        }
    }

    // Form input changes for confirm password
    confirmNewPassword.addEventListener('input', passwordCheck);
    newPassword.addEventListener('input', passwordCheck);

    // Function to change password
    function changePassword() {
        if (changePasswordForm.checkValidity() === false) {
            changePasswordForm.classList.add('was-validated');
            return; // Early return if form is not valid
        }

        var payload = {
            userId: user_id,  // Ensure 'user_id' is defined and available
            newPassword: newPassword.value
        };

        var changePasswordModal = bootstrap.Modal.getInstance(document.getElementById('changePasswordModal'));
        changePasswordModal.hide();

        fetch('/changePassword', {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Password changed successfully!');
            } else {
                console.error('Failed to change password:', data.message);
            }
        })
        .catch(error => console.error('Error:', error));
    }

    // Save Password button
    savePasswordBtn.addEventListener('click', changePassword);
        // Function to delete user
        function deleteUsers(userId) {
            fetch(`/delete-user/${userId}`, {
                method: 'DELETE'
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                
                fetchUsers(); 
            })
            .catch(error => {
                console.error('Error deleting user:', error);
                alert('Failed to delete user.');
            });
        }

        // Initial fetchUsers call
        fetchUsers();
    });
</script>
    
</body>

</html>