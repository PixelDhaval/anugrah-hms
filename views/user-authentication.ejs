   <!-- Frontend script -->
<script>
        
    document.addEventListener('DOMContentLoaded', function () {
        const table = new Tabulator("#user-table", {
            layout: "fitDataFill",
            columns: [
                { title: "#", field: "user_id" },
                { title: "Username", field: "username", headerFilter: "input", headerHozAlign: "center" },
                { title: "First Name", field: "firstname", headerFilter: "input", headerHozAlign: "center" },
                { title: "Last Name", field: "lastname", headerFilter: "input", headerHozAlign: "center" },
                { title: "Role", field: "role", headerHozAlign: "center" },
                {
                    title: "Permissions",
                    field: "permissions",
                    headerHozAlign: "center",
                    columns: [
                        { title: "Patients", field: "patient", formatter: "tickCross" },
                        { title: "Appointments", field: "appointment", formatter: "tickCross" },
                        { title: "User Management", field: "user_management", formatter: "tickCross" },
                        { title: "Room Allotment", field: "room_allotment", formatter: "tickCross" },
                        { title: "Billing", field: "billing", formatter: "tickCross" },
                        { title: "Reports", field: "reports", formatter: "tickCross" },
                        { title: "Doctors", field: "doctor", formatter: "tickCross" }
                    ]
                },
                {
                    title: "Actions",
                    headerHozAlign: "center",
                    formatter: function (cell, formatterParams, onRendered) {
                        return `
                            <button class="btn btn-sm btn-primary edit-btn"><i class="fa fa-pencil"></i> Edit</button>
                            <button class="btn btn-sm btn-primary change-password-btn"><i class="fa fa-pencil"></i> Password</button>
                            <button class="btn btn-sm btn-danger delete-btn"><i class="fa fa-trash"></i> Delete</button>`;
                    },
                    cellClick: function (e, cell) {
                        var data = cell.getRow().getData();
                        if (e.target.classList.contains('edit-btn')) {
                            // Populate edit modal fields
                            document.getElementById('editFullname').value = data.firstname + ' ' + data.lastname;
                            document.getElementById('editUsername').value = data.username;
                            document.getElementById('editUserType').value = data.role;

                            // Checkboxes for permissions
                            document.getElementById('editPatients').checked = data.patient;
                            document.getElementById('editAppointments').checked = data.appointment;
                            document.getElementById('editUserMgt').checked = data.user_management;
                            document.getElementById('editRollAllot').checked = data.room_allotment;
                            document.getElementById('editBilling').checked = data.billing;
                            document.getElementById('editReports').checked = data.reports;
                            document.getElementById('editDoctors').checked = data.doctor;

                            // Store row ID to update
                            document.getElementById('editUserForm').dataset.rowId = data.user_id;

                            // Show edit modal
                            var editModal = new bootstrap.Modal(document.getElementById('editUserModal'));
                            editModal.show();
                        } else if (e.target.classList.contains('delete-btn')) {
                            // Show delete confirmation modal
                            var deleteModal = new bootstrap.Modal(document.getElementById('deleteUserModal'));
                            deleteModal.show();
                        } else if (e.target.classList.contains('change-password-btn')) {
                            // Show change password modal
                            var changePasswordModal = new bootstrap.Modal(document.getElementById('changePasswordModal'));
                            changePasswordModal.show();
                        }
                    }
                }
            ]
        });

        // Fetch users data from server
        fetch('/showUsers')
            .then(response => response.json())
            .then(data => {
                table.setData(data);
            })
            .catch(error => console.error('Error fetching user data:', error));
    });

    </script>
    
</body>

