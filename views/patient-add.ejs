<!DOCTYPE html>
<html lang="en">
    <head>
        <title>AHMS :: Add Patient</title>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, shrink-to-fit=no"
        />
        <meta
            name="description"
            content="Iconic Bootstrap 4.5.0 Admin Template"
        />
        <meta name="author" content="WrapTheme, design by: ThemeMakker.com" />
        <link rel="icon" href="favicon.ico" type="image/x-icon" />

        <!-- VENDOR CSS -->
        <link
            rel="stylesheet"
            href="/dist/assets/vendor/bootstrap/css/bootstrap.min.css"
        />
        <link
            rel="stylesheet"
            href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css"
        />
        <link
            rel="stylesheet"
            href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css"
        />

        <!-- MAIN Project CSS file -->
        <link rel="stylesheet" href="../dist/assets/css/main.css" />
    </head>

    <body data-theme="light" class="font-nunito">
        <div id="wrapper" class="theme-cyan">
            <%- include('navbar') %>


            <!-- main page content body part -->

            <div id="main-content">
                <div class="container-fluid">
                    <div class="block-header">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-12">
                                <h2>All Patient</h2>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="index.html"
                                            ><i class="fa fa-dashboard"></i
                                        ></a>
                                    </li>
                                    <li class="breadcrumb-item">Patient</li>
                                    <li class="breadcrumb-item active">
                                        All Patient
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-md-12">
                            <div class="card patients-list">
                                <div class="header">
                                    <h2>Add Patients</h2>
                                </div>
                                <div class="body">
                                    <form id="patientForm" novalidate>
                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                <label
                                                    for="patient_id"
                                                    class="form-label"
                                                    >Patient ID</label
                                                >
                                                <input
                                                    type="text"
                                                    class="form-control"
                                                    id="patient_id"
                                                    name="patient_id"
                                                    required
                                                    readonly
                                                />
                                            </div>
                                            <div class="col-md-4">
                                                <label
                                                    for="Fname"
                                                    class="form-label"
                                                    >First Name</label
                                                >
                                                <input
                                                    type="text"
                                                    class="form-control"
                                                    id="Fname"
                                                    name="Fname"
                                                    required
                                                />
                                                <div class="invalid-feedback">
                                                    Please enter the first name.
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <label
                                                    for="Lname"
                                                    class="form-label"
                                                    >Last Name</label
                                                >
                                                <input
                                                    type="text"
                                                    class="form-control"
                                                    id="Lname"
                                                    name="Lname"
                                                    required
                                                />
                                                <div class="invalid-feedback">
                                                    Please enter the last name.
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label
                                                    for="birthdate"
                                                    class="form-label"
                                                    >Date of Birth</label
                                                >
                                                <input
                                                    type="date"
                                                    class="form-control"
                                                    id="birthdate"
                                                    name="birthdate"
                                                    
                                                    readonly
                                                />
                                                <div class="invalid-feedback">
                                                    Please select the birthdate.
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label
                                                    for="age"
                                                    class="form-label"
                                                    >Age</label
                                                >
                                                <input
                                                    type="text"
                                                    class="form-control"
                                                    id="age"
                                                    name="age"
                                                    
                                                />
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                <label
                                                    for="gender"
                                                    class="form-label"
                                                    >Gender</label
                                                >
                                                <select
                                                    class="form-control"
                                                    id="gender"
                                                    name="gender"
                                                    required
                                                >
                                                    <option
                                                        value=""
                                                        disabled
                                                        selected
                                                    >
                                                        Select Gender
                                                    </option>
                                                    <option value="Male">
                                                        Male
                                                    </option>
                                                    <option value="Female">
                                                        Female
                                                    </option>
                                                    <option value="Other">
                                                        Other
                                                    </option>
                                                </select>
                                                <div class="invalid-feedback">
                                                    Please select the gender.
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <label
                                                    for="phone"
                                                    class="form-label"
                                                    >Phone</label
                                                >
                                                <input
                                                    type="tel"
                                                    pattern="[0-9]{10}"
                                                    class="form-control"
                                                    id="phone"
                                                    name="phone"
                                                    required
                                                />
                                                <div class="invalid-feedback">
                                                    Please enter a valid phone
                                                    number.
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <label
                                                    for="doctorAssigned"
                                                    class="form-label"
                                                    >Assign Doctor</label
                                                >
                                                <select
                                                    class="form-control"
                                                    id="doctorAssigned"
                                                    name="doctor_assigned"
                                                    required
                                                    onchange="setDoctorId()"
                                                >
                                                    <option
                                                        value=""
                                                        disabled
                                                        selected
                                                    >
                                                        Assign Doctor
                                                    </option>
                                                    <% if (doctors &&
                                                    doctors.length > 0) { %> <%
                                                    doctors.forEach(doctor => {
                                                    %>
                                                    <option
                                                        value="<%= doctor.name %>"
                                                        data-doctor-id="<%= doctor.doctor_id %>"
                                                    >
                                                        <%= doctor.name %>
                                                    </option>
                                                    <% }); %> <% } else { %>
                                                    <option value="" disabled>
                                                        No doctors available
                                                    </option>
                                                    <% } %>
                                                </select>
                                                <input
                                                    type="hidden"
                                                    id="doctor_id"
                                                    name="doctor_id"
                                                />
                                                <div class="invalid-feedback">
                                                    Please assign the doctor.
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label
                                                for="address"
                                                class="form-label"
                                                >Address</label
                                            >
                                            <textarea
                                                class="form-control"
                                                id="address"
                                                name="address"
                                                rows="4"
                                                required
                                            ></textarea>
                                            <div class="invalid-feedback">
                                                Please enter the address.
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label
                                                for="medical_history"
                                                class="form-label"
                                                >Medical History</label
                                            >
                                            <textarea
                                                class="form-control"
                                                id="medical_history"
                                                name="medical_history"
                                                rows="4"
                                                required
                                            ></textarea>
                                            <div class="invalid-feedback">
                                                Please enter medical history.
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label
                                                for="refered_by"
                                                class="form-label"
                                                >Referred By</label
                                            >
                                            <input
                                                type="text"
                                                class="form-control"
                                                id="refered_by"
                                                name="refered_by"
                                                required
                                            />
                                            <div class="invalid-feedback">
                                                Please enter the referrer.
                                            </div>
                                        </div>
                                        <!-- <a href="/patient-complaints" class="btn btn-primary" role="button"
                                        id="submitBtn">Submit</a> -->
                                        <button
                                            type="button"
                                            class="btn btn-primary"
                                            id="submitBtn"
                                            onclick="handleFormSubmit()"
                                        >
                                            Create & Complaint
                                        </button>
                                        <button
                                            type="buttom"
                                            class="btn btn-secondary"
                                            id="createBtn"
                                            onclick="patientCreate()"
                                        >
                                            Create
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Javascript-->
        <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
        <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>

        <!-- page vendor js file -->
        <script src="../dist/assets/bundles/apexcharts.bundle.js"></script>

        <!-- page js file -->
        <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
        <script src="../../js/hospital/index.js"></script>
        <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>

        <script>
document.addEventListener("DOMContentLoaded", () => {
            fetch('get-user-name')
            .then(response => response.json())
            .then(data => {
                document.getElementById("login-name").innerHTML = data.name
                if(data.gender == "female"){
                    document.getElementById("login-img").src = "../dist/assets/images/user-f.jpg"
                } else if (data.gender == "male"){
                document.getElementById("login-img").src = "../dist/assets/images/user-m.jpg"

                }
            })
        })
            function setDoctorId() {
                const doctorAssignedSelect =
                    document.getElementById("doctorAssigned");
                const selectedOption =
                    doctorAssignedSelect.options[
                        doctorAssignedSelect.selectedIndex
                    ];
                const doctorId = selectedOption.getAttribute("data-doctor-id");
                document.getElementById("doctor_id").value = doctorId;
            }
            document.addEventListener("DOMContentLoaded", () => {
                fetch("/get-next-patient-id")
                    .then((response) => response.json())
                    .then((data) => {
                        document.getElementById("patient_id").value =
                            data.nextPatientId;
                    })
                    .catch((error) => {
                        console.error("Error fetching next patient ID:", error);
                    });

                document
                    .getElementById("birthdate")
                    .addEventListener("change", function () {
                        // calculateAge();
                    });
            });

            function handleFormSubmit(event) {
                // event.preventDefault();

                const form = document.getElementById("patientForm");

                if (form.checkValidity()) {
                    const patientId =
                        document.getElementById("patient_id").value;
                    const doctorId = document.getElementById("doctor_id").value;

                    const patientData = {
                        patient_id: patientId,
                        Fname: document.getElementById("Fname").value,
                        Lname: document.getElementById("Lname").value,
                        birthdate: document.getElementById("birthdate").value,
                        age: document.getElementById("age").value,
                        gender: document.getElementById("gender").value,
                        phone: document.getElementById("phone").value,
                        doctor_assigned:
                            document.getElementById("doctorAssigned").value,
                        address: document.getElementById("address").value,
                        medical_history:
                            document.getElementById("medical_history").value,
                        refered_by: document.getElementById("refered_by").value,
                        doctor_id: doctorId,
                    };

                    fetch("/add-patients", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(patientData),
                    })
                        .then((response) => {
                            if (!response.ok) {
                                throw new Error("Network response was not ok");
                            }
                            return response.json();
                        })
                        .then((data) => {
                            console.log("Patient added successfully:", data);

                            window.location.href = `/patient-complaints?patientId=${patientId}&doctorId=${doctorId}`;
                        })
                        .catch((error) => {
                            console.error("Error adding patient:", error);
                        });
                }

                form.classList.add("was-validated");
            }

            function patientCreate(event) {
                // event.preventDefault();

                const form = document.getElementById("patientForm");

                if (form.checkValidity()) {
                    const patientId =
                        document.getElementById("patient_id").value;
                    const doctorId = document.getElementById("doctor_id").value;

                    const patientData = {
                        patient_id: patientId,
                        Fname: document.getElementById("Fname").value,
                        Lname: document.getElementById("Lname").value,
                        birthdate: document.getElementById("birthdate").value,
                        age: document.getElementById("age").value,
                        gender: document.getElementById("gender").value,
                        phone: document.getElementById("phone").value,
                        doctor_assigned:
                            document.getElementById("doctorAssigned").value,
                        address: document.getElementById("address").value,
                        medical_history:
                            document.getElementById("medical_history").value,
                        refered_by: document.getElementById("refered_by").value,
                        doctor_id: doctorId,
                    };

                    fetch("/add-patients", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(patientData),
                    })
                        .then((response) => {
                            if (!response.ok) {
                                throw new Error("Network response was not ok");
                            }
                            return response.json();
                        })
                        .then((data) => {
                            console.log("Patient added successfully:", data);

                            window.location.href = `/all-patients`;
                        })
                        .catch((error) => {
                            console.error("Error adding patient:", error);
                        });
                }

                form.classList.add("was-validated");
            }

            const form = document.getElementById("patientForm");
            // form.addEventListener("submit", handleFormSubmit);

            function calculateAge() {
                const birthdate = new Date(
                    document.getElementById("birthdate").value
                );
                const today = new Date();

                let years = today.getFullYear() - birthdate.getFullYear();
                let months = today.getMonth() - birthdate.getMonth();
                let days = today.getDate() - birthdate.getDate();

                if (days < 0) {
                    months--;
                    const previousMonth = new Date(
                        today.getFullYear(),
                        today.getMonth(),
                        0
                    );
                    days += previousMonth.getDate();
                }

                if (months < 0) {
                    years--;
                    months += 12;
                }
                if (years < 0) {
                    years = 0;
                    months = 0;
                }

                document.getElementById(
                    "age"
                ).value = `${years} years, ${months} months and ${days} days`;
            }
        </script>
    </body>
</html>
