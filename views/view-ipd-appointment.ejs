    <script>
        function showLoadingScreen() {
            $('#loading-screen').show();
        }

        function hideLoadingScreen() {
            $('#loading-screen').hide();
        }

        document.addEventListener("DOMContentLoaded", () => {
            // Restore active tab from sessionStorage
            const activeTab = sessionStorage.getItem('activeTab');
            if (activeTab) {
                // Show the stored active tab
                $(`#patientTabs a[href="${activeTab}"]`).tab('show');
                // Clear the stored tab
                sessionStorage.removeItem('activeTab');
            }

            // Store active tab before form submissions
            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', function () {
                    const activeTab = document.querySelector('#patientTabs .nav-link.active').getAttribute('href');
                    sessionStorage.setItem('activeTab', activeTab);
                });
            });

            fetch('/get-user-name')
                .then(response => response.json())
                .then(data => {
                    document.getElementById("login-name").innerHTML = data.name
                    if (data.gender == "female") {
                        document.getElementById("login-img").src = "../dist/assets/images/user-f.jpg"
                    } else if (data.gender == "male") {
                        document.getElementById("login-img").src = "../dist/assets/images/user-m.jpg"
                    }
                })
        });

        $(document).ready(function () {
            // Initialize Bootstrap tabs
            $('#patientTabs a').on('click', function (e) {
                e.preventDefault();
                $(this).tab('show');
            });

            // Scroll active tab into view on mobile
            function scrollActiveTabIntoView() {
                const activeTab = document.querySelector('.nav-link.active');
                if (activeTab) {
                    activeTab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                }
            }

            // Call on tab change and window resize
            $('#patientTabs a').on('shown.bs.tab', scrollActiveTabIntoView);
            $(window).on('resize', scrollActiveTabIntoView);

            // Initial scroll on page load
            scrollActiveTabIntoView();

            // Handle form submission
            $('#addVitalForm').on('submit', function (e) {
                e.preventDefault();

                const formData = $(this).serialize();

                $.ajax({
                    url: '/add-ipd-vital',
                    type: 'POST',
                    data: formData,
                    success: function (response) {

                        $('#addVitalModal').modal('hide');
                        // Refresh vitals table
                        loadVitals('<%= appointment.id %>');
                        location.reload();
                    },
                    error: function (error) {
                        console.error('Error adding vital signs:', error);
                        alert('Error adding vital signs');
                    }
                });
            });

            // Handle complaint form submission
            $('#addComplaintForm').on('submit', function (e) {
                e.preventDefault();

                const formData = $(this).serialize();

                $.ajax({
                    url: '/add-ipd-complaint',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        $('#addComplaintModal').modal('hide');
                        // Refresh complaints table
                        location.reload();
                    },
                    error: function (error) {
                        console.error('Error adding complaint:', error);
                        alert('Error adding complaint');
                    }
                });
            });
        });

        function loadVitals(appointmentId) {
            // Add AJAX call to load vitals data
        }

        function loadComplaints(appointmentId) {
            // Add AJAX call to load complaints data
        }

        function initializeSelect2(container) {
            container.querySelectorAll('.select2').forEach(select => {
                $(select).select2({
                    width: '100%',
                    dropdownParent: $(select).parent()
                });
            });
            $("#medicine-select").select2({
                width: '100%',
                dropdownParent: $("#medicine-select").parent(),
                tags: true,
                createTag: function (params) {
                    if (!params.term) {
                        return null;
                    }
                    return {
                        id: "temp-" + params.term, // Temporary ID
                        text: params.term,
                        newTag: true
                    };
                }
            }).on("select2:select", function (e) {
                var data = e.params.data;

                if (data.newTag) {
                    $.ajax({
                        url: "/add-medicine",
                        type: "POST",
                        data: JSON.stringify({
                            name: data.text,
                            nos: null,
                            dose_qty: null,
                            doses: null,
                            timing: null
                        }),
                        contentType: "application/json",
                        success: function (response) {
                            // Assuming the response contains the new medicine ID
                            let newId = response.id;

                            // Find the temporary option and update its ID
                            let $option = $("#medicine-select option[value='temp-" + data.text + "']");
                            $option.val(newId).attr("data-id", newId);
                        },
                        error: function (error) {
                            console.log(error);
                        }
                    });
                }
            });

        }

        function togglePrescriptionForm() {
            const form = document.getElementById('prescriptionForm');
            form.style.display = form.style.display === 'none' ? 'block' : 'none';
            if (form.style.display === 'block') {
                initializeSelect2(form);
            }
        }

        function deleteMedicineEntry(button) {
            const entry = button.closest('.medicine-entry');
            const container = entry.parentElement;

            // Don't delete if it's the last entry
            if (container.querySelectorAll('.medicine-entry').length > 1) {
                // Destroy Select2 instances before removing the element
                entry.querySelectorAll('.select2').forEach(select => {
                    $(select).select2('destroy');
                });
                entry.remove();
            }
        }

        function addMedicineEntry() {
            const container = document.querySelector('.medicines-container');
            const template = container.querySelector('.medicine-entry').cloneNode(true);

            // Destroy existing Select2 instances
            template.querySelectorAll('.select2').forEach(select => {
                $(select).select2('destroy');
            });

            // Clear the values
            template.querySelectorAll('input, select').forEach(input => {
                if (input.type !== 'hidden') {
                    input.value = '';
                }
            });

            container.appendChild(template);

            // Initialize Select2 for the new entry
            initializeSelect2(template);
        }

        function updateMedicineDefaults(select) {
            const entry = select.closest('.medicine-entry');
            const option = select.options[select.selectedIndex];
            const customCheck = entry.querySelector('.custom-dose-check');

            if (option.value) {
                entry.querySelector('.medicine-nos').value = option.dataset.nos;

                // Check if medicine has default custom dose
                const isCustom = option.dataset.isCustom === 'true';
                customCheck.checked = isCustom;
                toggleCustomDose(customCheck);

                if (isCustom) {
                    entry.querySelector('.custom-dose-input').value = option.dataset.customDose;
                } else {
                    entry.querySelector('.medicine-dose').value = option.dataset.dose;
                    // Handle frequency (multiple select)
                    const frequencySelect = entry.querySelector('.medicine-frequency');
                    const frequencies = option.dataset.frequency.split(',').map(f => f.trim());
                    // Update Select2 multiple select
                    $(frequencySelect).val(frequencies).trigger('change');
                    // Handle duration
                    entry.querySelector('.medicine-duration').value = option.dataset.duration;
                }
            } else {
                // Clear all fields when no medicine is selected
                entry.querySelector('.medicine-nos').value = '';
                entry.querySelector('.medicine-dose').value = '';
                entry.querySelector('.custom-dose-input').value = '';
                customCheck.checked = false;
                $(entry.querySelector('.medicine-frequency')).val(null).trigger('change');
                entry.querySelector('.medicine-duration').value = '';
                toggleCustomDose(customCheck);
            }
        }

        let medicineList = [];

        function toggleCustomDose(checkbox) {
            const entry = checkbox.closest('.medicine-entry');
            const standardFields = entry.querySelector('.standard-dose-fields');
            const customField = entry.querySelector('.custom-dose-field');

            if (checkbox.checked) {
                standardFields.style.display = 'none';
                customField.style.display = 'block';
            } else {
                standardFields.style.display = 'block';
                customField.style.display = 'none';
            }
        }

        function addToMedicineTable(button) {
            const entry = button.closest('.medicine-entry');
            const select = entry.querySelector('.medicine-select');
            const isCustomDose = entry.querySelector('.custom-dose-check').checked;

            if (!select.value) {
                alert('Please select a medicine');
                return;
            }

            let medicine = {
                id: select.value,
                name: select.options[select.selectedIndex].text,
                nos: entry.querySelector('.medicine-nos').value,
                is_custom: isCustomDose
            };

            if (isCustomDose) {
                medicine.custom_doses = entry.querySelector('.custom-dose-input').value;
                medicine.dose_qty = '';
                medicine.doses = '';
                medicine.timing = '';
            } else {
                const frequency = Array.from(entry.querySelector('.medicine-frequency').selectedOptions)
                    .map(option => option.value)
                    .join(', ');
                medicine.dose_qty = entry.querySelector('.medicine-dose').value;
                medicine.doses = frequency;
                medicine.timing = entry.querySelector('.medicine-duration').value;
                medicine.custom_doses = '';
            }

            const existingIndex = medicineList.findIndex(m => m.id === medicine.id);
            if (existingIndex !== -1) {
                medicineList[existingIndex] = medicine;
            } else {
                medicineList.push(medicine);
            }

            refreshMedicineTable();
            clearMedicineEntry(entry);
        }

        function clearMedicineEntry(entry) {
            entry.querySelector('.medicine-select').value = '';
            entry.querySelector('.medicine-nos').value = '';
            entry.querySelector('.medicine-dose').value = '';
            entry.querySelector('.custom-dose-input').value = '';
            entry.querySelector('.custom-dose-check').checked = false;
            $(entry.querySelector('.medicine-frequency')).val(null).trigger('change');
            entry.querySelector('.medicine-duration').value = '';
            $(entry.querySelector('.medicine-select')).val(null).trigger('change');
            toggleCustomDose(entry.querySelector('.custom-dose-check'));
        }

        function refreshMedicineTable() {
            const tbody = document.getElementById('medicineTableBody');
            tbody.innerHTML = '';

            medicineList.forEach((medicine, index) => {
                const tr = document.createElement('tr');
                if (medicine.is_custom) {
                    tr.innerHTML = `
                        <td>${medicine.name}</td>
                        <td>${medicine.nos}</td>
                        <td colspan="3">${medicine.custom_doses}</td>
                        <td>
                            <i class="fa fa-edit edit-medicine" onclick="editMedicine(${index})"></i>
                            <i class="fa fa-trash delete-medicine-row" onclick="deleteMedicineFromTable(${index})"></i>
                        </td>
                    `;
                } else {
                    tr.innerHTML = `
                        <td>${medicine.name}</td>
                        <td>${medicine.nos}</td>
                        <td>${medicine.dose_qty}</td>
                        <td>${medicine.doses}</td>
                        <td>${medicine.timing}</td>
                        <td>
                            <i class="fa fa-edit edit-medicine" onclick="editMedicine(${index})"></i>
                            <i class="fa fa-trash delete-medicine-row" onclick="deleteMedicineFromTable(${index})"></i>
                        </td>
                    `;
                }
                tbody.appendChild(tr);
            });
        }

        function editMedicine(index) {
            const medicine = medicineList[index];
            const entry = document.querySelector('.medicine-entry');
            const customCheck = entry.querySelector('.custom-dose-check');

            // Set basic values
            $(entry.querySelector('.medicine-select')).val(medicine.id).trigger('change');
            entry.querySelector('.medicine-nos').value = medicine.nos;

            // Set custom/standard fields based on is_custom
            customCheck.checked = medicine.is_custom;
            toggleCustomDose(customCheck);

            if (medicine.is_custom) {
                entry.querySelector('.custom-dose-input').value = medicine.custom_doses;
            } else {
                entry.querySelector('.medicine-dose').value = medicine.dose_qty;
                $(entry.querySelector('.medicine-frequency')).val(medicine.doses.split(', ')).trigger('change');
                entry.querySelector('.medicine-duration').value = medicine.timing;
            }

            // Remove from table (will be added back when user clicks "Add to List")
            medicineList.splice(index, 1);
            refreshMedicineTable();
        }

        function deleteMedicineFromTable(index) {
            if (confirm('Are you sure you want to remove this medicine?')) {
                medicineList.splice(index, 1);
                refreshMedicineTable();
            }
        }

        // Update the form submit handler to include remarks
        document.getElementById('newPrescriptionForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            if (medicineList.length === 0) {
                alert('Please add at least one medicine to the prescription');
                return;
            }

            try {
                const response = await fetch('/ipd-prescription', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        patient_id: document.querySelector('input[name="patient_id"]').value,
                        appointment_id: document.querySelector('input[name="appointment_id"]').value,
                        medicines: medicineList,
                        remarks: document.getElementById('remarks').value
                    })
                });

                if (response.ok) {
                    location.reload();
                } else {
                    alert('Error saving prescription');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error saving prescription');
            }
        });
    </script>

    <script>
        function printPrescription(prescription) {
            console.log(prescription);
            const printContent = `
            <!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <title>Prescription</title>
                <style>
                    * {
                font-size: 20px;
            }
            .patient-detials {
