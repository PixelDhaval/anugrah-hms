                            <h2>IPD Bill</h2>
                            <div class="bill-inner-container">
                                <div class="bill-details">
                                    <div><strong>Patient Name:</strong> ${patient_name} (${patient_id})</div>
                                    <div><strong>Admission Date:</strong> ${appointment_date}</div>
                                    <div><strong>Room Type:</strong> ${room_type} (${room_number})</div>
                                    <div><strong>Bed Number:</strong> ${bed_number}</div>
                                    <div><strong>Doctor:</strong> ${doctor_name}</div>
                                </div>

                                <table class="bill-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 5%">#</th>
                                            <th style="width: 45%">Particular</th>
                                            <th style="width: 15%">Rate (Rs)</th>
                                            <th style="width: 15%">Qty</th>
                                            <th style="width: 20%">Amount (Rs)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${particulars.map((particular, index) => `
