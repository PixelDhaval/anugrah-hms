<!doctype html>
<html lang="en">

<head>
    <title>AHMS :: Appointments</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Iconic Bootstrap 4.5.0 Admin Template">
    <meta name="author" content="WrapTheme, design by: ThemeMakker.com">

    <!-- VENDOR CSS -->
    <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="../dist/assets/css/select2.min.css">
    <!-- MAIN Project CSS file -->
    <link rel="stylesheet" href="../dist/assets/css/main.css">
    <link rel="stylesheet" href="../dist/assets/css/tabulator_bootstrap5.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script src="../dist/assets/vendor/jquery/jquery.min.js"></script>
    <style>
        .tabulator {
            font-size: 12px;
            text-align: center;
        }

        #loading-screen {
            /* ... existing styles ... */
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .note-text {
            white-space: pre-line;
            max-width: 400px;
            /* Adjust based on your needs */
            word-wrap: break-word;
        }

        textarea.form-control {
            white-space: pre-line;
            min-height: 100px;
            resize: vertical;
        }
    </style>
</head>

<body data-theme="light" class="font-nunito">
    <div id="wrapper" class="theme-cyan">

        <!-- Page Loader -->
        <%- include('navbar') %>

            <!--main page content body part-->
            <div id="main-content">
                <div class="container-fluid">
                    <div class="block-header">
                        <div class="row">
                            <div class="col-lg-12 d-flex justify-content-between">
                                <h2>View IPD Appointments</h2>
                            </div>
                        </div>
                    </div>

                    <!-- Patient Details Card -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Patient Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <p class="mb-1"><strong>Patient ID:</strong>
                                        <%= appointment.patient_id %>
                                    </p>
                                    <p class="mb-1"><strong>Patient Name:</strong>
                                        <%= appointment.patient_name %>
                                    </p>
                                    <p class="mb-1"><strong>Age/Gender:</strong>
                                        <%= appointment.age %> / <%= appointment.gender %>
                                    </p>
                                </div>
                                <div class="col-md-3">
                                    <p class="mb-1"><strong>Room Type:</strong>
                                        <%= appointment.room_type %>
                                    </p>
                                    <p class="mb-1"><strong>Room No:</strong>
                                        <%= appointment.room_number %>
                                    </p>
                                    <p class="mb-1"><strong>Bed No:</strong>
                                        <%= appointment.bed_number %>
                                    </p>
                                </div>
                                <div class="col-md-3">
                                    <p class="mb-1"><strong>Doctor:</strong>
                                        <%= appointment.doctor_name %>
                                    </p>
                                    <p class="mb-1"><strong>Admission Date:</strong>
                                        <%= appointment.appointment_date %>
                                    </p>
                                    <p class="mb-1"><strong>Status:</strong>
                                        <%= appointment.status %>
                                    </p>
                                </div>
                                <div class="col-md-3">
                                    <p class="mb-1"><strong>Contact:</strong>
                                        <%= appointment.contact %>
                                    </p>
                                    <p class="mb-1"><strong>Address:</strong>
                                        <%= appointment.address %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Print Buttons -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-12">
                                    <div class="d-flex justify-content-center gap-2">
                                        <% if (appointment.status==='discharged' ) { %>
                                            <button class="btn btn-primary" onclick="printDischargeDetails()">
                                                <i class="fa fa-print"></i> Print Discharge Summary
                                            </button>
                                            <% } %>
                                                <button class="btn btn-primary" onclick="printAllTransactions()">
                                                    <i class="fa fa-print"></i> Print All Transactions
                                                </button>
                                                <button class="btn btn-primary"
                                                    onclick="printBill('<%= appointment.id %>')">
                                                    <i class="fa fa-print"></i> Print Bill
                                                </button>
                                                <button class="btn btn-primary" onclick="printLatestPrescription()">
                                                    <i class="fa fa-print"></i> Print Prescription
                                                </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tabs Section -->
                    <div class="card">
                        <div class="card-body">
                            <!-- Add a scrollable wrapper for tabs -->
                            <div class="nav-tabs-wrapper"
                                style="overflow-x: auto; -webkit-overflow-scrolling: touch; overflow-y: hidden;">
                                <ul class="nav nav-tabs" id="patientTabs" role="tablist"
                                    style="flex-wrap: nowrap; white-space: nowrap;">
                                    <li class="nav-item">
                                        <a class="nav-link active" id="vitals-tab" data-toggle="tab" href="#vitals"
                                            role="tab">
                                            <i class="fa fa-heartbeat"></i>
                                            <span class="d-none d-sm-inline"> Vitals</span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="complaints-tab" data-toggle="tab" href="#complaints"
                                            role="tab">
                                            <i class="bi bi-file-earmark-medical"></i>
                                            <span class="d-none d-sm-inline"> Complaints</span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="opd-history-tab" data-toggle="tab" href="#opd-history"
                                            role="tab">
                                            <i class="bi bi-capsule"></i>
                                            <span class="d-none d-sm-inline"> OPD History</span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="ipd-history-tab" data-toggle="tab" href="#ipd-history"
                                            role="tab">
                                            <i class="fa-solid fa-bed"></i>
                                            <span class="d-none d-sm-inline"> IPD History</span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="prescription-tab" data-toggle="tab" href="#prescription"
                                            role="tab">
                                            <i class="bi bi-prescription"></i>
                                            <span class="d-none d-sm-inline"> Prescription</span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-toggle="tab" href="#investigations">Investigations</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="notes-tab" data-toggle="tab" href="#notes" role="tab">
                                            <i class="fa fa-sticky-note"></i>
                                            <span class="d-none d-sm-inline"> Treatment</span>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" id="billings-tab" data-toggle="tab" href="#billings"
                                            role="tab">
                                            <i class="bi bi-file-earmark-medical"></i>
                                            <span class="d-none d-sm-inline"> Billings</span>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" id="transaction-tab" data-toggle="tab" href="#transaction"
                                            role="tab">
                                            <i class="bi bi-file-earmark-medical"></i>
                                            <span class="d-none d-sm-inline"> Transactions</span>
                                        </a>
                                    </li>

                                    <!-- Add this to your tabs list -->
                                    <li class="nav-item">
                                        <a class="nav-link" id="discharge-tab" data-toggle="tab" href="#discharge"
                                            role="tab">
                                            <i class="fa fa-hospital-alt"></i>
                                            <span class="d-none d-sm-inline"> Discharge</span>
                                        </a>
                                    </li>



                                </ul>
                            </div>

                            <!-- Add custom styles -->
                            <style>
                                /* Custom styles for responsive tabs */
                                .nav-tabs-wrapper {
                                    border-bottom: 1px solid #dee2e6;
                                    margin-bottom: 15px;
                                }

                                .nav-tabs {
                                    border-bottom: none;
                                }

                                .nav-tabs .nav-link {
                                    padding: 0.5rem 1rem;
                                    border: 1px solid transparent;
                                    border-radius: 0.25rem;
                                    margin-right: 5px;
                                }

                                .nav-tabs .nav-link.active {
                                    background-color: #007bff;
                                    color: white;
                                    border-color: #007bff;
                                }

                                /* Mobile optimizations */
                                @media (max-width: 767.98px) {
                                    .nav-tabs .nav-link {
                                        padding: 0.5rem;
                                        font-size: 20px;
                                        /* Larger icons for mobile */
                                    }

                                    .nav-tabs-wrapper {
                                        margin: -15px -15px 15px -15px;
                                        padding: 15px 15px 0 15px;
                                        background-color: #f8f9fa;
                                    }

                                    /* Show scrollbar indicators */
                                    .nav-tabs-wrapper::-webkit-scrollbar {
                                        height: 3px;
                                    }

                                    .nav-tabs-wrapper::-webkit-scrollbar-thumb {
                                        background-color: #007bff;
                                        border-radius: 3px;
                                    }

                                    .nav-tabs-wrapper::-webkit-scrollbar-track {
                                        background-color: #f8f9fa;
                                    }


                                }

                                /* Table responsiveness */
                                .table-responsive {
                                    overflow-x: auto;
                                    overflow-y: hidden;
                                    -webkit-overflow-scrolling: touch;
                                }

                                @media (max-width: 767.98px) {

                                    .table th,
                                    .table td {
                                        min-width: 100px;
                                        /* Ensure minimum width for table cells */
                                    }
                                }
                            </style>

                            <!-- Tab content with responsive tables -->
                            <div class="tab-content mt-3" id="patientTabContent">
                                <!-- Make all table containers responsive -->
                                <div class="tab-pane fade show active" id="vitals" role="tabpanel">
                                    <div class="table-responsive">
                                        <div class="row mb-3">
                                            <div class="col-md-12">

                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="d-flex justify-content-between my-2">
                                                    <h6>Vitals History</h6>
                                                    <button type="button" class="btn btn-primary" data-toggle="modal"
                                                        data-target="#addVitalModal">
                                                        + <span class="d-none d-sm-inline"> Vital</span>
                                                    </button>
                                                </div>
                                                <table class="table table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>Date</th>
                                                            <th>BP</th>
                                                            <th>Pulse</th>
                                                            <th>Temperature</th>
                                                            <th>SPO2</th>
                                                            <th>Height</th>
                                                            <th>Weight</th>
                                                            <th>Recorded By</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% if (vitals && vitals.length> 0) { %>
                                                            <% vitals.forEach(vital=> { %>
                                                                <tr>
                                                                    <td>
                                                                        <%= vital.vital_time %>
                                                                    </td>
                                                                    <td>
                                                                        <%= vital.bp %>
                                                                            <%= vital.bp ? 'mmHg' : '' %>
                                                                    </td>
                                                                    <td>
                                                                        <%= vital.pulse %>
                                                                            <%= vital.pulse ? 'BPM' : '' %>
                                                                    </td>
                                                                    <td>
                                                                        <%= vital.temp %>
                                                                            <%= vital.temp ? '°F' : '' %>
                                                                    </td>
                                                                    <td>
                                                                        <%= vital.spo2 %>
                                                                            <%= vital.spo2 ? '%' : '' %>
                                                                    </td>
                                                                    <td>
                                                                        <%= vital.height %>
                                                                            <%= vital.height ? 'cm' : '' %>
                                                                    </td>
                                                                    <td>
                                                                        <%= vital.weight %>
                                                                            <%= vital.weight ? 'kg' : '' %>
                                                                    </td>
                                                                    <td>
                                                                        <%= vital.user_name %>
                                                                    </td>
                                                                </tr>
                                                                <% }); %>
                                                                    <% } else { %>
                                                                        <tr>
                                                                            <td colspan="7" class="text-center">No
                                                                                vitals
                                                                                recorded</td>
                                                                        </tr>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="complaints" role="tabpanel">
                                    <div class="table-responsive">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="d-flex d- justify-content-between my-2">
                                                    <h6>Patient Complaints</h6>
                                                    <button type="button" class="btn btn-primary" data-toggle="modal"
                                                        data-target="#addComplaintModal">
                                                        + <span class="d-none d-sm-inline"> Complaint</span>
                                                    </button>
                                                </div>

                                                <table class="table table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>Date</th>
                                                            <th>Complaint</th>
                                                            <th>Recorded By</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% if (complaints && complaints.length> 0) { %>
                                                            <% complaints.forEach(complaint=> { %>
                                                                <tr>
                                                                    <td>
                                                                        <%= complaint.complaint_time %>
                                                                    </td>
                                                                    <td>
                                                                        <%= complaint.complaint_desp %>
                                                                    </td>
                                                                    <td>
                                                                        <%= complaint.user_name %>
                                                                    </td>
                                                                </tr>
                                                                <% }); %>
                                                                    <% } else { %>
                                                                        <tr>
                                                                            <td colspan="3" class="text-center">No
                                                                                complaints
                                                                                recorded</td>
                                                                        </tr>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="opd-history" role="tabpanel">
                                    <div class="table-responsive">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="d-flex justify-content-between my-2">
                                                    <h6>OPD History</h6>
                                                </div>
                                                <% opdHistory.forEach(history=> { %>
                                                    <div class="card">
                                                        <div class="card-body">
                                                            <div class="row">
                                                                <div class="col-4">
                                                                    <p class="mb-1"><strong>Date:</strong>
                                                                        <%= history.prescription_date %>
                                                                    </p>
                                                                    <p class="mb-1"><strong>Doctor:</strong>
                                                                        <%= history.name %>
                                                                    </p>
                                                                </div>
                                                                <div class="col-8">
                                                                    <p class="mb-1"><strong>Diagnosis:</strong>
                                                                        <%= history.diagnosis %>
                                                                    </p>
                                                                    <p class="mb-1"><strong>Advice:</strong>
                                                                        <%= history.advice %>
                                                                    </p>
                                                                    <p class="mb-1"><strong>Test:</strong>
                                                                        <%= history.medical_test %>
                                                                    </p>
                                                                </div>
                                                            </div>
                                                            <h4>Prescription</h4>
                                                            <table class="table table-bordered">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Medicine</th>
                                                                        <th>Dosage</th>
                                                                        <th>Frequency</th>
                                                                        <th>Duration</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    <% history.medicines.forEach(medicine=> { %>
                                                                        <tr>
                                                                            <td>
                                                                                <%= medicine.name %>
                                                                            </td>
                                                                            <td>
                                                                                <%= medicine.dose_qty %>
                                                                            </td>
                                                                            <td>
                                                                                <%= medicine.doses %>
                                                                            </td>
                                                                            <td>
                                                                                <%= medicine.timing %>
                                                                            </td>
                                                                        </tr>
                                                                        <% }); %>
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                    <% }); %>
                                            </div>

                                        </div>

                                    </div>
                                </div>

                                <div class="tab-pane fade" id="prescription" role="tabpanel">
                                    <div class="card">
                                        <div class="card-body">
                                            <button class="btn btn-primary mb-3"
                                                onclick="togglePrescriptionForm()">Create Prescription</button>

                                            <!-- Prescription Form -->
                                            <div id="prescriptionForm" style="display: none;">
                                                <form id="newPrescriptionForm" class="mb-4">
                                                    <input type="hidden" name="patient_id"
                                                        value="<%= appointment.patient_id %>">
                                                    <input type="hidden" name="appointment_id"
                                                        value="<%= appointment.id %>">

                                                    <div class="medicines-container">
                                                        <div class="medicine-entry mb-3 border p-3 position-relative">

                                                            <div class="row">
                                                                <div class="col-md-3">
                                                                    <label class="form-label">Medicine</label>
                                                                    <select class="form-select medicine-select"
                                                                        id="medicine-select">
                                                                        <option value="">Select Medicine</option>
                                                                        <% medicines.forEach(function(medicine) { %>
                                                                            <option value="<%= medicine.id %>"
                                                                                data-nos="<%= medicine.default_nos %>"
                                                                                data-dose="<%= medicine.default_dose_qty %>"
                                                                                data-frequency="<%= medicine.default_frequency %>"
                                                                                data-duration="<%= medicine.default_duration %>"
                                                                                data-is-custom="<%= medicine.default_is_custom %>"
                                                                                data-custom-dose="<%= medicine.default_custom_doses %>">
                                                                                <%= medicine.name %>
                                                                            </option>
                                                                            <% }); %>
                                                                    </select>
                                                                </div>
                                                                <div class="col-md-1">
                                                                    <label class="form-label">Nos</label>
                                                                    <input type="number"
                                                                        class="form-control medicine-nos">
                                                                </div>
                                                                <div class="col-md-1">
                                                                    <label class="form-label">Custom</label>
                                                                    <div class="form-check mt-2">
                                                                        <input
                                                                            class="form-check-input custom-dose-check"
                                                                            type="checkbox"
                                                                            onchange="toggleCustomDose(this)">
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-7 standard-dose-fields">
                                                                    <div class="row">
                                                                        <div class="col-md-2">
                                                                            <label class="form-label">Dose Qty</label>
                                                                            <input type="number"
                                                                                class="form-control medicine-dose">
                                                                        </div>
                                                                        <div class="col-md-5">
                                                                            <label class="form-label">Frequency</label>
                                                                            <select
                                                                                class="form-select medicine-frequency select2"
                                                                                multiple="multiple">
                                                                                <option value="morning">Morning</option>
                                                                                <option value="afternoon">Afternoon
                                                                                </option>
                                                                                <option value="evening">Evening</option>
                                                                            </select>
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <label class="form-label">Duration</label>
                                                                            <select
                                                                                class="form-select medicine-duration">
                                                                                <option value="Before">Before</option>
                                                                                <option value="After">After</option>
                                                                                <option value="With">With</option>
                                                                                <option value="If Required">If Required
                                                                                </option>
                                                                            </select>
                                                                        </div>
                                                                        <div class="col-md-2">
                                                                            <label class="form-label">&nbsp;</label>
                                                                            <button type="button"
                                                                                class="btn btn-primary form-control"
                                                                                onclick="addToMedicineTable(this)">Add</button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-7 custom-dose-field"
                                                                    style="display: none;">
                                                                    <div class="row">
                                                                        <div class="col-md-10">
                                                                            <label class="form-label">Custom Dose
                                                                                Instructions</label>
                                                                            <input type="text"
                                                                                class="form-control custom-dose-input"
                                                                                placeholder="Enter custom dose instructions">
                                                                        </div>
                                                                        <div class="col-md-2">
                                                                            <label class="form-label">&nbsp;</label>
                                                                            <button type="button"
                                                                                class="btn btn-primary form-control"
                                                                                onclick="addToMedicineTable(this)">Add</button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Medicine Table -->
                                                    <div class="medicine-table-container mt-4">
                                                        <h5>Added Medicines</h5>
                                                        <table class="table table-bordered">
                                                            <thead>
                                                                <tr>
                                                                    <th>Medicine</th>
                                                                    <th>Nos</th>
                                                                    <th>Dose</th>
                                                                    <th>Frequency</th>
                                                                    <th>Duration</th>
                                                                    <th>Actions</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="medicineTableBody">
                                                            </tbody>
                                                        </table>
                                                    </div>

                                                    <!-- Add Remarks Section -->
                                                    <div class="form-group mt-3">
                                                        <label for="remarks" class="form-label">Remarks</label>
                                                        <textarea class="form-control" id="remarks" name="remarks"
                                                            rows="3"
                                                            placeholder="Enter any additional remarks or notes"></textarea>
                                                    </div>

                                                    <div class="mt-3">
                                                        <button type="submit" class="btn btn-secondary">Save
                                                            Prescription</button>
                                                    </div>
                                                </form>
                                            </div>

                                            <!-- Add this style section -->
                                            <style>
                                                .select2-container {
                                                    width: 100% !important;
                                                }

                                                .medicine-entry {
                                                    position: relative;
                                                }

                                                .delete-medicine {
                                                    position: absolute;
                                                    right: 10px;
                                                    top: 10px;
                                                }

                                                .edit-medicine {
                                                    cursor: pointer;
                                                    color: #007bff;
                                                    margin-right: 10px;
                                                }

                                                .delete-medicine-row {
                                                    cursor: pointer;
                                                    color: #dc3545;
                                                }

                                                textarea.form-control {
                                                    resize: vertical;
                                                    min-height: 100px;
                                                }
                                            </style>

                                            <!-- Existing Prescriptions -->
                                            <div class="existing-prescriptions">
                                                <% ipdTreatment.forEach(function(prescription) { %>
                                                    <div class="card mb-3">
                                                        <div
                                                            class="card-header d-flex justify-content-between align-items-center">
                                                            <div>
                                                                <strong>Date:</strong>
                                                                <%= prescription.treatment_time %> |
                                                                    <strong>Doctor:</strong>
                                                                    <%= prescription.doctor_name %>
                                                            </div>
                                                            <button class="btn btn-sm btn-primary"
                                                                onclick="printPrescription(<%= JSON.stringify(prescription) %>)">
                                                                <i class="fa fa-print"></i> Print
                                                            </button>
                                                        </div>
                                                        <div class="card-body">
                                                            <% if (prescription.medicines &&
                                                                prescription.medicines.length> 0) { %>
                                                                <table class="table">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Medicine</th>
                                                                            <th>Nos</th>
                                                                            <th>Dose</th>
                                                                            <th>Frequency</th>
                                                                            <th>Duration</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        <% prescription.medicines.forEach(function(medicine)
                                                                            { %>
                                                                            <tr>
                                                                                <td>
                                                                                    <%= medicine.medicine_name %>
                                                                                </td>
                                                                                <td>
                                                                                    <%= medicine.nos %>
                                                                                </td>
                                                                                <% if (medicine.is_custom) { %>
                                                                                    <td colspan="3">
                                                                                        <%= medicine.custom_doses %>
                                                                                    </td>
                                                                                    <% } else { %>
                                                                                        <td>
                                                                                            <%= medicine.dose_qty %>
                                                                                        </td>
                                                                                        <td>
                                                                                            <%= medicine.doses %>
                                                                                        </td>
                                                                                        <td>
                                                                                            <%= medicine.timing %>
                                                                                        </td>
                                                                                        <% } %>
                                                                            </tr>
                                                                            <% }); %>
                                                                    </tbody>
                                                                </table>
