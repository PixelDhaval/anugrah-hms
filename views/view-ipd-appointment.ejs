    <script>
        function printBill(appointmentId) {
            // Fetch bill data from the new endpoint
            fetch(`/view-ipd-appointment/${appointmentId}/bill`, {
                method: "GET",
                headers: {
                    "Content-Type": "application/json"
                }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Network response was not ok " + response.statusText);
                    }
                    return response.json();
                })
                .then(response => {
                    if (!response.success) {
                        throw new Error("Failed to fetch bill data");
                    }

                    const data = response.data;
                    // Data destructuring for easier access
                    const patient_name = data.appointment.patient_name;
                    const appointment_date = data.appointment.appointment_date;
                    const particulars = data.particulars;
                    const patient_id = data.appointment.patient_id;
                    const room_type = data.appointment.room_type;
                    const room_number = data.appointment.room_number;
                    const bed_number = data.appointment.bed_number;
                    const doctor_name = data.appointment.doctor_name;

                    const totalAmount = particulars.reduce((sum, item) => sum + (parseFloat(item.rate) * parseInt(item.qty)), 0);

                    // Function to convert number to words
                    const numberToWords = (num) => {
                        const a = [
                            '', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',
                            'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'
                        ];
                        const b = [
                            '', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'
                        ];
                        const c = [
                            '', '', 'Hundred', 'Thousand', 'Thousand'
                        ];
                        let n = num.toString();
                        let n1 = n.split('.');

                        let numString = '';
                        let x = 0;
                        while (x < n1[0].length) {
                            let y = n1[0].substr(x, 1);
                            if (y !== '0') {
                                numString += a[parseInt(y)] + ' ' + c[n1[0].length - x - 1] + ' ';
                            }
                            x++;
                        }

                        if (n1.length > 1) {
                            numString += 'Point ';
                            for (let i = 0; i < n1[1].length; i++) {
                                numString += a[parseInt(n1[1].charAt(i))] + ' ';
                            }
                        }

                        return numString.trim();
                    }

                    const totalAmountInWords = numberToWords(parseInt(totalAmount));

                    // Create a new window for printing
                    const printWindow = window.open('', '_blank');

                    // Format the bill content
                    printWindow.document.write(`
            <html>
