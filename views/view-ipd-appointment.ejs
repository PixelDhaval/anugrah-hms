                                                        </div>
                                                        <div class="card-footer">
                                                            <p><strong>Remarks:</strong>
                                                                <%= prescription.remarks %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <% }); %>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="notes" role="tabpanel">
                                    <div class="card">
                                        <div class="card-body">
                                            <!-- Create Note Form -->
                                            <form id="createNoteForm" class="mb-4">
                                                <input type="hidden" name="appointment_id"
                                                    value="<%= appointment.id %>">
                                                <div class="form-group">
                                                    <label for="note" class="form-label">Add Treatment</label>
                                                    <textarea class="form-control" id="note" name="note" rows="3"
                                                        required></textarea>
                                                </div>
                                                <div class="mt-3">
                                                    <button type="submit" class="btn btn-primary">Save
                                                        Treatment</button>
                                                </div>
                                            </form>

                                            <!-- Edit Note Form (Hidden by default) -->
                                            <form id="editNoteForm" class="mb-4" style="display: none;">
                                                <input type="hidden" id="editNoteId">
                                                <div class="form-group">
                                                    <label for="editNote" class="form-label">Edit Treatment</label>
                                                    <textarea class="form-control" id="editNote" name="editNote"
                                                        rows="3" required></textarea>
                                                </div>
                                                <div class="mt-3">
                                                    <button type="submit" class="btn btn-primary">Update
                                                        Treatment</button>
                                                    <button type="button" class="btn btn-secondary"
                                                        onclick="cancelEdit()">Cancel</button>
                                                </div>
                                            </form>

                                            <!-- Notes Table -->
                                            <div class="notes-table mt-4">
                                                <h5>Treatment History</h5>
                                                <table class="table table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>Treatment By</th>
                                                            <th>Treatment</th>
                                                            <th>Created At</th>
                                                            <th>Updated At</th>
                                                            <th>Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="notesTableBody">
                                                        <% if (notes && notes.length> 0) { %>
                                                            <% notes.forEach(function(note) { %>
                                                                <tr data-note-id="<%= note.id %>">
                                                                    <td>
                                                                        <%= note.user_name %>
                                                                    </td>
                                                                    <td class="note-text"
                                                                        style="white-space: pre-line;">
                                                                        <%= note.note %>
                                                                    </td>
                                                                    <td>
                                                                        <%= note.created_at %>
                                                                    </td>
                                                                    <td>
                                                                        <%= note.updated_at || '-' %>
                                                                    </td>
                                                                    <td>
                                                                        <button class="btn btn-sm btn-primary edit-note"
                                                                            onclick="editNote(this)">
                                                                            <i class="fa fa-edit"></i>
                                                                        </button>
                                                                        <button
                                                                            class="btn btn-sm btn-danger delete-note"
                                                                            onclick="deleteNote(this)">
                                                                            <i class="fa fa-trash"></i>
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                                <% }); %>
                                                                    <% } else { %>
                                                                        <tr>
                                                                            <td colspan="5" class="text-center">No
                                                                                Treatments
                                                                                available</td>
                                                                        </tr>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>

                                            <script>
                                                // Handle create note form submission

                                                document.getElementById('createNoteForm').addEventListener('submit', async function (e) {
                                                    e.preventDefault();

                                                    try {
                                                        const response = await fetch('/ipd-appointment-notes', {
                                                            method: 'POST',
                                                            headers: {
                                                                'Content-Type': 'application/json'
                                                            },
                                                            body: JSON.stringify({
                                                                appointment_id: document.querySelector('input[name="appointment_id"]').value,
                                                                note: document.getElementById('note').value
                                                            })
                                                        });

                                                        if (response.ok) {
                                                            location.reload();
                                                        } else {
                                                            alert('Error saving note');
                                                        }
                                                    } catch (error) {
                                                        console.error('Error:', error);
                                                        alert('Error saving note');
                                                    }
                                                });

                                                // Handle edit note form submission
                                                document.getElementById('editNoteForm').addEventListener('submit', async function (e) {
                                                    e.preventDefault();
                                                    const noteId = document.getElementById('editNoteId').value;
                                                    const newNote = document.getElementById('editNote').value;

                                                    try {
                                                        const response = await fetch(`/ipd-appointment-notes/${noteId}`, {
                                                            method: 'PUT',
                                                            headers: {
                                                                'Content-Type': 'application/json'
                                                            },
                                                            body: JSON.stringify({ note: newNote })
                                                        });

                                                        if (response.ok) {
                                                            location.reload();
                                                        } else {
                                                            alert('Error updating note');
                                                        }
                                                    } catch (error) {
                                                        console.error('Error:', error);
                                                        alert('Error updating note');
                                                    }
                                                });

                                                function editNote(button) {
                                                    const row = button.closest('tr');
                                                    const noteId = row.dataset.noteId;
                                                    const noteText = row.querySelector('.note-text').textContent;

                                                    // Hide create form and show edit form
                                                    document.getElementById('createNoteForm').style.display = 'none';
                                                    document.getElementById('editNoteForm').style.display = 'block';

                                                    // Set form values
                                                    document.getElementById('editNoteId').value = noteId;
                                                    document.getElementById('editNote').value = noteText;

                                                    // Scroll to edit form
                                                    document.getElementById('editNoteForm').scrollIntoView({ behavior: 'smooth' });

                                                }

                                                function cancelEdit() {
                                                    // Hide edit form and show create form
                                                    document.getElementById('editNoteForm').style.display = 'none';
                                                    document.getElementById('createNoteForm').style.display = 'block';

                                                    // Clear edit form
                                                    document.getElementById('editNoteId').value = '';
                                                    document.getElementById('editNote').value = '';
                                                }

                                                function deleteNote(button) {
                                                    if (confirm('Are you sure you want to delete this note?')) {
                                                        const row = button.closest('tr');
                                                        const noteId = row.dataset.noteId;

                                                        fetch(`/ipd-appointment-notes/${noteId}`, {
                                                            method: 'DELETE'
                                                        })
                                                            .then(response => {
                                                                if (response.ok) {
                                                                    location.reload();
                                                                } else {
                                                                    alert('Error deleting note');
                                                                }
                                                            })
                                                            .catch(error => {
                                                                console.error('Error:', error);
                                                                alert('Error deleting note');
                                                            });
                                                    }
                                                }
                                            </script>
                                        </div>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="tests" role="tabpanel">
                                    <div class="card">
                                        <div class="card-body">
                                            <!-- Create Test Form -->
                                            <form id="createTestForm" class="mb-4">
                                                <input type="hidden" name="appointment_id"
                                                    value="<%= appointment.id %>">
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label for="test" class="form-label">Select Test</label>
                                                            <select class="form-control select2" id="test" name="test"
                                                                required>
                                                                <option value="">Select Test</option>
                                                                <% tests.forEach(function(test) { %>
                                                                    <option value="<%= test.tests_id %>">
                                                                        <%= test.tests %>
                                                                    </option>
                                                                    <% }); %>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label for="testNote" class="form-label">Note</label>
                                                            <textarea class="form-control" id="testNote" name="note"
                                                                rows="1"></textarea>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="mt-3">
                                                    <button type="submit" class="btn btn-primary">Add Test</button>
                                                </div>
                                            </form>

                                            <!-- Tests Table -->
                                            <div class="tests-table mt-4">
                                                <h5>Tests History</h5>
                                                <table class="table table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>Test Name</th>
                                                            <th>Note</th>
                                                            <th>Report</th>
                                                            <th>Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="testsTableBody">
                                                        <% if (appointmentTests && appointmentTests.length> 0) { %>
                                                            <% appointmentTests.forEach(function(test) { %>
                                                                <tr data-test-id="<%= test.id %>">
                                                                    <td>
                                                                        <%= test.test_name %>
                                                                    </td>
                                                                    <td>
                                                                        <%= test.note %>
                                                                    </td>
                                                                    <td>
                                                                        <% if (test.file_path) { %>
                                                                            <a class="btn btn-sm btn-info view-report"
                                                                                href="/test-reports/<%= test.file_path %>"
                                                                                download="<%= test.test_name %>_report.pdf">
                                                                                View Report
                                                                            </a>
                                                                            <script>
                                                                                function downloadReport(url, testName) {
                                                                                    fetch(url)
                                                                                        .then(response => response.blob())
                                                                                        .then(blob => {
                                                                                            const link = document.createElement('a');
                                                                                            link.href = window.URL.createObjectURL(blob);
                                                                                            link.download = `${testName}_report.pdf`;
                                                                                            link.click();
                                                                                            window.URL.revokeObjectURL(link.href);
                                                                                        })
                                                                                        .catch(error => {
                                                                                            console.error('Error downloading report:', error);
                                                                                            alert('Error downloading report');
                                                                                        });
                                                                                }
                                                                            </script>
                                                                            <% } else { %>
                                                                                <form class="upload-report-form">
                                                                                    <input type="file" accept=".pdf"
                                                                                        required
                                                                                        class="form-control-file mb-2">
                                                                                    <button type="submit"
                                                                                        class="btn btn-sm btn-primary">Upload</button>
                                                                                </form>
                                                                                <% } %>
                                                                    </td>
                                                                    <td>
                                                                        <button
                                                                            class="btn btn-sm btn-danger delete-test">
                                                                            <i class="fa fa-trash"></i>
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                                <% }); %>
                                                                    <% } else { %>
                                                                        <tr>
                                                                            <td colspan="4" class="text-center">No tests
                                                                                added</td>
                                                                        </tr>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>

                                    <script>
                                        // Initialize select2 for test selection
                                        document.addEventListener('DOMContentLoaded', function () {
                                            // Initialize select2
                                            if ($.fn.select2) {
                                                $('#test').select2({
                                                    placeholder: 'Select Test',
                                                    width: '100%'
                                                });
                                            }

                                            // Handle test form submission
                                            document.getElementById('createTestForm').addEventListener('submit', async function (e) {
                                                e.preventDefault();

                                                const formData = {
                                                    appointment_id: document.querySelector('input[name="appointment_id"]').value,
                                                    test_id: document.getElementById('test').value,
                                                    note: document.getElementById('testNote').value
                                                };

                                                console.log('Submitting test data:', formData);

                                                try {
                                                    const response = await fetch('/ipd-appointment-tests', {
                                                        method: 'POST',
                                                        headers: {
                                                            'Content-Type': 'application/json'
                                                        },
                                                        body: JSON.stringify(formData)
                                                    });

                                                    console.log('Response:', response);

                                                    if (response.ok) {
                                                        const result = await response.json();
                                                        console.log('Result:', result);
                                                        location.reload();
                                                    } else {
                                                        const error = await response.text();
                                                        console.error('Error response:', error);
                                                        alert('Error adding test: ' + error);
                                                    }
                                                } catch (error) {
                                                    console.error('Error:', error);
                                                    alert('Error adding test: ' + error.message);
                                                }
                                            });

                                            // Handle upload form submission
                                            document.querySelectorAll('.upload-report-form').forEach(form => {
                                                form.addEventListener('submit', async function (e) {
                                                    e.preventDefault();
                                                    const testId = this.closest('tr').dataset.testId;
                                                    const fileInput = this.querySelector('input[type="file"]');
                                                    const file = fileInput.files[0];

                                                    if (!file) {
                                                        alert('Please select a file');
                                                        return;
                                                    }

                                                    const formData = new FormData();
                                                    formData.append('report', file);
                                                    formData.append('test_id', testId);

                                                    try {
                                                        const response = await fetch('/ipd-appointment-tests/upload-report', {
                                                            method: 'POST',
                                                            body: formData
                                                        });

                                                        if (response.ok) {
                                                            location.reload();
                                                        } else {
                                                            const error = await response.text();
                                                            console.error('Error response:', error);
                                                            alert('Error uploading report: ' + error);
                                                        }
                                                    } catch (error) {
                                                        console.error('Error:', error);
                                                        alert('Error uploading report: ' + error.message);
                                                    }
                                                });
                                            });

                                            // Handle delete button click
                                            document.querySelectorAll('.delete-test').forEach(button => {
                                                button.addEventListener('click', function () {
                                                    const testId = this.closest('tr').dataset.testId;
                                                    if (confirm('Are you sure you want to delete this test?')) {
                                                        fetch(`/ipd-appointment-tests/${testId}`, {
                                                            method: 'DELETE'
                                                        })
                                                            .then(response => {
                                                                if (response.ok) {
                                                                    location.reload();
                                                                } else {
                                                                    alert('Error deleting test');
                                                                }
                                                            })
                                                            .catch(error => {
                                                                console.error('Error:', error);
                                                                alert('Error deleting test');
                                                            });
                                                    }
                                                });
                                            });
                                        });
                                    </script>
                                </div>
                                <div class="tab-pane fade" id="billings" role="tabpanel">
                                    <div class="card">
                                        <div class="card-body">
                                            <!-- Billing Form -->
                                            <form id="billingForm" class="mb-4">
