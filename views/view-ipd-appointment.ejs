                            const resultText = row.find('.investigation-result');
                            const editBtn = row.find('.edit-btn');
                            const saveBtn = row.find('.save-btn');

                            // Update text and switch back to display mode
                            resultText.text(newResults).show();
                            resultInput.hide();
                            editBtn.show();
                            saveBtn.hide();
                        } else {
                            alert('Error updating investigation');
                        }
                    },
                    error: function(error) {
                        console.error('Error:', error);
                        alert('Error updating investigation');
                    }
                });
            });

            // Handle delete button click
            $('#investigationsTableBody').on('click', '.delete-btn', function() {
                if (confirm('Are you sure you want to delete this investigation?')) {
                    const row = $(this).closest('tr');
                    const investigationId = row.data('id');

                    $.ajax({
                        url: `/ipd-appointment-investigation/${investigationId}`,
                        type: 'DELETE',
                        success: function(response) {
                            if (response.success) {
                                row.remove();
                            } else {
                                alert('Error deleting investigation');
                            }
                        },
                        error: function(error) {
                            console.error('Error:', error);
                            alert('Error deleting investigation');
                        }
                    });
                }
            });
        });
    </script>
</body>

</html>