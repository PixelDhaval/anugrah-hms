    <script>
        $(document).ready(function () {
            // Initialize select2 for investigation
            $('.select2-investigation').select2({
                tags: true,
                createTag: function (params) {
                    return {
                        id: 'new:' + params.term,
                        text: params.term,
                        newOption: true
                    };
                },
                templateResult: function (data) {
                    var $result = $("<span></span>");
                    $result.text(data.text);
                    if (data.newOption) {
                        $result.append(" <em>(Add New)</em>");
                    }
                    return $result;
                }
            });

            // Modify the investigation form submission
            $('#investigationForm').on('submit', function (e) {
                e.preventDefault();
                const formData = $(this).serializeArray();
                const investigationId = formData.find(f => f.name === 'investigation_id').value;

                if (investigationId.startsWith('new:')) {
                    // Create new investigation first
                    const newInvestigationName = investigationId.replace('new:', '');
                    $.ajax({
                        url: '/create-investigation',
                        type: 'POST',
                        data: { investigation_name: newInvestigationName },
                        success: function (response) {
                            console.log(response);
                            if (response.success) {
                                // Update form data with new investigation ID
                                formData.find(f => f.name === 'investigation_id').value = response.id;
                                submitInvestigation(formData);
                            }
                        },
                        error: function (error) {
                            console.error('Error:', error);
                            alert('Error creating new investigation');
                        }
                    });
                } else {
                    submitInvestigation(formData);
                }
            });

            function submitInvestigation(formData) {

                console.log(formData)
                $.ajax({
                    url: '/ipd-appointment-investigation',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            alert('Investigation added successfully');
                            location.reload();
                        }
                    },
                    error: function (error) {
                        console.error('Error:', error);
                        alert('Error adding investigation');
                    }
                });
            }
        });
    </script>

    <script>
        function printLatestPrescription() {
            // Get all prescriptions from ipdTreatment
            const prescriptions = JSON.parse('<%- JSON.stringify(ipdTreatment) %>');

            // If no prescriptions available
            if (!prescriptions || prescriptions.length === 0) {
                alert('No prescriptions available');
                return;
            }

            // Get the most recent prescription (first one in the array since they're ordered by date DESC)
            const latestPrescription = prescriptions[0];

            // Call the existing printPrescription function with the latest prescription
            printPrescription(latestPrescription);
        }
