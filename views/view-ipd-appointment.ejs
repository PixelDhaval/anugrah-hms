                            // Handle particular selection to auto-fill rate
                            $('#particular').on('change', function () {
                                const rate = $(this).find(':selected').data('rate');
                                $('#rate').val(rate || '');
                            });

                            // Handle edit particular selection
                            $('#edit_particular').on('change', function () {
                                const rate = $(this).find(':selected').data('rate');
                                $('#edit_rate').val(rate || '');
                            });

                            // Handle Add Billing Form Submit
                            $('#billingForm').on('submit', function (e) {
                                e.preventDefault();
                                const formData = $(this).serialize();

                                $.ajax({
                                    url: '/ipd-appointment-particulars',
                                    type: 'POST',
                                    data: formData,
                                    success: function (response) {
                                        location.reload();
                                    },
                                    error: function (error) {
