                        </tr>
                    </thead>
                    <tbody>
                        ${creditTransactions.map(t => `
                            <tr>
                                <td>${t.ipd_transaction_date}</td>
                                <td>${t.payment_method.toUpperCase()}</td>
                                <td class="amount">${parseFloat(t.amount).toFixed(2)}</td>
                            </tr>
                        `).join('')}
                        <tr class="total-row">
