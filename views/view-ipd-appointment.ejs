                                                                            <%= transaction.ipd_transaction_date %>
                                                                        </td>
                                                                        <td>
                                                                            <%= transaction.amount %>
                                                                        </td>
                                                                        <td>
                                                                            <%= transaction.transaction_type %>
                                                                        </td>
                                                                        <td>
                                                                            <%= transaction.payment_method %>
                                                                        </td>
                                                                        <td>
                                                                            <%= transaction.user_name %>
                                                                        </td>
                                                                        <td>
                                                                            <button
                                                                                class="btn btn-sm btn-primary edit-transaction">Edit</button>
                                                                            <button
                                                                                class="btn btn-sm btn-danger delete-transaction">Delete</button>
                                                                            <button class="btn btn-sm btn-info" onclick="printReceipt(
                                                                                '<%= transaction.id %>', 
                                                                                '<%= appointment.patient_name %>', 
                                                                                '<%= appointment.patient_id %>', 
                                                                                '<%= transaction.amount %>', 
                                                                                '<%= transaction.payment_method %>', 
                                                                                '<%= transaction.ipd_transaction_date %>'
                                                                            )">
                                                                                <i class="fa fa-print"></i> Receipt
                                                                            </button>
                                                                        </td>
                                                                    </tr>
                                                                    <% }); %>
                                                            </tbody>
                                                            <tfoot>
                                                                <tr>
                                                                    <th colspan="4" class="text-right">Total Credit:
                                                                    </th>
                                                                    <th colspan="2" class="text-success">
                                                                        <%= transactions.reduce((sum, t)=>
                                                                            t.transaction_type === 'credit' ? sum +
                                                                            parseFloat(t.amount) : sum, 0).toFixed(2) %>
                                                                    </th>
                                                                </tr>
                                                                <tr>
                                                                    <th colspan="4" class="text-right">Total Debit:</th>
                                                                    <th colspan="2" class="text-danger">
                                                                        <%= transactions.reduce((sum, t)=>
                                                                            t.transaction_type === 'debit' ? sum +
                                                                            parseFloat(t.amount) : sum, 0).toFixed(2) %>
                                                                    </th>
                                                                </tr>
                                                                <tr>
                                                                    <th colspan="4" class="text-right">Net Amount:</th>
                                                                    <th colspan="2"
                                                                        class="<%= transactions.reduce((sum, t) => t.transaction_type === 'credit' ? sum + parseFloat(t.amount) : sum - parseFloat(t.amount), 0) >= 0 ? 'text-success' : 'text-danger' %>">
                                                                        <%= transactions.reduce((sum, t)=>
                                                                            t.transaction_type === 'credit' ? sum +
                                                                            parseFloat(t.amount) : sum -
                                                                            parseFloat(t.amount), 0).toFixed(2) %>
                                                                    </th>
                                                                </tr>
                                                            </tfoot>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
