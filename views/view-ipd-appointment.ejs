                        h1 { 
                            margin: 0; 
                            font-size: 24px; 
                            color: #333; 
                            padding: 15px;
                            text-align: center;
                        }

                        .address { 
                            font-size: 14px; 
                            margin-bottom: 15px; 
                            color: #666; 
                            text-align: center;
                            padding-bottom: 10px;
                            line-height: 1.5;
                        }

                        h2 { 
                            font-size: 20px;
                            text-align: center;
                            padding: 15px 0;
                            margin: 0;
                            border-top: 2px solid #000;
                            border-bottom: 1px solid #000;
                        }

                        .bill-details {
                            text-align: left;
                            margin: 20px 0;
                            font-size: 14px;
                            display: flex;
                            flex-wrap: wrap;
                            gap: 15px;
                            padding: 0 20px;
                        }

                        .bill-details > div {
                            flex: 1 1 45%;
                            line-height: 1.6;
                        }

                        .bill-table {
                            width: calc(100% - 40px);
                            margin: 20px;
                            border-collapse: collapse;
                            font-size: 14px;
                            table-layout: fixed;
                            border: 1px solid #000;
                        }

                        .bill-table th, .bill-table td {
                            border: 1px solid #000;
                            padding: 10px;
                            text-align: left;
                        }

                        .bill-table th {
                            background-color: #f2f2f2;
                            font-weight: bold;
                        }

                        .total {
                            text-align: right;
