                                            <div class="card mb-3">
                                                <div class="card-body">
                                                    <h5 class="card-title">Add Transaction</h5>
                                                    <form id="transactionForm">
                                                        <input type="hidden" name="appointment_id"
                                                            value="<%= appointment.id %>">
                                                        <div class="row">
                                                            <div class="col-md-3">
                                                                <div class="form-group">
