    <script>
        function printAllTransactions() {
            // Get all transactions
            const transactions = JSON.parse('<%- JSON.stringify(transactions) %>');

            // Filter to get only credit transactions
            const creditTransactions = transactions.filter(t => t.transaction_type === 'credit');

            // Calculate total credit amount
            const totalCredit = creditTransactions.reduce((sum, t) => sum + parseFloat(t.amount), 0);

            const debitTransactions = transactions.filter(t => t.transaction_type === 'debit');

            // Calculate total credit amount
            const totalDebit = debitTransactions.reduce((sum, t) => sum + parseFloat(t.amount), 0);

            const totalAmount = totalCredit - totalDebit;

            const printContent = `
