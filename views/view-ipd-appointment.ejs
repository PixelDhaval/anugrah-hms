                                $.ajax({
                                    url: '/ipd-appointment-discharge',
                                    type: 'POST',
                                    data: formData,
                                    success: function (response) {
                                        if (response.success) {
                                            alert('Patient discharged successfully');
                                            // Redirect to IPD appointments list
