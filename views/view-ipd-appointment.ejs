                        <div class="footer">
                            <p>Dr. Johnson Samuel</p>
                            <p>Reg no: G-31061</p>
                        </div>
                    </div>
                </body>
            </html>
            `);

                    // Print the bill
                    printWindow.document.close();
                    printWindow.print();
                    printWindow.close();
                })
                .catch(error => {
                    console.error("There was a problem with the fetch operation:", error);
                });
        }
    </script>

