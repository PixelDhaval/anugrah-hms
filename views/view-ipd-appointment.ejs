                                <script>
                                    $(document).ready(function () {
                                        // Generic modal close handler
                                        $('.modal .close, .modal .btn-secondary').on('click', function () {
                                            $(this).closest('.modal').modal('hide');
                                        });

                                        // Reset form when modal is closed
                                        $('.modal').on('hidden.bs.modal', function () {
                                            $(this).find('form').trigger('reset');
                                        });

                                        // Add Transaction
                                        $('#transactionForm').on('submit', function (e) {
                                            e.preventDefault();
                                            $.ajax({
                                                url: '/ipd-appointment-transaction',
                                                type: 'POST',
                                                data: $(this).serialize(),
                                                success: function (response) {
                                                    location.reload();
                                                },
                                                error: function (error) {
                                                    alert('Error adding transaction');
                                                }
                                            });
                                        });

                                        // Edit Transaction
                                        $('.edit-transaction').on('click', function () {
                                            const row = $(this).closest('tr');
                                            const id = row.data('id');
                                            const amount = row.data('amount');
                                            const type = row.data('transaction-type');
                                            const method = row.data('payment-method');
                                            const date = row.data('transaction-date');
                                            console.log(date);
                                            $('#editTransactionForm [name=transaction_id]').val(id);
                                            $('#editTransactionForm [name=amount]').val(amount);
                                            $('#editTransactionForm [name=transaction_type]').val(type);
                                            $('#editTransactionForm [name=payment_method]').val(method);
                                            $('#editTransactionForm [name=transaction_date]').val(date);

                                            $('#editTransactionModal').modal('show');
                                        });

                                        // Update Transaction
                                        $('#editTransactionForm').on('submit', function (e) {
                                            e.preventDefault();
                                            const id = $(this).find('[name=transaction_id]').val();
                                            $.ajax({
                                                url: `/ipd-appointment-transaction/${id}`,
                                                type: 'PUT',
                                                data: $(this).serialize(),
                                                success: function (response) {
                                                    $('#editTransactionModal').modal('hide');
                                                    location.reload();
                                                },
                                                error: function (error) {
                                                    alert('Error updating transaction');
                                                }
                                            });
                                        });

                                        // Delete Transaction
                                        $('.delete-transaction').on('click', function () {
                                            if (confirm('Are you sure you want to delete this transaction?')) {
                                                const id = $(this).closest('tr').data('id');
                                                $.ajax({
                                                    url: `/ipd-appointment-transaction/${id}`,
                                                    type: 'DELETE',
                                                    success: function (response) {
                                                        location.reload();
                                                    },
                                                    error: function (error) {
                                                        alert('Error deleting transaction');
                                                    }
                                                });
                                            }
                                        });

                                        // Edit Particular
                                        $('.edit-particular').on('click', function () {
                                            const row = $(this).closest('tr');
                                            const id = row.data('id');
                                            const serviceId = row.data('service-id');
                                            const qty = row.data('qty');
                                            const rate = row.data('rate');
                                            const remark = row.data('remark');

                                            $('#edit_particular_id').val(id);
                                            $('#edit_particular').val(serviceId);
                                            $('#edit_qty').val(qty);
                                            $('#edit_rate').val(rate);
                                            $('#edit_remark').val(remark);

                                            $('#editParticularModal').modal('show');
                                        });

                                        // Update Particular
                                        $('#editParticularForm').on('submit', function (e) {
                                            e.preventDefault();
                                            const id = $('#edit_particular_id').val();
                                            const formData = $(this).serialize();

                                            $.ajax({
                                                url: `/ipd-appointment-particulars/${id}`,
                                                type: 'PUT',
                                                data: formData,
                                                success: function (response) {
                                                    $('#editParticularModal').modal('hide');
                                                    location.reload();
                                                },
                                                error: function (error) {
                                                    alert('Error updating particular');
                                                }
                                            });
                                        });

                                        // Delete Particular
                                        $('.delete-particular').on('click', function () {
                                            if (confirm('Are you sure you want to delete this particular?')) {
                                                const id = $(this).data('id');
                                                $.ajax({
                                                    url: `/ipd-appointment-particulars/${id}`,
                                                    type: 'DELETE',
                                                    success: function (response) {
                                                        location.reload();
                                                    },
                                                    error: function (error) {
                                                        alert('Error deleting particular');
                                                    }
                                                });
                                            }
                                        });
                                    });
                                </script>
