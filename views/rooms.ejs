<!doctype html>
<html lang="en">

<head>
    <title>AHMS :: Appointments</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Iconic Bootstrap 4.5.0 Admin Template">
    <meta name="author" content="WrapTheme, design by: ThemeMakker.com">
    <link rel="icon" href="favicon.ico" type="image/x-icon">

    <!-- VENDOR CSS -->
    <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css">

    <!-- MAIN Project CSS file -->
    <link rel="stylesheet" href="../dist/assets/css/main.css">
    <link rel="stylesheet" href="../dist/assets/css/tabulator_bootstrap5.css">
    <style>
        .tabulator {
            font-size: 12px;
            text-align: center;
        }
    </style>
</head>

<body data-theme="light" class="font-nunito">
    <div id="wrapper" class="theme-cyan">

        <%- include('navbar') %>


        <!--main page content body part-->
        <div id="main-content">
            <div class="container-fluid">
                <div class="block-header">
                    <div class="row">
                        <div class="col-lg-12 d-flex justify-content-between">
                            <h2>Rooms</h2>
                            <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#createRoomModal">Create Room</button>
                        </div>
                        

                    </div>
                </div>
                <div class="row clearfix">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="body">
                                <table class="table table-bordered table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Room no</th>
                                            <th>Room Type</th>
                                            <th>Floor</th>
                                            <th>Rate</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <% rooms.forEach(room => { %>
                                            <tr>
                                                <td><%= room.room_no %></td>
                                                <td><%= room.room_type %></td>
                                                <td><%= room.floor_no %></td>
                                                <td><%= room.rate %></td>
                                                <td>
                                                        <button type="button" class="btn btn-primary edit-button" data-toggle="modal" data-target="#editRoomModal" data-id="<%= room.id %>" data-room-no="<%= room.room_no %>" data-room-type="<%= room.room_type_id %>" data-floor-no="<%= room.floor_id %>" data-rate="<%= room.rate %>">Edit</button>
                                                        <a href="/rooms/<%= room.id %>/delete" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this room type?')">Delete</a>


                                                    </td>
                                                </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                

            </div>
        </div>
        <!-- Edit Appointment Modal -->
        <div class="modal fade" id="createRoomModal" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">

                        <h5 class="modal-title">Create Room</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>

                        </button>
                    </div>
                    <div class="modal-body">
                        <form id="createRoomForm" method="POST" action="/rooms">
                            <div class="form-group">
                                <label for="room_no">Room no:</label>
                                <input type="text" class="form-control" id="room_no" name="room_no" required>
                            </div>
                            <div class="form-group">
                                <label for="room_type">Room Type:</label>   
                                <select class="form-control" id="room_type" name="room_type_id" required>
                                    <% roomTypes.forEach(roomType => { %>
                                        <option value="<%= roomType.id %>"><%= roomType.room_type %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="floor_no">Floor:</label>
                                <select class="form-control" id="floor_no" name="floor_id" required>
                                    <% floors.forEach(floor => { %>
                                        <option value="<%= floor.id %>"><%= floor.floor_no %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="rate">Rate:</label>
                                <input type="number" class="form-control" id="rate" name="rate" required>
                            </div>
                            <button type="submit" class="btn btn-secondary">Create</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    
        <!-- Edit Floor Modal -->
        <div class="modal fade" id="editRoomModal" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">

                        <h5 class="modal-title">Edit Room</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>

                        </button>
                    </div>
                    <div class="modal-body">
                        <form id="editRoomForm" method="POST">
                            <input type="hidden" id="roomId" name="id">
                            <div class="form-group">
                                <label for="editRoom_no">Room no:</label>   
                                <input type="text" class="form-control" id="editRoom_no" name="room_no" required>
                            </div>
                            <div class="form-group">
                                <label for="editRoom_type">Room Type:</label>
                                <select class="form-control" id="editRoom_type" name="room_type_id" required>
                                    <% roomTypes.forEach(roomType => { %>
                                        <option value="<%= roomType.id %>"><%= roomType.room_type %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="editFloor_no">Floor:</label>
                                <select class="form-control" id="editFloor_no" name="floor_id" required>
                                    <% floors.forEach(floor => { %> 
                                        <option value="<%= floor.id %>"><%= floor.floor_no %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="editRate">Rate:</label>
                                <input type="number" class="form-control" id="editRate" name="rate" required>
                            </div>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </form>
                    </div>

                </div>
            </div>
        </div>

    </div>
    <!-- Javascript -->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>

    <!-- page vendor js file -->
    <script src="../dist/assets/bundles/apexcharts.bundle.js"></script>

    <!-- page js file -->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../../js/hospital/index.js"></script>
    <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>
    <script src="../dist/assets/js/tabulator.min.js"></script>
    <script>
    $(document).ready(function() {
        $('.edit-button').on('click', function() {
            const roomId = $(this).data('id');
            const roomNo = $(this).data('room-no');
            const roomType = $(this).data('room-type');
            const floorNo = $(this).data('floor-no');
            const rate = $(this).data('rate');


            $('#roomId').val(roomId);
            $('#editRoom_no').val(roomNo);
            $('#editRoom_type').val(roomType);
            $('#editFloor_no').val(floorNo);
            $('#editRate').val(rate);

        });

        $('#editRoomForm').submit(function(event) {
            event.preventDefault(); // Prevent default form submission
            const formData = $(this).serialize();
            const url = `/rooms/${$('#roomId').val()}`; // Construct the URL for PUT request
            $.ajax({

                type: 'POST',
                url: url,
                data: formData,
                success: function(response) {
                    // Handle successful update (e.g., close modal, refresh table)
                    $('#editRoomModal').modal('hide');
                    location.reload(); // Refresh the page to reflect changes
                },

                error: function(error) {
                    // Handle errors (e.g., display error message)
                    console.error('Error updating room:', error);
                    alert('Error updating room. Please try again.');
                }
            });
        });

    });
    </script>

    <!-- Create Floor Modal -->
    

    </body>

</html>