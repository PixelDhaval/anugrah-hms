<!doctype html>
<html lang="en">

<head>
    <title>AHMS :: Appointments</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Iconic Bootstrap 4.5.0 Admin Template">
    <meta name="author" content="WrapTheme, design by: ThemeMakker.com">
    <link rel="icon" href="favicon.ico" type="image/x-icon">

    <!-- VENDOR CSS -->
    <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css">

    <!-- MAIN Project CSS file -->
    <link rel="stylesheet" href="../dist/assets/css/main.css">
    <link rel="stylesheet" href="../dist/assets/css/tabulator_bootstrap5.css">
    <style>
        .tabulator {
            font-size: 12px;
            text-align: center;
        }
    </style>
</head>

<body data-theme="light" class="font-nunito">
    <div id="wrapper" class="theme-cyan">

        <%- include('navbar') %>


        <!--main page content body part-->
        <div id="main-content">
            <div class="container-fluid">
                <div class="block-header">
                    <div class="row">
                        <div class="col-lg-12 d-flex justify-content-between">
                            <h2>IPD Appointments</h2>   
                            <a href="/create-ipd-appointment" class="btn btn-primary">Create IPD Appointment</a>
                        </div>
                    </div>
                </div>

                <div class="row clearfix">
                    <div class="col-md-12">
                        <table id="ipd-appointments-table">
                            <thead>
                                <tr>
                                    <th>Patient ID</th>
                                    <th>Patient Name</th>
                                    <th>Appointment Date</th>
                                    <th>Bed Number</th>
                                    <th>Assigned Doctor</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% ipd_appointments.forEach(appointment=> { %>
                                    <tr>
                                        <td><%= appointment.patient_id %></td>
                                        <td><%= appointment.patient_name %></td>
                                        <td><%= appointment.appointment_date %></td>
                                        <td>B<%= appointment.bed_number %> - R<%= appointment.room_number %> (<%= appointment.room_type %>)</td>
                                        <td><%= appointment.doctor_name %></td>
                                        <td>
                                            <% if (appointment.status === 'discharged') { %>
                                                <span class="badge bg-success">Discharged</span>
                                            <% } else { %>
                                                <span class="badge bg-warning">Admitted</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/view-ipd-appointment/<%= appointment.id %>" class="btn btn-primary">View</a>
                                            <button onclick="deleteAppointment('<%= appointment.id %>')" class="btn btn-danger">Delete</button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>


                        </table>
                    </div>
                </div>

            </div>
        </div>
        <!-- Edit Appointment Modal -->


    </div>
    <!-- Javascript -->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>

    <!-- page vendor js file -->
    <script src="../dist/assets/bundles/apexcharts.bundle.js"></script>

    <!-- page js file -->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../../js/hospital/index.js"></script>
    <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>
    <script src="../dist/assets/js/tabulator.min.js"></script>
    <script>
        function deleteAppointment(id) {
            if (confirm('Are you sure you want to delete this IPD appointment? This action cannot be undone.')) {
                fetch(`/delete-ipd-appointment/${id}`, {
                    method: 'DELETE',
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Appointment deleted successfully');
                        location.reload();
                    } else {
                        alert('Error deleting appointment: ' + (data.details || data.error));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error deleting appointment');
                });
            }
        }

        $(document).ready(function() {
            const table = new Tabulator("#ipd-appointments-table", {
                layout: "fitDataFill",
                responsiveLayout: true,
                columns: [
                    {title: "Patient ID", field: "patient_id", headerFilter: "input"},
                    {title: "Patient Name", field: "patient_name", headerFilter: "input"},
                    {title: "Appointment Date", field: "appointment_date", headerFilter: "input"},
                    {title: "Bed Number", field: "bed_number", headerFilter: "input"},
                    {title: "Assigned Doctor", field: "doctor_name", headerFilter: "input"},
                    {title: "Status", field: "status", headerFilter: "input", formatter: "html"},
                    {title: "Action", formatter: "html"}
                ]

            });
        });

    </script>


    <!-- Create Floor Modal -->


</body>

</html>