<!doctype html>
<html lang="en">

<head>
    <title>AHMS :: Appointments</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Iconic Bootstrap 4.5.0 Admin Template">
    <meta name="author" content="WrapTheme, design by: ThemeMakker.com">
    <link rel="icon" href="favicon.ico" type="image/x-icon">

    <!-- VENDOR CSS -->
    <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css">

    <!-- MAIN Project CSS file -->
    <link rel="stylesheet" href="../dist/assets/css/main.css">
    <link rel="stylesheet" href="../dist/assets/css/tabulator_bootstrap5.css">
    <style>
        .tabulator {
            font-size: 12px;
            text-align: center;
        }
    </style>
</head>

<body data-theme="light" class="font-nunito">
    <div id="wrapper" class="theme-cyan">

        <%- include('navbar') %>


        <!--main page content body part-->
        <div id="main-content">
            <div class="container-fluid">
                <div class="block-header">
                    <div class="row">
                        <div class="col-lg-12 d-flex justify-content-between">
                            <h2>Beds</h2>
                            <button type="button" class="btn btn-primary" data-toggle="modal"
                                data-target="#createRoomTypeModal">Create Room Type</button>
                        </div>


                    </div>
                </div>
                <div class="row clearfix">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="body">
                                <table class="table table-bordered table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Room Type</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <% room_types.forEach(room_type=> { %>
                                            <tr>
                                                <td>
                                                    <%= room_type.room_type %>
                                                </td>
                                                <td>

                                                    <button type="button" class="btn btn-primary edit-button"
                                                        data-toggle="modal" data-target="#editRoomTypeModal"
                                                        data-id="<%= room_type.id %>"
                                                        data-room-type="<%= room_type.room_type %>">Edit</button>
                                                    <a href="/room-type/<%= room_type.id %>/delete"
                                                        class="btn btn-danger"
                                                        onclick="return confirm('Are you sure you want to delete this room type?')">Delete</a>



                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Edit Appointment Modal -->
        <div class="modal fade" id="createRoomTypeModal" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">


                    <div class="modal-header">
                        <h5 class="modal-title">Create Room Type</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>


                        </button>
                    </div>
                    <div class="modal-body">
                        <form id="createRoomTypeForm" method="POST" action="/room-type">
                            <div class="form-group">
                                <label for="roomType">Room Type:</label>
                                <input type="text" class="form-control" id="roomType" name="room_type" required>
                            </div>
                            <button type="submit" class="btn btn-secondary">Create</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Room Type Modal -->
        <div class="modal fade" id="editRoomTypeModal" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title">Edit Room Type</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>


                        </button>
                    </div>
                    <div class="modal-body">
                        <form id="editRoomTypeForm" method="POST">
                            <input type="hidden" id="roomTypeId" name="id">
                            <div class="form-group">
                                <label for="editRoomType">Room Type:</label>
                                <input type="text" class="form-control" id="editRoomType" name="room_type" required>
                            </div>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <!-- Javascript -->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>

    <!-- page vendor js file -->
    <script src="../dist/assets/bundles/apexcharts.bundle.js"></script>

    <!-- page js file -->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../../js/hospital/index.js"></script>
    <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>
    <script src="../dist/assets/js/tabulator.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.edit-button').on('click', function () {
                const roomTypeId = $(this).data('id');
                const roomType = $(this).data('room-type');



                $('#roomTypeId').val(roomTypeId);
                $('#editRoomType').val(roomType);



            });

            $('#editRoomTypeForm').submit(function (event) {
                event.preventDefault(); // Prevent default form submission
                const formData = $(this).serialize();
                const url = `/room-type/${$('#roomTypeId').val()}`; // Construct the URL for PUT request
                $.ajax({


                    type: 'POST',
                    url: url,
                    data: formData,
                    success: function (response) {
                        // Handle successful update (e.g., close modal, refresh table)
                        $('#editRoomTypeModal').modal('hide');
                        location.reload(); // Refresh the page to reflect changes
                    },


                    error: function (error) {
                        // Handle errors (e.g., display error message)
                        console.error('Error updating room type:', error);
                        alert('Error updating room type. Please try again.');


                    }
                });
            });
        });
    </script>

    <!-- Create Room Type Modal -->


</body>

</html>