<!doctype html>
<html lang="en">

<head>
    <title>AHMS :: Patient Complaints</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Iconic Bootstrap 4.5.0 Admin Template">
    <meta name="author" content="WrapTheme, design by: ThemeMakker.com">
    <link rel="icon" href="favicon.ico" type="image/x-icon">

    <!-- VENDOR CSS -->
    <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="/dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css">

    <!-- MAIN Project CSS file -->
    <link rel="stylesheet" href="../dist/assets/css/main.css">
</head>

<body data-theme="light" class="font-nunito">
    <div id="wrapper" class="theme-cyan">

        <%- include('navbar') %>


        <!-- main page content body part -->
        <div id="main-content">
            <div class="container-fluid">
                <div class="block-header">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <h2>Master</h2>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/index"><i class="fa fa-dashboard"></i></a>
                                </li>
                                <li class="breadcrumb-item">Master</li>
                            </ul>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12"></div>
                    </div>
                </div>
<!-- Complaints -->
<div class="row clearfix">
    <div class="col-md-12">
        <div class="card patients-list">
            <div class="header">
                <h2>Add Complaints</h2>
            </div>
            <div class="body">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Enter New Complaint" id="customComplaint">
                    <div class="input-group-append">
                        <button class="btn btn-outline-secondary" id="btn_add_complaint" type="button" onclick="addCustom('customComplaint', 'complaint')">Add</button>
                    </div>
                </div>
            </div>
            <div class="container mt-3 col-sm-12">
                <h5 class="most-common">Most Common</h5>
                <div class="input-group mt-3 mb-3">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="icon-magnifier"></i></span>
                    </div>
                    <input type="text" class="form-control" placeholder="Search Complaint" id="searchInput" onkeyup="searchItems('searchInput', 'mostCommonButtons')">
                </div>
                <div class="selected-buttons mb-3" id="selected-buttons-complaint"></div>
                <div class="most-common mb-3" id="mostCommonButtons" name="mostCommonButtons-complaint">
                    <% complaints.forEach(complaint => { %>
                        <button class="btn btn-outline-secondary mb-2" id="btn_common_complaints <%= complaint.complaint_id %>"
                            onclick="removeButton('<%= complaint.complaint_id %>', 'complaint')">
                        <%= complaint.complaint %> <span class="close ms-1">&times;</span>
                    </button>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Diagnosis -->
<div class="row clearfix">
    <div class="col-md-12">
        <div class="card patients-list">
            <div class="header">
                <h2>Diagnosis</h2>
            </div>
            <div class="body">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Enter New Diagnosis" id="customDiagnosis">
                    <div class="input-group-append">
                        <button class="btn btn-outline-secondary" type="button" onclick="addCustom('customDiagnosis', 'diagnosis')" id="btn_add_diagnosis">Add</button>
                    </div>
                </div>
            </div>
            <div class="container mt-3 col-sm-12">
                <h5 class="diagnosis">Diagnosis</h5>
                <div class="input-group mt-3 mb-3">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="icon-magnifier"></i></span>
                    </div>
                    <input type="text" class="form-control" placeholder="Search Diagnosis" id="searchInput1" onkeyup="searchItems('searchInput1', 'diagnosisButtons')">
                </div>
                <div class="selected-buttons mb-3" id="selected-buttons-diagnosis"></div>
                <div class="most-common mb-3" id="mostCommonButtons" name="mostCommonButtons-diagnosis">
                    <% diagnosis.forEach(diagnosis => { %>
                        <button class="btn btn-outline-secondary mb-2" id="btn_common_diagnosis <%= diagnosis.diagnosis_id %>" onclick="removeButton('<%= diagnosis.diagnosis_id %>','diagnosis')">
                            <%= diagnosis.diagnosis %> <span class="close ms-1">&times;</span>
                        </button>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Test -->
<div class="row clearfix">
    <div class="col-md-12">
        <div class="card patients-list">
            <div class="header">
                <h2>Test</h2>
            </div>
            <div class="body">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Enter New Test" id="customTests">
                    <div class="input-group-append">
                        <button class="btn btn-outline-secondary" type="button" id="btn_add_tests" onclick="addCustom('customTests', 'tests')">Add</button>
                    </div>
                </div>
            </div>
            <div class="container mt-3 col-sm-12">
                <h5 class="tests">Tests</h5>
                <div class="input-group mt-3 mb-3">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="icon-magnifier"></i></span>
                    </div>
                    <input type="text" class="form-control" placeholder="Search Test" id="searchInput2" onkeyup="searchItems('searchInput2', 'testButtons')">
                </div>
                <div class="selected-buttons mb-3" id="selected-buttons-test"></div>
                <div class="most-common mb-3" id="mostCommonButtons" name="mostCommonButtons-tests">
                    <% tests.forEach(test => { %>
                        <button class="btn btn-outline-secondary mb-2" id="btn_common_tests_<%= test.tests_id %>" onclick="removeButton('<%= test.tests_id %>','tests')">
                            <%= test.tests %> <span class="close ms-1">&times;</span>
                        </button>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Advice -->
<div class="row clearfix">
    <div class="col-md-12">
        <div class="card patients-list">
            <div class="header">
                <h2>Advice</h2>
            </div>
            <div class="body">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Enter New Advice" id="customAdvice">
                    <div class="input-group-append">
                        <button class="btn btn-outline-secondary" type="button" onclick="addCustom('customAdvice', 'advice')" id="btn_add_advice">Add</button>
                    </div>
                </div>
            </div>
            <div class="container mt-3 col-sm-12">
                <h5 class="advice">Advice</h5>
                <div class="input-group mt-3 mb-3">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="icon-magnifier"></i></span>
                    </div>
                    <input type="text" class="form-control" placeholder="Search Advice" id="searchInput3" onkeyup="searchItems('searchInput3', 'adviceButtons')">
                </div>
                <div class="selected-buttons mb-3" id="selected-buttons-advice"></div>
                <div class="most-common mb-3" id="mostCommonButtons" name="mostCommonButtons-advice">
                    <% advice.forEach(advice => { %>
                        <button class="btn btn-outline-secondary mb-2" id="btn_common_advice_<%= advice.advice_id %>" onclick="removeButton('<%= advice.advice_id %>','advice')">
                            <%= advice.advice %> <span class="close ms-1">&times;</span>
                        </button>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</div>
    <!--Javascript-->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>

    <!-- page vendor js file -->
    <script src="../dist/assets/bundles/apexcharts.bundle.js"></script>

    <!-- page js file -->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../../js/hospital/index.js"></script>
    <script>
document.addEventListener("DOMContentLoaded", () => {
            fetch('get-user-name')
            .then(response => response.json())
            .then(data => {
                document.getElementById("login-name").innerHTML = data.name
                if(data.gender == "female"){
                    document.getElementById("login-img").src = "../dist/assets/images/user-f.jpg"
                } else if (data.gender == "male"){
                document.getElementById("login-img").src = "../dist/assets/images/user-m.jpg"

                }
            })
        })
        
        document.addEventListener('DOMContentLoaded', () => {
            fetchInitialData('complaint');
            fetchInitialData('diagnosis');
            fetchInitialData('tests');
            fetchInitialData('advice');
        });
    
        function fetchInitialData(table) {
            fetch(`/api/most-common-${table}`)
            .then(response => response.json())
            .then(data => {
                updateMostCommonItems(table, data);
            })
            .catch(error => console.error(`Error fetching ${table}:`, error));
        }
    
        function addCustom(inputId, table) {
            const inputValue = document.getElementById(inputId).value.trim();
    
            if (inputValue) {
                fetch(`/api/add-${table}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ value: inputValue })
                })
                .then(response => response.json())
                .then(data => {
                    
                    document.getElementById(inputId).value = '';
                    location.reload();
                    //updateMostCommonItems(table, data.items);
                })
                .catch(error => console.error('Error adding item:', error));
            }
        }
    
        // Function to remove an item
        function removeButton(itemId, table) {
           fetch(`/api/remove-${table}/${itemId}`, {
           method: 'DELETE'
            })
            .then(response => response.json())
            .then(data => {
                location.reload();
            })
            .catch(error => console.error('Error removing item:', error));
            
        }
    
        // Function to update most common items after add or remove operations
        function updateMostCommonItems(table, items) {
            const mostCommonButtons = document.getElementsByName(`mostCommonButtons-${table}`);
    
            
            if(mostCommonButtons){
                mostCommonButtons.innerHTML = '';
                
                items.forEach(item => {
                    mostCommonButtons.innerHTML += `
                        <button class="btn btn-outline-secondary mb-2" id="btn_common_${table}_${item.id}" onclick="removeButton('${item.id}', '${table}')">
                            ${item.value} <span class="close ms-1">&times;</span>
                        </button>
                    `;
                });
            }else{
                    console.error('Element with ID mostCommonButtons not found');
                
            }
            
        }
    
        // Function to search items dynamically
        function searchItems(inputId, containerId) {
            const searchInput = document.getElementById(inputId).value.toLowerCase();
            const items = document.getElementById(containerId).getElementsByClassName('btn');
    
            Array.from(items).forEach(item => {
                const itemName = item.textContent.trim().toLowerCase();
                if (itemName.includes(searchInput)) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }
    </script>
     
</body>

</html>