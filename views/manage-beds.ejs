<!doctype html>
<html lang="en">

<head>
    <title>AHMS :: Manage Beds</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Iconic Bootstrap 4.5.0 Admin Template">
    <meta name="author" content="WrapTheme, design by: ThemeMakker.com">

    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <!-- VENDOR CSS -->
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap-datepicker/css/bootstrap-datepicker3.min.css">

    <!-- MAIN CSS -->
    <link rel="stylesheet" href="../dist/assets/css/main.css">
    <link rel="stylesheet" href="../dist/assets/css/tabulator_bootstrap5.css">

    <style>
        .tabulator {
            font-size: 12px;
            text-align: center;
        }
    </style>

</head>

<body data-theme="light" class="font-nunito">

    <div id="wrapper" class="theme-cyan">

        <%- include('navbar') %>


        <!-- main page content body part -->
        <div id="main-content">
            <div class="container-fluid">
                <div class="block-header">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <h2>Manage Beds</h2>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/index"><i class="fa fa-dashboard"></i></a>
                                </li>
                                <li class="breadcrumb-item">Room Allotment</li>
                                <li class="breadcrumb-item active">Manage Beds</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="row clearfix">
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="card mt-4">
                            <div class="header">
                                <h2>Add Bed</h2>
                            </div>
                            <div class="body">
                                <form id="addBedForm" novalidate>
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label for="roomNumber" class="form-label">Room Number</label>
                                            <input type="text" class="form-control" id="roomNumber" required>
                                            <div class="invalid-feedback">Please provide a room number.</div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label for="bedNumber" class="form-label">Bed Number</label>
                                            <input type="text" class="form-control" id="bedNumber" required>
                                            <div class="invalid-feedback">Please provide a bed number.</div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label for="roomType" class="form-label">Select Room Type</label>
                                            <select class="form-control" id="roomType" required>
                                                <option value="">-Select Room Type-</option>
                                                <option value="Deluxe">Deluxe</option>
                                                <option value="Super Deluxe">Super Deluxe</option>
                                                <option value="ICU">ICU</option>
                                            </select>
                                            <div class="invalid-feedback">Please select a room type.</div>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                    <button type="reset" class="btn btn-secondary">Cancel</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row clearfix">
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="card mt-4">
                            <div class="header">
                                <h2>Manage Beds</h2>
                            </div>
                            <div class="body">
                                <div id="bed-table"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!--Edit Bed Modal-->
            <div class="modal fade" id="editBedModal" tabindex="-1" aria-labelledby="editBedModalLabel"
                aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="editBedModalLabel">Edit Bed Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="editBedForm" novalidate>
                                <div class="mb-3">
                                    <label for="editRoomNumber" class="form-label">Room Number</label>
                                    <input type="text" class="form-control" id="editRoomNumber" required>
                                    <div class="invalid-feedback">Please provide a room number.</div>
                                </div>
                                <div class="mb-3">
                                    <label for="editBedNumber" class="form-label">Bed Number</label>
                                    <input type="text" class="form-control" id="editBedNumber" required>
                                    <div class="invalid-feedback">Please provide a bed number.</div>
                                </div>
                                <div class="mb-3">
                                    <label for="editRoomType" class="form-label">Room Type</label>
                                    <select class="form-control" id="editRoomType" required>
                                        <option value="">- Select -</option>
                                        <option value="Deluxe">Deluxe</option>
                                        <option value="Super Deluxe">Super Deluxe</option>
                                        <option value="ICU">ICU</option>
                                    </select>
                                    <div class="invalid-feedback">Please select a room type.</div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="button" class="btn btn-primary" id="saveEditChangesBtn">Save changes</button>
                        </div>
                    </div>
                </div>
            </div>

            <!--Delete Bed Modal-->
            <div class="modal fade" id="deleteBedModal" tabindex="-1" aria-labelledby="deleteBedModalLabel"
                aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="deleteBedModalLabel">Delete Bed</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            Are you sure you want to delete this bed?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Javascript -->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>

    <script src="../dist/assets/vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>

    <!-- page js file -->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>
    <script src="../dist/assets/js/tabulator.min.js"></script>

    <script>
document.addEventListener("DOMContentLoaded", () => {
            fetch('get-user-name')
            .then(response => response.json())
            .then(data => {
                document.getElementById("login-name").innerHTML = data.name
                if(data.gender == "female"){
                    document.getElementById("login-img").src = "../dist/assets/images/user-f.jpg"
                } else if (data.gender == "male"){
                document.getElementById("login-img").src = "../dist/assets/images/user-m.jpg"

                }
            })
        })

        const roomData = [
            // Initial room data can be added here
        ];

        const table = new Tabulator("#bed-table", {
            data: roomData,
            layout: "fitColumns",
            columns: [
                { title: "Room Number", field: "roomNumber", headerFilter: "input", headerHozAlign: "center" },
                { title: "Bed Number", field: "bedNumber", headerFilter: "input", headerHozAlign: "center" },
                { title: "Room Type", field: "roomType", headerFilter: "input", headerHozAlign: "center" },
                {
                    title: "Actions",
                    field: "actions",
                    headerHozAlign: "center",
                    formatter: function (cell, formatterParams, onRendered) {
                        return `<button class="btn btn-sm btn-primary edit-btn"><i class="fa fa-pencil"></i> Edit</button>
                                <button class="btn btn-sm btn-danger delete-btn"><i class="fa fa-trash"></i> Delete</button>`;
                    },

                    cellClick: function (e, cell) {
                        var data = cell.getRow().getData();
                        if (e.target.classList.contains('edit-btn')) {
                            document.getElementById('editRoomNumber').value = data.roomNumber;
                            document.getElementById('editBedNumber').value = data.bedNumber;
                            document.getElementById('editRoomType').value = data.roomType;

                            document.getElementById('editBedForm').dataset.rowId = data.roomNumber;

                            var editModal = new bootstrap.Modal(document.getElementById('editBedModal'));
                            editModal.show();
                        } else if (e.target.classList.contains('delete-btn')) {
                            var deleteModal = new bootstrap.Modal(document.getElementById('deleteBedModal'));
                            deleteModal.show();
                        }
                    }
                }
            ]
        });


        //Add Bed Form Submit
        document.getElementById('addBedForm').addEventListener('submit', function (event) {
            event.preventDefault(); // Prevent the default form submission

            const form = event.target;

            form.classList.add('was-validated');

            if (form.checkValidity() === false) {
                event.stopPropagation();
            } else {
                const roomNumber = document.getElementById('roomNumber').value;
                const bedNumber = document.getElementById('bedNumber').value;
                const roomType = document.getElementById('roomType').value;

                //Add the new bed data to the Tabulator
                table.addRow({ roomNumber, bedNumber, roomType });

                //Reset form
                form.reset();
                form.classList.remove('was-validated');
            }
        });

        //Room No. input change event listener for Add Bed Form
        document.getElementById('roomNumber').addEventListener('input', function () {
            const roomNumber = parseInt(this.value);
            const roomTypeField = document.getElementById('roomType');
            const bedNumberField = document.getElementById('bedNumber');

            if (roomNumber >= 101 && roomNumber <= 103) {
                roomTypeField.value = "Deluxe";
                bedNumberField.disabled = false;
            } else if (roomNumber >= 201 && roomNumber <= 205) {
                roomTypeField.value = "Super Deluxe";
                bedNumberField.disabled = false;
            } else if (roomNumber >= 301 && roomNumber <= 302) {
                roomTypeField.value = "ICU";
                bedNumberField.disabled = false;
            } else {
                roomTypeField.value = "";
                bedNumberField.disabled = false;
            }
        });

        //------------------------------------------------------------------------------------------
        //Edit Bed Form Submit
        document.getElementById('editBedForm').addEventListener('submit', function (event) {
            event.preventDefault(); // Prevent the default form submission

            const form = event.target;

            if (form.checkValidity() === false) {
                event.stopPropagation();
            } else {
                const rowId = form.dataset.rowId;
                const updatedData = {
                    roomNumber: document.getElementById('editRoomNumber').value,
                    bedNumber: document.getElementById('editBedNumber').value,
                    roomType: document.getElementById('editRoomType').value
                };

                // Update the Tabulator row with new data
                row.update(updatedData);

                // Hide the edit modal
                const editModal = bootstrap.Modal.getInstance(document.getElementById('editBedModal'));
                editModal.hide();

                // Reset the form
                form.reset();
                form.classList.remove('was-validated');
            }

            form.classList.add('was-validated');
        });

        //Room No. input change event listener for Edit Bed Form
        document.getElementById('editRoomNumber').addEventListener('input', function () {
            const roomNumber = this.value;
            const bedNumberField = document.getElementById('editBedNumber');
            const roomTypeField = document.getElementById('editRoomType');

            if (roomNumber >= 101 && roomNumber <= 103) {
                roomTypeField.value = "Deluxe";
                bedNumberField.disabled = false;
            } else if (roomNumber >= 201 && roomNumber <= 205) {
                roomTypeField.value = "Super Deluxe";
                bedNumberField.disabled = false;
            } else if (roomNumber >= 301 && roomNumber <= 302) {
                roomTypeField.value = "ICU";
                bedNumberField.disabled = false;
            } else {
                roomTypeField.value = "";
                bedNumberField.disabled = false;
            }

            if (roomTypeField.value === "Super Deluxe" || roomTypeField.value === "ICU") {
                bedNumberField.disabled = false;
                bedNumberField.value = "";//Remove Bed No.
            } else {
                bedNumberField.disabled = false;
            }
        });

        //Save changes button
        document.getElementById('saveEditChangesBtn').addEventListener('click', function () {
            var editBedForm = document.getElementById('editBedForm');
            if (editBedForm.checkValidity() === false) {
                editBedForm.classList.add('was-validated');
            } else {
                var rowId = editBedForm.dataset.rowId;
                var updatedData = {
                    id: rowId,
                    roomNumber: document.getElementById('editRoomNumber').value,
                    bedNumber: document.getElementById('editBedNumber').value,
                    roomType: document.getElementById('editRoomType').value,
                };
                table.updateRow(rowId, updatedData);
                var editModal = bootstrap.Modal.getInstance(document.getElementById('editBedModal'));
                editModal.hide();
            }
        });

        //Delete button
        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            const rowId = this.dataset.rowId;
            const row = table.getRow(rowId);

            if (row) {
                row.delete();
                const deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteBedModal'));
                deleteModal.hide();
            }
        });

    </script>

</body>

</html>