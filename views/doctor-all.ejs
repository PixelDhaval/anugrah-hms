<!doctype html>
<html lang="en">

<head>
    <title>AHMS :: All Doctor</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Iconic Bootstrap 4.5.0 Admin Template">
    <meta name="author" content="WrapTheme, design by: ThemeMakker.com">

    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <!-- VENDOR CSS -->
     <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/sweetalert/sweetalert.css" />

    <!-- MAIN CSS -->
    <link rel="stylesheet" href="../dist/assets/css/main.css">
</head>

<body data-theme="light" class="font-nunito">

    <div id="wrapper" class="theme-cyan">

        <%- include('navbar') %>

        <!-- main page content body part -->
        <div id="main-content">
            <div class="container-fluid">
                <div class="block-header">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <h2>All Doctor</h2>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a href="index.html"><i class="fa fa-dashboard"></i></a>
                                </li>
                                <li class="breadcrumb-item">Doctor</li>
                                <li class="breadcrumb-item active">All Doctor</li>
                            </ul>
                        </div>

                    </div>
                </div>

                <div class="row clearfix">
                    <% doctors.forEach(doctor => { %>
                        <div class="col-lg-3 col-md-6 col-sm-12">
                            <div class="card">
                                <a href="/add-doctor?userId=<%=doctor.user_id %>">

                                    <div class="body text-center">
                                        <div class="chart easy-pie-chart-1" data-percent="75">
                                            <span>
                                                <% if (doctor && doctor.doctor_img) { %>
                                                    <img src="data:image/png;base64,<%= doctor.doctor_img %>"
                                                        id="doctorImage" data-toggle="tooltip" data-placement="top"
                                                        title="Doctor Image" alt="Doctor Image" class="rounded-circle" />
                                                <% } else { %>
                                                    <img src="../dist/assets/images/sm/avatar3.jpg" id="doctorImage"
                                                        data-toggle="tooltip" data-placement="top" title="Default Image"
                                                        alt="Default Image" class="rounded-circle" />
                                                <% } %>
                                            </span>
                                        </div>
                                        <h4 class="mt-3" id="doctorName"><%= doctor.name %></h4>
                                        <span class="mt-2" id="doctorSpeciality"><%= doctor.specialization %></span>
                                        <h6 class="mt-3" id="doctorUsername"><%= doctor.username %></h6>
                                    </div>
                                    
                                </a>
                            </div>
                        </div>
                    <% }); %>
                </div>
                


            </div>
        </div>
    </div>

    <!-- Javascript -->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>

    <script src="../dist/assets/bundles/easypiechart.bundle.js"></script> <!-- easypiechart Plugin Js -->

    <!-- page js file -->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>

