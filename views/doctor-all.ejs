                <div class="row clearfix">
                    <% doctors.forEach(doctor => { %>
                        <div class="col-lg-3 col-md-6 col-sm-12">
                            <div class="card">
                                <a href="/add-doctor?userId=<%=doctor.user_id %>">

                                    <div class="body text-center">
                                        <div class="chart easy-pie-chart-1" data-percent="75">
                                            <span>
                                                <% if (doctor && doctor.doctor_img) { %>
                                                    <img src="data:image/png;base64,<%= doctor.doctor_img %>"
                                                        id="doctorImage" data-toggle="tooltip" data-placement="top"
                                                        title="Doctor Image" alt="Doctor Image" class="rounded-circle" />
                                                <% } else { %>
                                                    <img src="../dist/assets/images/sm/avatar3.jpg" id="doctorImage"
                                                        data-toggle="tooltip" data-placement="top" title="Default Image"
                                                        alt="Default Image" class="rounded-circle" />
                                                <% } %>
                                            </span>
                                        </div>
                                        <h4 class="mt-3" id="doctorName"><%= doctor.name %></h4>
                                        <span class="mt-2" id="doctorSpeciality"><%= doctor.specialization %></span>
                                        <h6 class="mt-3" id="doctorUsername"><%= doctor.username %></h6>
                                    </div>
                                    
                                </a>
                            </div>
                        </div>
                    <% }); %>
