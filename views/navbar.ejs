<%
    // Shared page chrome: loader, top navbar, left sidebar and right icon bar.
    // currentPath comes from res.locals (set in index.js) and highlights the open page.
    const menu = [
        { title: 'Dashboard', icon: 'fa-dashboard', href: '/index', also: ['/'] },
        { title: 'Patients', icon: 'fa-user', items: [
            { title: 'All Patients', href: '/all-patients' },
            { title: 'Add Patient', href: '/add-patient' },
        ] },
        { title: 'Appointments', icon: 'fa-folder', items: [
            { title: "Today's Appointments", href: '/manage-appointment', also: ['/create-prescription', '/patient-complaints'] },
            { title: 'All Appointments', href: '/all-appointment' },
        ] },
        { title: 'IPD Appointments', icon: 'fa-bed', items: [
            { title: 'IPD Appointments', href: '/ipd-appointments' },
        ] },
        { title: 'Room Allotment', icon: 'fa-building', items: [
            { title: 'Beds', href: '/beds' },
            { title: 'Room Types', href: '/room-type' },
            { title: 'Floors', href: '/floors' },
            { title: 'Rooms', href: '/rooms' },
        ] },
        { title: 'Billing', icon: 'fa-cc-visa', items: [
            { title: 'Indoor Billing', href: '/ipd-billing-list' },
            { title: 'OPD Billing', href: '/opd-billing-list' },
        ] },
        { title: 'Reports', icon: 'fa-globe', items: [
            { title: 'Monthly OPD Report', href: '/report-opd' },
            { title: 'Daily Cash Collection', href: '/report-cash-coll' },
            { title: 'OPD Transaction Report', href: '/report-transactions' },
            { title: 'IPD Transaction Report', href: '/report-ipd-transactions' },
        ] },
        { title: 'Doctors', icon: 'fa-user-md', items: [
            { title: 'All Doctors', href: '/all-doctors', also: ['/add-doctor'] },
        ] },
        { title: 'Master', icon: 'fa-list', items: [
            { title: 'Appointment Master', href: '/appointment-master' },
            { title: 'Indoor Service Master', href: '/indoor-services' },
            { title: 'OPD Service Master', href: '/opd-service-master' },
        ] },
        { title: 'User Management', icon: 'fa-tag', items: [
            { title: 'Create Users', href: '/create-users' },
            { title: 'All Users', href: '/user-authentication' },
        ] },
    ];
    const path = typeof currentPath !== 'undefined' ? currentPath : '';
    const isActive = (item) => item.href === path || (item.also || []).includes(path);
%>
<div class="page-loader-wrapper">
    <div class="loader">
        <div class="m-t-30"><img src="/dist/assets/images/logo-icon.svg" width="48" height="48" alt="Anugrah"></div>
        <p>Please wait...</p>
    </div>
</div>

<!-- Top navbar -->
<nav class="navbar navbar-fixed-top">
    <div class="container-fluid">
        <div class="navbar-brand">
            <button type="button" class="btn-toggle-offcanvas"><i class="fa fa-bars"></i></button>
            <button type="button" class="btn-toggle-fullwidth"><i class="fa fa-bars"></i></button>
            <a href="/index">Anugrah</a>
        </div>

        <div class="navbar-right">
            <div id="navbar-menu">
                <ul class="nav navbar-nav">
                    <li>
                        <a href="/logout" class="icon-menu" title="Logout"><i class="fa fa-power-off"></i></a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<!-- Left sidebar -->
<div id="left-sidebar" class="sidebar">
    <button type="button" class="btn-toggle-offcanvas"><i class="fa fa-arrow-left"></i></button>
    <div class="sidebar-scroll">
        <div class="user-account">
            <!-- login-img and login-name are filled in by each page from /get-user-name -->
            <img src="/dist/assets/images/user.png" id="login-img" class="rounded-circle user-photo"
                alt="User Profile Picture">
            <div class="dropdown">
                <span>Welcome,</span>
                <a href="javascript:void(0);" class="dropdown-toggle user-name"
                    data-toggle="dropdown"><strong><span id="login-name"></span></strong></a>
                <ul class="dropdown-menu dropdown-menu-right account">
                    <li><a href="/logout"><i class="icon-power"></i>Logout</a></li>
                </ul>
            </div>
        </div>

        <ul class="nav nav-tabs">
            <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#menu">Menu</a></li>
            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#setting" title="Display settings"><i class="icon-settings"></i></a></li>
        </ul>

        <div class="tab-content padding-0">
            <div class="tab-pane active" id="menu">
                <nav id="left-sidebar-nav" class="sidebar-nav">
                    <ul class="metismenu li_animation_delay">
                        <% menu.forEach(section => { %>
                        <% if (!section.items) { %>
                        <li class="<%= isActive(section) ? 'active' : '' %>">
                            <a href="<%= section.href %>"><i class="fa <%= section.icon %>"></i><span><%= section.title %></span></a>
                        </li>
                        <% } else { %>
                        <li class="<%= section.items.some(isActive) ? 'active' : '' %>">
                            <a href="javascript:void(0);" class="has-arrow"><i class="fa <%= section.icon %>"></i><span><%= section.title %></span></a>
                            <ul>
                                <% section.items.forEach(item => { %>
                                <li class="<%= isActive(item) ? 'active' : '' %>"><a href="<%= item.href %>"><%= item.title %></a></li>
                                <% }); %>
                            </ul>
                        </li>
                        <% } %>
                        <% }); %>
                    </ul>
                </nav>
            </div>

            <div class="tab-pane" id="setting">
                <h6>Choose Skin</h6>
                <ul class="choose-skin list-unstyled">
                    <li data-theme="purple"><div class="purple"></div></li>
                    <li data-theme="blue"><div class="blue"></div></li>
                    <li data-theme="cyan" class="active"><div class="cyan"></div></li>
                    <li data-theme="green"><div class="green"></div></li>
                    <li data-theme="orange"><div class="orange"></div></li>
                    <li data-theme="blush"><div class="blush"></div></li>
                    <li data-theme="red"><div class="red"></div></li>
                </ul>

                <!-- mainscripts.bundle.js binds to these two switches and throws if they are missing -->
                <ul class="list-unstyled mt-3">
                    <li class="d-flex align-items-center mb-2">
                        <label class="toggle-switch theme-switch">
                            <input type="checkbox">
                            <span class="toggle-switch-slider"></span>
                        </label>
                        <span class="ml-3">Dark mode</span>
                    </li>
                    <li class="d-flex align-items-center mb-2">
                        <label class="toggle-switch theme-high-contrast">
                            <input type="checkbox">
                            <span class="toggle-switch-slider"></span>
                        </label>
                        <span class="ml-3">High contrast</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Right icon bar: quick links -->
<div class="right_icon_bar">
    <ul>
        <li><a href="/all-patients" title="All Patients"><i class="fa fa-user"></i></a></li>
        <li><a href="/add-patient" title="Add Patient"><i class="fa fa-plus"></i></a></li>
        <li><a href="/manage-appointment" title="All Appointments"><i class="fa fa-folder"></i></a></li>
        <li><a href="/ipd-appointments" title="IPD Appointments"><i class="fa fa-bed"></i></a></li>
        <li><a href="javascript:void(0);" class="right_icon_btn"><i class="fa fa-angle-right"></i></a></li>
    </ul>
</div>
