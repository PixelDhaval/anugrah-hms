<!DOCTYPE html>
<html lang="en">

<head>
    <title>AHMS :: Indoor Services</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Hospital Management System">
    <meta name="author" content="WrapTheme">

    <!-- VENDOR CSS -->
    <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="../dist/assets/css/select2.min.css">
    <!-- MAIN Project CSS file -->
    <link rel="stylesheet" href="../dist/assets/css/main.css">
    <link rel="stylesheet" href="../dist/assets/css/tabulator_bootstrap5.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body data-theme="light" class="font-nunito">
    <div id="wrapper" class="theme-cyan">
        <%- include('navbar') %>
            <div id="main-content">
                <div class="container-fluid">
                    <div class="block-header">
                        <div class="row">
                            <div class="col-lg-6 col-md-8 col-sm-12">
                                <h2>Indoor Services</h2>
                            </div>
                        </div>
                    </div>

                    <div class="row clearfix">
                        <div class="col-lg-12">
                            <div class="card">
                                <div class="header">
                                    <h2>Manage Indoor Services</h2>
                                    <button type="button" class="btn btn-primary float-right" data-toggle="modal"
                                        data-target="#addServiceModal">
                                        Add New Service
                                    </button>
                                </div>
                                <div class="body">
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-striped table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Code</th>
                                                    <th>Service Name</th>
                                                    <th>Rate</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% services.forEach(function(service) { %>
                                                    <tr>
                                                        <td>
                                                            <%= service.code %>
                                                        </td>
                                                        <td>
                                                            <%= service.indoor_service_name %>
                                                        </td>
                                                        <td>
                                                            <%= service.rate %>
                                                        </td>
                                                        <td>
                                                            <button class="btn btn-sm btn-info edit-service"
                                                                data-id="<%= service.id %>"
                                                                data-code="<%= service.code %>"
                                                                data-name="<%= service.indoor_service_name %>"
                                                                data-rate="<%= service.rate %>">
                                                                <i class="fa fa-edit"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-danger delete-service"
                                                                data-id="<%= service.id %>">
                                                                <i class="fa fa-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal fade" id="addServiceModal" tabindex="-1" role="dialog">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Add Indoor Service</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <form id="addServiceForm">
                                    <div class="modal-body">
                                        <div class="form-group">
                                            <label>Service Name</label>
                                            <input type="text" class="form-control" name="indoor_service_name" required>
                                        </div>
                                        <div class="form-group">
                                            <label>Rate</label>
                                            <input type="number" class="form-control" name="rate" required>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                        <button type="submit" class="btn btn-primary">Save Service</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
    
                    <!-- Edit Service Modal -->
                    <div class="modal fade" id="editServiceModal" tabindex="-1" role="dialog">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Edit Indoor Service</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <form id="editServiceForm">
                                    <input type="hidden" name="id" id="edit_id">
                                    <div class="modal-body">
                                        <div class="form-group">
                                            <label>Code</label>
                                            <input type="text" class="form-control" id="edit_code" readonly>
                                        </div>
                                        <div class="form-group">
                                            <label>Service Name</label>
                                            <input type="text" class="form-control" name="indoor_service_name"
                                                id="edit_name" required>
                                        </div>
                                        <div class="form-group">
                                            <label>Rate</label>
                                            <input type="number" class="form-control" name="rate" id="edit_rate" required>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                        <button type="submit" class="btn btn-primary">Update Service</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>

            <!-- Add Service Modal -->

    </div>


    <!-- Scripts -->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script>
        $(document).ready(function () {
            // Handle Add Service Form Submit
            $('#addServiceForm').on('submit', function (e) {
                e.preventDefault();
                const formData = $(this).serialize();

                $.ajax({
                    url: '/indoor-services',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        $('#addServiceModal').modal('hide');
                        location.reload();
                    },
                    error: function (error) {
                        alert('Error adding service');
                    }
                });
            });

            // Handle Edit Button Click
            $('.edit-service').on('click', function () {
                const id = $(this).data('id');
                const code = $(this).data('code');
                const name = $(this).data('name');
                const rate = $(this).data('rate');

                $('#edit_id').val(id);
                $('#edit_code').val(code);
                $('#edit_name').val(name);
                $('#edit_rate').val(rate);

                $('#editServiceModal').modal('show');
            });

            // Handle Edit Service Form Submit
            $('#editServiceForm').on('submit', function (e) {
                e.preventDefault();
                const id = $('#edit_id').val();
                const formData = $(this).serialize();

                $.ajax({
                    url: `/indoor-services/${id}`,
                    type: 'PUT',
                    data: formData,
                    success: function (response) {
                        $('#editServiceModal').modal('hide');
                        location.reload();
                    },
                    error: function (error) {
                        alert('Error updating service');
                    }
                });
            });

            // Handle Delete Button Click
            $('.delete-service').on('click', function () {
                if (confirm('Are you sure you want to delete this service?')) {
                    const id = $(this).data('id');

                    $.ajax({
                        url: `/indoor-services/${id}`,
                        type: 'DELETE',
                        success: function (response) {
                            location.reload();
                        },
                        error: function (error) {
                            alert('Error deleting service');
                        }
                    });
                }
            });
        });
    </script>
</body>

</html>