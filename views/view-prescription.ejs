        function groupFormData() {
            const formData = $("#prescriptionForm").serializeArray();
            const groupedData = {};

            formData.forEach((field) => {
                const [fullKey, index, key, subKey] = field.name.match(/medicine\[(\d+)\]\[(\w+)\](?:\[(\w+)\])?/) || [];

                if (!groupedData[index]) {
                    groupedData[index] = {
                        is_custom: false,
                        custom_doses: '',
                        doses: []
                    };
                }

                if (key === 'is_custom') {
                    groupedData[index].is_custom = true;
                } else if (key === 'custom_doses') {
                    groupedData[index].custom_doses = field.value;
                } else if (key === 'doses') {
                    groupedData[index].doses.push(subKey);
                } else {
                    groupedData[index][key] = field.value;
                }
            });

            return Object.values(groupedData).map(medicine => {
                if (medicine.is_custom) {
                    return {
                        name: medicine.name,
                        nos: medicine.nos,
                        is_custom: true,
                        custom_doses: medicine.custom_doses,
                        dose_qty: '',
                        doses: '',
                        timing: ''
                    };
                } else {
                    return {
                        name: medicine.name,
                        nos: medicine.nos,
                        is_custom: false,
                        custom_doses: '',
                        dose_qty: medicine.dose_qty,
                        doses: medicine.doses.join(', '),
                        timing: medicine.timing
                    };
                }
            });
        }

