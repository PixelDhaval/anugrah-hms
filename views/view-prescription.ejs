        // Function to clean and parse the JSON string
        function cleanAndParseJSON(data) {
            // Remove the outer curly braces and split the string into an array of strings
            if (data == "{}") {
                return []
            }
            const jsonArray = data
                .slice(1, -1)
                .split('","')
                .map((str) =>
                    str
                        .replace(/\\\"/g, '"')
                        .replace(/\"{/g, "{")
                        .replace(/}\"/g, "}")
                );

            // Parse each string into an object
            return jsonArray.map((str) => JSON.parse(str));
        }

