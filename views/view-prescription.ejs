        //advice
        function addCustomAdvice() {
            const customAdviceInput =
                document.getElementById("customAdvice");
            const adviceText = customAdviceInput.value.trim();

            if (adviceText === "") return;

            fetch("/prescription/add-advice", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({ advice: adviceText }),
            })
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        const selectedButtonsDiv = document.getElementById(
                            "selected-buttons-advice"
                        );
                        const mostCommonButtonsDiv =
                            document.getElementById(
                                "mostCommonButtons-advice"
                            );

                        const newButton = document.createElement("button");
                        newButton.className =
                            "btn btn-secondary selected-button m-1";
                        newButton.innerText = adviceText;
                        newButton.onclick = function () {
                            selectedButtonsDiv.removeChild(newButton);
                        };
                        selectedButtonsDiv.appendChild(newButton);

                        const mostCommonButton =
                            document.createElement("button");
                        mostCommonButton.className =
                            "btn btn-outline-secondary m-1";
                        mostCommonButton.innerText = adviceText;
                        mostCommonButton.onclick = function () {
                            addButton(
                                mostCommonButton,
                                "selected-buttons-advice",
                                "mostCommonButtons-advice"
                            );
                        };
                        mostCommonButtonsDiv.appendChild(mostCommonButton);

                        customAdviceInput.value = "";
                    } else {
                        console.error("Error adding advice:", data.error);
                    }
                })
                .catch((error) => {
                    console.error("Error adding advice:", error);
                });
        }

