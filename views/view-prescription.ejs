</head>
<style></style>

<body data-theme="light" class="font-nunito">
    <div id="wrapper" class="theme-cyan">
        <%- include('navbar') %>

            <!--main page content body part-->
            <div id="main-content">
                <div class="container-fluid">
                    <div class="block-header">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-12">
                                <h2>Create Prescription</h2>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="index.html"><i class="fa fa-dashboard"></i></a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        Create Prescription
                                    </li>
                                </ul>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-12">
                                <button type="button" class="btn btn-primary" id="old-prescription"
                                    data-bs-toggle="modal" data-bs-target="#oldPrescription">
                                    View Old Prescription
                                </button>
                                <div class="modal fade" id="oldPrescription" tabindex="-1"
                                    aria-labelledby="exampleModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-xl">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h4 class="modal-title fs-5" id="exampleModalLabel">
                                                    Old Prescription
                                                </h4>
                                            </div>
                                            <div class="modal-body">
                                                <div id="prescription-container"></div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Close
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row clearfix">
                        <div class="col-md-12">
                            <form id="prescriptionForm">
                                <div class="card patients-list">
                                    <div class="body">
                                        <h5>Complaints</h5>

                                        <div class="input-group mt-3">
                                            <input type="text" class="form-control" placeholder="Enter Complaint"
                                                id="customComplaint" />
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary" type="button"
                                                    onclick="addCustomComplaint()">
                                                    Add
                                                </button>
                                            </div>
                                        </div>
                                        <div class="form-group mt-3">
                                            <div class="input-group mt-3 mb-3">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="icon-magnifier"></i></span>
                                                </div>
                                                <input type="text" class="form-control" placeholder="Search Complaint"
                                                    id="searchInput" onkeyup="searchComplaints()" />
                                            </div>
                                            <div class="selected-buttons mb-3" id="selected-buttons-complaint"></div>
                                            <div class="most-common" id="mostCommonButtons-complaint"></div>
                                            <div class="invalid-feedback">
                                                Please provide patient's
                                                complaints.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card patients-list">
                                    <div class="header">
                                        <h2>Create Prescription</h2>
                                    </div>

                                    <div class="body">
                                        <div class="form-row">
                                            <div class="form-group col-md-3">
                                                <label for="patientName">Patient Name</label>
                                                <input type="text" class="form-control" id="patientName"
                                                    placeholder="Enter patient's name" required />
                                                <div class="invalid-feedback">
                                                    Please enter the patient's
                                                    name.
                                                </div>
                                            </div>

                                            <div class="form-group col-md-3">
                                                <label for="patientAge">Age</label>
                                                <input type="text" class="form-control" id="patientAge"
                                                    placeholder="Enter patient's age" required />
                                                <div class="invalid-feedback">
                                                    Please enter the patient's
                                                    age.
                                                </div>
                                            </div>

                                            <div class="form-group col-md-3">
                                                <label for="patientGender">Gender</label>
                                                <select class="form-control" id="patientGender" required>
                                                    <option value="" disabled selected>
                                                        Select gender
                                                    </option>
                                                    <option value="Male">
                                                        Male
                                                    </option>
                                                    <option value="Female">
                                                        Female
                                                    </option>
                                                    <option value="Other">
                                                        Other
                                                    </option>
                                                </select>
                                                <div class="invalid-feedback">
                                                    Please select the patient's
                                                    gender.
                                                </div>
                                            </div>
                                            <div class="form-group col-md-3">
                                                <label for="patientWeight">Weight</label>
                                                <input type="text" class="form-control" id="patientWeight"
                                                    placeholder="Enter patient's age" />
                                                <div class="invalid-feedback">
                                                    Please enter the patient's
                                                    age.
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-2">
                                                <div class="input-group">
                                                    <span class="input-group-text" id="">BP</span>
                                                    <input type="text" class="form-control" id="bp" />
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="input-group">
                                                    <span class="input-group-text" id="">Pulse</span>
                                                    <input type="text" class="form-control" id="pulse" />
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="input-group">
                                                    <span class="input-group-text" id="">SpO2</span>
                                                    <input type="text" class="form-control" id="spo2" />
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="input-group">
                                                    <span class="input-group-text" id="">Temp</span>
                                                    <input type="text" class="form-control" id="temp" />
                                                    <span class="input-group-text" id="">C</span>
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="input-group">
                                                    <span class="input-group-text" id="">Sugar</span>
                                                    <input type="text" class="form-control" id="sugar" />
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="btn-group btn-group-toggle my-3 d-flex align-items-center"
                                                    data-toggle="buttons">
                                                    Habits:
                                                    <label class="btn btn-outline-primary habits" id="smoking">
                                                        <input type="checkbox" class="" value="Smoking">
                                                        Smoking
                                                    </label>
                                                    <label class="btn btn-outline-primary habits" id="alcohol">
                                                        <input type="checkbox" class="" value="Alcohol">
                                                        Alcohol
                                                    </label>
                                                    <label class="btn btn-outline-primary habits" id="tobacco">
                                                        <input type="checkbox" class="" value="Tobacco">
                                                        Tobacco
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="medical-history">Medical History</label>
                                            <textarea class="form-control" id="medical-history" rows="5"
                                                placeholder="Enter dosage instructions" required></textarea>
                                            <div class="invalid-feedback">
                                                Please provide the dosage
                                                instructions.
                                            </div>
                                        </div>

                                        <div id="medicine-container"></div>
                                        <button type="button" class="btn btn-primary mt-3" id="add-medicine">
                                            Add Medicine
                                        </button>
                                    </div>
                                </div>
                                <div class="card">
                                    <div class="body">
                                        <div class="mb-3">
                                            <label for="electro_cg_check" class="form-label">Electro Cardiogram</label>
                                            <input type="checkbox" id="electro_cg_check" value="true">
                                            <div id="electro_cg_1_container">
                                                <input type="text" class="form-control"  name="electro_cg_1" id="electro_cg_1">
                                            </div>
                                            <div id="electro_cg_container" class="d-none">
                                                <textarea class="form-control" id="electro_cg" rows="3">
                                                &lt;h2 style="text-align: center; margin:125px 0 0 0"&gt;ECG Report&lt;/h2&gt;
                                                &lt;p&gt;&lt;strong&gt;Rate:&lt;/strong&gt; &lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Rhythm:&lt;/strong&gt; &lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Axis:&lt;/strong&gt; &lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;P waves:&lt;/strong&gt; &lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Q waves:&lt;/strong&gt; &lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;QRS complexes:&lt;/strong&gt; &lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;ST segments &amp; T waves:&lt;/strong&gt; &lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;QT interval:&lt;/strong&gt; &lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Conclusion:&lt;/strong&gt; &lt;/p&gt;
                                            </textarea>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label for="echo_cg_check" class="form-label">Echo Cardiogram</label>
                                            <input type="checkbox" id="echo_cg_check" value="true">
                                            <div id="echo_cg_1_container">
                                                <input type="text" class="form-control"  name="echo_cg_1" id="echo_cg_1">
                                            </div>
                                            <div id="echo_cg_container" class="d-none">

                                                <textarea class="form-control" id="echo_cg" rows="3">
                                                &lt;h2 style="text-align: center; margin:125px 0 0 0"&gt;Echo Cardiogram Report&lt;/h2&gt;
                                                &lt;p&gt;&lt;strong&gt;Left Ventricle (LV):&lt;/strong&gt; Normal size and wall thickness, good systolic function, ejection fraction (EF) ~XX%&lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Right Ventricle (RV):&lt;/strong&gt; Normal size and function&lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Left Atrium (LA):&lt;/strong&gt; Normal size&lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Right Atrium (RA):&lt;/strong&gt; Normal size&lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Aortic Valve:&lt;/strong&gt; Normal structure and function, no stenosis or regurgitation&lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Mitral Valve:&lt;/strong&gt; Normal structure and function, no stenosis or regurgitation&lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Tricuspid Valve:&lt;/strong&gt; Normal structure and function, no significant regurgitation&lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Pulmonary Valve:&lt;/strong&gt; Normal structure and function&lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Pericardium:&lt;/strong&gt; No pericardial effusion&lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Pulmonary Artery Pressure (PAP):&lt;/strong&gt; Normal (~XX mmHg)&lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Wall Motion Abnormalities:&lt;/strong&gt; None detected&lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Doppler Findings:&lt;/strong&gt; Normal blood flow velocities, no significant gradient&lt;/p&gt;
                                                &lt;p&gt;&lt;strong&gt;Conclusion:&lt;/strong&gt; Normal echocardiogram with no significant abnormalities&lt;/p&gt;
                                            </textarea>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card patients-list">
                                    <div class="body">
                                        <h5>Tests</h5>

                                        <!--Tests-->
                                        <div class="input-group mt-3">
                                            <input type="text" class="form-control" placeholder="Enter Test"
                                                id="customTest" />
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary" type="button"
                                                    onclick="addCustomTest()">
                                                    Add
                                                </button>
                                            </div>
                                        </div>
                                        <div class="form-group mt-3">
                                            <div class="input-group mt-3 mb-3">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="icon-magnifier"></i></span>
                                                </div>
                                                <input type="text" class="form-control" placeholder="Search tests"
                                                    id="searchInputTests" onkeyup="searchTests()" />
                                            </div>
                                            <div class="selected-buttons mb-3" id="selected-buttons-tests"></div>
                                            <div class="most-common" id="mostCommonButtons-tests"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card patients-list">
                                    <div class="body">
                                        <h5>Diagnosis</h5>

                                        <!-- Diagnosis -->
                                        <div class="input-group mt-3">
                                            <input type="text" class="form-control" placeholder="Enter Diagnosis"
                                                id="customDiagnosis" />
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary" type="button"
                                                    onclick="addCustomDiagnosis()">
                                                    Add
                                                </button>
                                            </div>
                                        </div>
                                        <div class="form-group mt-3">
                                            <div class="input-group mt-3 mb-3">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="icon-magnifier"></i></span>
                                                </div>
                                                <input type="text" class="form-control" placeholder="Search Diagnosis"
                                                    id="searchInputDiagnosis" onkeyup="searchDiagnosis()" />
                                            </div>
                                            <div class="selected-buttons mb-3" id="selected-buttons-diagnosis"></div>
                                            <div class="most-common" id="mostCommonButtons-diagnosis"></div>
                                            <div class="invalid-feedback">
                                                Please provide Diagnosis.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card patients-list">
                                    <div class="body">
                                        <h5>Advice</h5>

                                        <div class="input-group mt-3">
                                            <input type="text" class="form-control" placeholder="Enter Advice"
                                                id="customAdvice" />
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary" type="button"
                                                    onclick="addCustomAdvice()">
                                                    Add
                                                </button>
                                            </div>
                                        </div>
                                        <div class="form-group mt-3">
                                            <div class="input-group mt-3 mb-3">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="icon-magnifier"></i></span>
                                                </div>
                                                <input type="text" class="form-control" placeholder="Search Advice"
                                                    id="searchInputAdvice" onkeyup="searchAdvice()" />
                                            </div>
                                            <div class="selected-buttons mb-3" id="selected-buttons-advice"></div>
                                            <div class="most-common" id="mostCommonButtons-advice"></div>
                                        </div>

                                        <div class="d-flex justify-content-start mt-3 mb-3">

                                            <button type="submit" class="btn btn-primary m-1" id="submitBtn">
                                                Save and Print
                                            </button>
                                            <button type="button" class="btn btn-secondary m-1" id="updatePrescription">
                                                Save
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
    </div>

    <!-- Javascript -->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>

    <!-- page vendor js file -->
    <script src="../dist/assets/bundles/apexcharts.bundle.js"></script>

    <!-- page js file -->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../../js/hospital/index.js"></script>
    <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>
    <script src="../dist/assets/js/select2.min.js"></script>

    <script src="../richtexteditor/rte.js"></script>
    <script src="../richtexteditor/plugins/all_plugins.js"></script>
    <script>
        var editor1 = new RichTextEditor("#electro_cg", { toolbar: "basic" });
        var editor2 = new RichTextEditor("#echo_cg", { toolbar: "basic" });
        document.getElementById('bp').addEventListener('input', function (e) {
            let value = e.target.value.replace(/\D/g, ''); // Remove non-digit characters
            if (value.length > 3) {
                value = value.slice(0, 3) + '/' + value.slice(3, 6);
            }
            e.target.value = value;
        });
        var prescriptionId;

        let medicineCount = 0;

        // Function to add a new set of fields
        function addMedicineFields() {
            medicineCount++;

            let fieldHTML = `
        <div class="form-row align-items-end" id="medicine-${medicineCount}">
            <div class="form-group col-md-3">
                <label for="medicine-${medicineCount}-name">Medicine</label>
                <select class="form-control" id="medicine-${medicineCount}-name" name="medicine[${medicineCount}][name]" required>
                    <option value="" disabled selected></option>
                </select>
            </div>
            <div class="form-group col-md-1">
                <label for="medicine-${medicineCount}-nos">Nos</label>
                <input type="number" class="form-control" id="medicine-${medicineCount}-nos" name="medicine[${medicineCount}][nos]" required>
            </div>
           
            <div class="form-group col-md-7" id="medicine-${medicineCount}-standard-fields">
                <div class="row">
                    <div class="col-auto">
                        <label for="medicine-${medicineCount}-dose-qty">Dose Qty</label>
                        <input type="number" class="form-control" id="medicine-${medicineCount}-dose-qty" 
                               name="medicine[${medicineCount}][dose_qty]" required step="0.1">
                    </div>
                    <div class="col-auto">
                        <label>Doses</label>
                        <div class="doses-group">
                            <div class="btn-group btn-group-toggle" data-toggle="buttons">
                                <label class="btn btn-outline-primary">
                                    <input type="checkbox" id="medicine-${medicineCount}-morning" 
                                           name="medicine[${medicineCount}][doses][morning]" value="morning"> Morning
                                </label>
                                <label class="btn btn-outline-primary">
                                    <input type="checkbox" id="medicine-${medicineCount}-afternoon" 
                                           name="medicine[${medicineCount}][doses][afternoon]" value="afternoon"> Afternoon
                                </label>
                                <label class="btn btn-outline-primary">
                                    <input type="checkbox" id="medicine-${medicineCount}-evening" 
                                           name="medicine[${medicineCount}][doses][evening]" value="evening"> Evening
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-auto">
                        <label>Timing</label>
                        <div class="btn-group btn-group-toggle d-flex" data-toggle="buttons">
                            <label class="btn btn-outline-secondary flex-fill">
                                <input type="radio" id="medicine-${medicineCount}-after" 
                                       name="medicine[${medicineCount}][timing]" value="After" required> After
                            </label>
                            <label class="btn btn-outline-secondary flex-fill">
                                <input type="radio" id="medicine-${medicineCount}-before" 
                                       name="medicine[${medicineCount}][timing]" value="Before"> Before
                            </label>
                            <label class="btn btn-outline-secondary flex-fill">
                                <input type="radio" id="medicine-${medicineCount}-with" 
                                       name="medicine[${medicineCount}][timing]" value="With"> With
                            </label>
                            <label class="btn btn-outline-secondary flex-fill">
                                <input type="radio" id="medicine-${medicineCount}-if-required" 
                                       name="medicine[${medicineCount}][timing]" value="If Required"> If Required
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group col-md-7" id="medicine-${medicineCount}-custom-fields" style="display: none;">
                <div class="row">
                    <div class="col-md-12">
                        <label for="medicine-${medicineCount}-custom-doses">Custom Dose Instructions</label>
                        <input type="text" class="form-control" id="medicine-${medicineCount}-custom-doses" 
                               name="medicine[${medicineCount}][custom_doses]" placeholder="Enter custom dose instructions">
                    </div>
                </div>
            </div>
            <div class="form-group col-md-1">
                <button type="button" class="btn btn-danger btn-remove-medicine">Remove</button>
            </div>
             <div class="form-group col-md-12">
                <label for="medicine-${medicineCount}-is-custom">Custom</label>
                    <input class="" type="checkbox" id="medicine-${medicineCount}-is-custom" 
                           name="medicine[${medicineCount}][is_custom]" onchange="toggleCustomDose(${medicineCount})">
            </div>
            
        </div>
    `;

            $("#medicine-container").append(fieldHTML);

            // Populate the medicine dropdown
            medList.map((item) => {
                var option = new Option(item.name, item.name);
                $(`#medicine-${medicineCount}-name`).append(option);
            });

            // Initialize Select2
            $(`#medicine-${medicineCount}-name`).select2({
                placeholder: "Select or add a medicine",
                tags: true,
                allowClear: true,
                createTag: function (params) {
                    var term = $.trim(params.term);
                    if (term === "") {
                        return null;
                    }
                    return {
                        id: term,
                        text: term,
                        newTag: true,
                    };
                },
            });

            function setSelect2SearchBoxValue(e) {
                var select2Data = $(e.target).select2("data");
                if (select2Data.length > 0) {
                    var selectedText = select2Data[0].text;

                    // Access the search box and set its value
                    var searchBox =
                        $(e.target).data("select2").dropdown.$search ||
                        $(e.target).data("select2").selection.$search;
                    searchBox.val(selectedText);
                    searchBox.trigger("keyup");
                }
            }

            // Bind the function to the select2:open event
            $(`#medicine-${medicineCount}-name`).on("select2:open", setSelect2SearchBoxValue);

            // Handle medicine change event
            $(`#medicine-${medicineCount}-name`).change(() => {
                var selectedMedicine = $(
                    `#medicine-${medicineCount}-name`
                ).val();
                medList.map((item) => {
                    if (item.name === selectedMedicine) {
                        $(`#medicine-${medicineCount}-nos`).val(item.qty);
                        $(`#medicine-${medicineCount}-dose-qty`).val(
                            item.dose_qty
                        );
                        $(`#medicine-${medicineCount}-morning`).prop(
                            "checked",
                            false
                        );
                        $(`#medicine-${medicineCount}-afternoon`).prop(
                            "checked",
                            false
                        );
                        $(`#medicine-${medicineCount}-evening`).prop(
                            "checked",
                            false
                        );

                        // Set checkboxes based on doses string
                        const doses = item.doses
                            .split(",")
                            .map((dose) => dose.trim());
                        doses.forEach((dose) => {
                            $(`#medicine-${medicineCount}-${dose}`).prop(
                                "checked",
                                true
                            );
                        });

                        // Ensure Bootstrap button styles are updated
                        $(
                            `#medicine-${medicineCount} .btn-group-toggle input[type="checkbox"]`
                        ).each(function () {
                            if ($(this).prop("checked")) {
                                $(this).closest("label").addClass("active");
                            } else {
                                $(this)
                                    .closest("label")
                                    .removeClass("active");
                            }
                        });

                        // Set radio buttons
                        $(
                            `input[name='medicine[${medicineCount}][timing]'][value='${item.timing}']`
                        ).prop("checked", true);

                        // Ensure Bootstrap button styles are updated
                        $(
                            `#medicine-${medicineCount} .btn-group-toggle input[type="radio"]`
                        ).each(function () {
                            if ($(this).prop("checked")) {
                                $(this).closest("label").addClass("active");
                            } else {
                                $(this)
