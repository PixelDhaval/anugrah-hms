        function fetchDiagnosis(diagnosisList) {
            fetch("/prescription/fetch-diagnosis")
                .then((response) => response.json())
                .then((diagnosisData) => {
                    const container = document.getElementById(
                        "mostCommonButtons-diagnosis"
                    );
                    container.innerHTML = "";

                    diagnosisData.forEach((diagnosisObj) => {
