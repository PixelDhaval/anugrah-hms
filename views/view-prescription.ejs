        function addButton(button, selectedButtonsId, mostCommonButtonsId) {
            button.type = "button"; // Ensure the button does not submit the form
            button.addEventListener("click", function (event) {
                event.preventDefault(); // Prevent form submission

                const selectedButtonsDiv =
                    document.getElementById(selectedButtonsId);
                const buttonText = button.innerText;

                const existingButton = Array.from(
                    selectedButtonsDiv.children
                ).find((child) => child.innerText === buttonText);
                if (existingButton) {
                    selectedButtonsDiv.removeChild(existingButton);
                    button.classList.remove(
                        "btn-secondary",
                        "selected-button"
                    );
                    button.classList.add("btn-outline-secondary");
                    button.style.color = "";
                } else {
                    const newButton = document.createElement("button");
                    newButton.className =
                        "btn btn-secondary selected-button m-1";
                    newButton.innerText = buttonText;
                    newButton.onclick = function () {
                        selectedButtonsDiv.removeChild(newButton);
                        const originalButton = Array.from(
                            document.querySelectorAll(
                                `#${mostCommonButtonsId} button`
                            )
                        ).find((btn) => btn.innerText === buttonText);
                        if (originalButton) {
                            originalButton.classList.remove(
                                "btn-secondary",
                                "selected-button"
                            );
                            originalButton.classList.add(
                                "btn-outline-secondary"
                            );
                            originalButton.style.color = "";
                        }
                    };
                    selectedButtonsDiv.appendChild(newButton);
                    button.classList.remove("btn-outline-secondary");
                    button.classList.add(
                        "btn-secondary",
                        "selected-button"
                    );
                    button.style.color = "white";
                }
            });
        }

