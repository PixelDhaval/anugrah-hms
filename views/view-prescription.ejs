        function getSelectedHabits() {
            // Array to store selected habits
            var result = [];

            // Select all habit checkboxes by class name
            var checkboxes = document.querySelectorAll(".habits");

            // Iterate through each checkbox and check if it's selected
            checkboxes.forEach(function (checkbox) {
                if (checkbox.classList.contains("active")) {

                    result.push(checkbox.innerText);
                }
            });

            // Convert the array to a comma-separated string
            return result.join(", ");
        }

