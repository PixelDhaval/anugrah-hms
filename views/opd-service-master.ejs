    <!--page js file-->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>
    <script src="../dist/assets/js/tabulator.min.js"></script>
    <script>
        let serviceData = [];
        document.addEventListener('DOMContentLoaded', () => {
            loadServices();
            fetchNextServiceCode();
        });

        function serviceExists(serviceName) {
            return serviceData.some(service => {
                if (typeof service.service === 'string') {
                    return service.service.toLowerCase() === serviceName.toLowerCase();
                } else {
                    console.error('Service name is not a string:', service.service);
                    return false; 
                }
            });
        }
        
        document.getElementById('addServiceForm').addEventListener('submit', function (e) {
            e.preventDefault(); 

            const code = document.getElementById('code').value;
            const service = document.getElementById('service').value;
            const rateForNewPatient = parseFloat(document.getElementById('rateForNewPatient').value);
            const rateForOldPatient = parseFloat(document.getElementById('rateForOldPatient').value);

            // Form Validation
            if (!this.checkValidity() || rateForNewPatient < 0 || rateForOldPatient < 0) {
                e.stopPropagation();
                this.classList.add('was-validated');
                if (rateForNewPatient < 0) {
                    document.getElementById('rateForNewPatient').classList.add('is-invalid');
                } else {
                    document.getElementById('rateForNewPatient').classList.remove('is-invalid');
                }
                if (rateForOldPatient < 0) {
                    document.getElementById('rateForOldPatient').classList.add('is-invalid');
                } else {
                    document.getElementById('rateForOldPatient').classList.remove('is-invalid');
                }
                return;
            }

            // If rates are positive - reset validation classes
            document.getElementById('rateForNewPatient').classList.remove('is-invalid');
            document.getElementById('rateForOldPatient').classList.remove('is-invalid');

            
            if (serviceExists(service)) {
                alert("Service already exists!");
                return;
            }
            else{
            // Add new service to local array
            const newService = { code, service, rateForNewPatient, rateForOldPatient };
            serviceData.push(newService); 
                    
            // Send data to the server to add new service
            fetch('/add-service', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(newService)
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Failed to add service'); 
                }
                return response.json();
            })
            .then(data => {
                loadServices();
                fetchNextServiceCode();
                this.reset();
                this.classList.remove('was-validated'); 
            })
            .catch(error => {
                console.error('Error adding service:', error); 
                alert('Failed to add service. Please try again.'); 
            });
        }
        });

        document.getElementById('saveEditChangesBtn').addEventListener('click', function () {
            const code = document.getElementById('editCode').value;
            const service = document.getElementById('editService').value;
            const rateForNewPatient = parseFloat(document.getElementById('editRateForNewPatient').value);
            const rateForOldPatient = parseFloat(document.getElementById('editRateForOldPatient').value);
        
            if (rateForNewPatient < 0 || rateForOldPatient < 0) {
                if (rateForNewPatient < 0) {
                    document.getElementById('editRateForNewPatient').classList.add('is-invalid');
                } else {
                    document.getElementById('editRateForNewPatient').classList.remove('is-invalid');
                }
                if (rateForOldPatient < 0) {
                    document.getElementById('editRateForOldPatient').classList.add('is-invalid');
                } else {
                    document.getElementById('editRateForOldPatient').classList.remove('is-invalid');
                }
                return;
            }
        
            // Rates positive - reset
            document.getElementById('editRateForNewPatient').classList.remove('is-invalid');
            document.getElementById('editRateForOldPatient').classList.remove('is-invalid');
            const updatedService = { code, service, rateForNewPatient, rateForOldPatient };
            fetch(`/update-services/${code}`, { 
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(updatedService)
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Failed to update service');
                }
                return response.json();
            })
            .then(data => {
                
                loadServices(); 
                var editModal = bootstrap.Modal.getInstance(document.getElementById('editServiceModal'));
                editModal.hide();
            })
            .catch(error => {
                console.error('Error updating service:', error);
                alert('Failed to update service. Please try again.');
            });
        });
        
        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            const rowId = this.dataset.rowId; 
        
            // Send delete request to backend
            fetch(`/delete-service/${rowId}`, {
                method: 'DELETE',
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Failed to delete service');
                }
                return response.json();
            })
            .then(data => {
                
               
                loadServices(); 
            })
            .catch(error => {
                console.error('Error deleting service:', error);
                alert('Failed to delete service. Please try again.');
            });
        
            var deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteServiceModal'));
            deleteModal.hide();
        });
        
        
        // Function to fetch and load services
        const loadServices = async () => {
            try {
                const response = await fetch('/services');
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                const serviceData = await response.json();
        
                // Initialize Tabulator with fetched data
                const table = new Tabulator("#service-table", {
                    data: serviceData,
                    layout: "fitColumns",
                    columns: [
                        { title: "Code", field: "code", headerHozAlign: "center" },
                        { title: "Service", field: "opd_service", headerFilter: "input", headerHozAlign: "center" },
                        { title: "Rate For New Patient", field: "new_patient", headerHozAlign: "center" },
                        { title: "Rate For Old Patient", field: "old_patient", headerHozAlign: "center" },
                        {
                            title: "Actions",
                            field: "actions",
                            headerHozAlign: "center",
                            formatter: function (cell, formatterParams, onRendered) {
                                return `<button class="btn btn-sm btn-primary edit-btn"><i class="fa fa-pencil"></i> Edit</button>
                                        <button class="btn btn-sm btn-danger delete-btn"><i class="fa fa-trash"></i> Delete</button>`;
                            },
                            cellClick: function (e, cell) {
                                var data = cell.getRow().getData();
                                if (e.target.classList.contains('edit-btn')) {
                                    document.getElementById('editCode').value = data.code;
                                    document.getElementById('editService').value = data.opd_service;
                                    document.getElementById('editRateForNewPatient').value = data.new_patient;
                                    document.getElementById('editRateForOldPatient').value = data.old_patient;
        
                                    document.getElementById('editServiceForm').dataset.rowId = data.code;
        
                                    var editModal = new bootstrap.Modal(document.getElementById('editServiceModal'));
                                    editModal.show();
                                } else if (e.target.classList.contains('delete-btn')) {
                                    var deleteModal = new bootstrap.Modal(document.getElementById('deleteServiceModal'));
                                    document.getElementById('confirmDeleteBtn').dataset.rowId = data.code;
                                    deleteModal.show();
                                }
                            }
                        }
                    ]
                });
            } catch (error) {
                console.error('Error fetching services:', error);
            }
        };
        function fetchNextServiceCode(){
            // Fetch the next service code
            fetch('/get-next-service-code')
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                document.getElementById('code').value = data.nextServiceId;
            })
            .catch(error => {
                console.error('Error fetching next service ID:', error); 
            });
        }
    </script>
</body>

</html>