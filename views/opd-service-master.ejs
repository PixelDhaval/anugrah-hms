<!DOCTYPE html>
<html lang="en">
    <head>
        <title>AHMS :: OPD Service Master</title>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, shrink-to-fit=no"
        />
        <meta
            name="description"
            content="Iconic Bootstrap 4.5.0 Admin Template"
        />
        <meta name="author" content="WrapTheme, design by: ThemeMakker.com" />

        <link rel="icon" href="favicon.ico" type="image/x-icon" />
        <!-- VENDOR CSS -->
        <link rel="stylesheet" href="../dist/assets/css/bootstrap.min.css" />
        <link
            rel="stylesheet"
            href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css"
        />
        <link
            rel="stylesheet"
            href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css"
        />
        <link
            rel="stylesheet"
            href="../dist/assets/vendor/bootstrap-datepicker/css/bootstrap-datepicker3.min.css"
        />

        <!-- MAIN CSS -->
        <link rel="stylesheet" href="../dist/assets/css/main.css" />
        <link
            rel="stylesheet"
            href="../dist/assets/css/tabulator_bootstrap5.css"
        />

        <style>
            .tabulator {
                font-size: 12px;
                text-align: center;
            }
        </style>
    </head>

    <body data-theme="light" class="font-nunito">
        <div id="wrapper" class="theme-cyan">
            <%- include('navbar') %>


            <!-- main page content body part -->
            <div id="main-content">
                <div class="container-fluid">
                    <div class="block-header">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-12">
                                <h2>OPD Service Master</h2>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="/index"
                                            ><i class="fa fa-dashboard"></i
                                        ></a>
                                    </li>
                                    <li class="breadcrumb-item">Master</li>
                                    <li class="breadcrumb-item active">
                                        OPD Service Master
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="row clearfix">
                        <div class="col-lg-12 col-md-12 col-sm-12">
                            <div class="card mt-4">
                                <div class="header">
                                    <h2>Add Service</h2>
                                </div>
                                <div class="body">
                                    <form id="addServiceForm" novalidate>
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label
                                                    for="code"
                                                    class="form-label"
                                                    >Code</label
                                                >
                                                <input
                                                    type="text"
                                                    class="form-control"
                                                    id="code"
                                                    readonly
                                                />
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label
                                                    for="service"
                                                    class="form-label"
                                                    >Service</label
                                                >
                                                <input
                                                    type="text"
                                                    class="form-control"
                                                    id="service"
                                                    required
                                                />
                                                <div class="invalid-feedback">
                                                    Please provide a service
                                                    name.
                                                </div>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label
                                                    for="rateForNewPatient"
                                                    class="form-label"
                                                    >Rate For New Patient</label
                                                >
                                                <input
                                                    type="number"
                                                    class="form-control"
                                                    id="rateForNewPatient"
                                                    required
                                                />
                                                <div class="invalid-feedback">
                                                    Please provide a rate for
                                                    new patients.
                                                </div>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label
                                                    for="rateForOldPatient"
                                                    class="form-label"
                                                    >Rate For Old Patient</label
                                                >
                                                <input
                                                    type="number"
                                                    class="form-control"
                                                    id="rateForOldPatient"
                                                    required
                                                />
                                                <div class="invalid-feedback">
                                                    Please provide a rate for
                                                    old patients.
                                                </div>
                                            </div>
                                        </div>
                                        <button
                                            type="submit"
                                            class="btn btn-primary"
                                        >
                                            Submit
                                        </button>
                                        <button
                                            type="reset"
                                            class="btn btn-secondary"
                                        >
                                            Cancel
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row clearfix">
                        <div class="col-lg-12 col-md-12 col-sm-12">
                            <div class="card mt-3">
                                <div class="header">
                                    <h2>Manage Services</h2>
                                </div>
                                <div class="body">
                                    <div id="service-table"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!--Edit Service Modal-->
                    <div
                        class="modal fade"
                        id="editServiceModal"
                        tabindex="-1"
                        aria-labelledby="editServiceModalLabel"
                        aria-hidden="true"
                    >
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5
                                        class="modal-title"
                                        id="editServiceModalLabel"
                                    >
                                        Edit Service Details
                                    </h5>
                                    <button
                                        type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Close"
                                    ></button>
                                </div>
                                <div class="modal-body">
                                    <form id="editServiceForm" novalidate>
                                        <div class="mb-3">
                                            <label
                                                for="editCode"
                                                class="form-label"
                                                >Code</label
                                            >
                                            <input
                                                type="text"
                                                class="form-control"
                                                id="editCode"
                                                readonly
                                            />
                                        </div>
                                        <div class="mb-3">
                                            <label
                                                for="editService"
                                                class="form-label"
                                                >Service</label
                                            >
                                            <input
                                                type="text"
                                                class="form-control"
                                                id="editService"
                                                required
                                            />
                                            <div class="invalid-feedback">
                                                Please provide a service name.
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label
                                                for="editRateForNewPatient"
                                                class="form-label"
                                                >Rate For New Patient</label
                                            >
                                            <input
                                                type="number"
                                                class="form-control"
                                                id="editRateForNewPatient"
                                                required
                                            />
                                            <div class="invalid-feedback">
                                                Please provide a rate for new
                                                patients.
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label
                                                for="editRateForOldPatient"
                                                class="form-label"
                                                >Rate For Old Patient</label
                                            >
                                            <input
                                                type="number"
                                                class="form-control"
                                                id="editRateForOldPatient"
                                                required
                                            />
                                            <div class="invalid-feedback">
                                                Please provide a rate for old
                                                patients.
                                            </div>
                                        </div>
                                    </form>
                                </div>
                                <div class="modal-footer">
                                    <button
                                        type="button"
                                        class="btn btn-secondary"
                                        data-bs-dismiss="modal"
                                    >
                                        Close
                                    </button>
                                    <button
                                        type="button"
                                        class="btn btn-primary"
                                        id="saveEditChangesBtn"
                                    >
                                        Save changes
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!--Delete Service Modal-->
                    <div
                        class="modal fade"
                        id="deleteServiceModal"
                        tabindex="-1"
                        aria-labelledby="deleteServiceModalLabel"
                        aria-hidden="true"
                    >
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5
                                        class="modal-title"
                                        id="deleteServiceModalLabel"
                                    >
                                        Delete Service
                                    </h5>
                                    <button
                                        type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Close"
                                    ></button>
                                </div>
                                <div class="modal-body">
                                    Are you sure you want to delete this
                                    service?
                                </div>
                                <div class="modal-footer">
                                    <button
                                        type="button"
                                        class="btn btn-secondary"
                                        data-bs-dismiss="modal"
                                    >
                                        Close
                                    </button>
                                    <button
                                        type="button"
                                        class="btn btn-danger"
                                        id="confirmDeleteBtn"
                                    >
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--Javascript-->
        <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
        <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>
        <script src="../dist/assets/vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>

        <!--page js file-->
        <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
        <script src="../dist/assets/js/bootstrap.bundle.min.js"></script>
        <script src="../dist/assets/js/tabulator.min.js"></script>
        <script>
document.addEventListener("DOMContentLoaded", () => {
            fetch('get-user-name')
            .then(response => response.json())
            .then(data => {
                document.getElementById("login-name").innerHTML = data.name
                if(data.gender == "female"){
                    document.getElementById("login-img").src = "../dist/assets/images/user-f.jpg"
                } else if (data.gender == "male"){
                document.getElementById("login-img").src = "../dist/assets/images/user-m.jpg"

                }
            })
        })
            let serviceData = [];
            document.addEventListener("DOMContentLoaded", () => {
                loadServices();
                fetchNextServiceCode();
            });

            function serviceExists(serviceName) {
                return serviceData.some((service) => {
                    if (typeof service.service === "string") {
                        return (
                            service.service.toLowerCase() ===
                            serviceName.toLowerCase()
                        );
                    } else {
                        console.error(
                            "Service name is not a string:",
                            service.service
                        );
                        return false;
                    }
                });
            }

            document
                .getElementById("addServiceForm")
                .addEventListener("submit", function (e) {
                    e.preventDefault();

                    const code = document.getElementById("code").value;
                    const service = document.getElementById("service").value;
                    const rateForNewPatient = parseFloat(
                        document.getElementById("rateForNewPatient").value
                    );
                    const rateForOldPatient = parseFloat(
                        document.getElementById("rateForOldPatient").value
                    );

                    // Form Validation
                    if (
                        !this.checkValidity() ||
                        rateForNewPatient < 0 ||
                        rateForOldPatient < 0
                    ) {
                        e.stopPropagation();
                        this.classList.add("was-validated");
                        if (rateForNewPatient < 0) {
                            document
                                .getElementById("rateForNewPatient")
                                .classList.add("is-invalid");
                        } else {
                            document
                                .getElementById("rateForNewPatient")
                                .classList.remove("is-invalid");
                        }
                        if (rateForOldPatient < 0) {
                            document
                                .getElementById("rateForOldPatient")
                                .classList.add("is-invalid");
                        } else {
                            document
                                .getElementById("rateForOldPatient")
                                .classList.remove("is-invalid");
                        }
                        return;
                    }

                    // If rates are positive - reset validation classes
                    document
                        .getElementById("rateForNewPatient")
                        .classList.remove("is-invalid");
                    document
                        .getElementById("rateForOldPatient")
                        .classList.remove("is-invalid");

                    if (serviceExists(service)) {
                        alert("Service already exists!");
                        return;
                    } else {
                        const newService = {
                            code,
                            service,
                            rateForNewPatient,
                            rateForOldPatient,
                        };
                        serviceData.push(newService);

                        // Send data to the server to add new service
                        fetch("/add-service", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                            },
                            body: JSON.stringify(newService),
                        })
                            .then((response) => {
                                if (!response.ok) {
                                    throw new Error("Failed to add service");
                                }
                                return response.json();
                            })
                            .then((data) => {
                                loadServices();
                                fetchNextServiceCode();
                                this.reset();
                                this.classList.remove("was-validated");
                            })
                            .catch((error) => {
                                console.error("Error adding service:", error);
                                alert(
                                    "Failed to add service. Please try again."
                                );
                            });
                    }
                });

            document
                .getElementById("saveEditChangesBtn")
                .addEventListener("click", function () {
                    const code = document.getElementById("editCode").value;
                    const service =
                        document.getElementById("editService").value;
                    const rateForNewPatient = parseFloat(
                        document.getElementById("editRateForNewPatient").value
                    );
                    const rateForOldPatient = parseFloat(
                        document.getElementById("editRateForOldPatient").value
                    );

                    if (rateForNewPatient < 0 || rateForOldPatient < 0) {
                        if (rateForNewPatient < 0) {
                            document
                                .getElementById("editRateForNewPatient")
                                .classList.add("is-invalid");
                        } else {
                            document
                                .getElementById("editRateForNewPatient")
                                .classList.remove("is-invalid");
                        }
                        if (rateForOldPatient < 0) {
                            document
                                .getElementById("editRateForOldPatient")
                                .classList.add("is-invalid");
                        } else {
                            document
                                .getElementById("editRateForOldPatient")
                                .classList.remove("is-invalid");
                        }
                        return;
                    }

                    // Rates positive - reset
                    document
                        .getElementById("editRateForNewPatient")
                        .classList.remove("is-invalid");
                    document
                        .getElementById("editRateForOldPatient")
                        .classList.remove("is-invalid");
                    const updatedService = {
                        code,
                        service,
                        rateForNewPatient,
                        rateForOldPatient,
                    };
                    fetch(`/update-services/${code}`, {
                        method: "PUT",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(updatedService),
                    })
                        .then((response) => {
                            if (!response.ok) {
                                throw new Error("Failed to update service");
                            }
                            return response.json();
                        })
                        .then((data) => {
                            loadServices();
                            var editModal = bootstrap.Modal.getInstance(
                                document.getElementById("editServiceModal")
                            );
                            editModal.hide();
                        })
                        .catch((error) => {
                            console.error("Error updating service:", error);
                            alert(
                                "Failed to update service. Please try again."
                            );
                        });
                });

            document
                .getElementById("confirmDeleteBtn")
                .addEventListener("click", function () {
                    const rowId = this.dataset.rowId;

                    // Send delete request to backend
                    fetch(`/delete-service/${rowId}`, {
                        method: "DELETE",
                    })
                        .then((response) => {
                            if (!response.ok) {
                                throw new Error("Failed to delete service");
                            }
                            return response.json();
                        })
                        .then((data) => {
                            fetchNextServiceCode();
                            loadServices();
                        })
                        .catch((error) => {
                            console.error("Error deleting service:", error);
                            alert(
                                "Failed to delete service. Please try again."
                            );
                        });

                    var deleteModal = bootstrap.Modal.getInstance(
                        document.getElementById("deleteServiceModal")
                    );
                    deleteModal.hide();
                });

            // Function to fetch and load services
            const loadServices = async () => {
                try {
                    const response = await fetch("/services");
                    if (!response.ok) {
                        throw new Error("Network response was not ok");
                    }
                    const serviceData = await response.json();

                    // Initialize Tabulator with fetched data
                    const table = new Tabulator("#service-table", {
                        data: serviceData,
                        layout: "fitColumns",
                        columns: [
                            {
                                title: "Code",
                                field: "code",
                                headerHozAlign: "center",
                            },
                            {
                                title: "Service",
                                field: "opd_service",
                                headerHozAlign: "center",
                            },
                            {
                                title: "Rate For New Patient",
                                field: "new_patient",
                                headerHozAlign: "center",
                            },
                            {
                                title: "Rate For Old Patient",
                                field: "old_patient",
                                headerHozAlign: "center",
                            },
                            {
                                title: "Actions",
                                field: "actions",
                                headerHozAlign: "center",
                                formatter: function (
                                    cell,
                                    formatterParams,
                                    onRendered
                                ) {
                                    return `<button class="btn btn-sm btn-primary edit-btn"><i class="fa fa-pencil"></i> Edit</button>
                                        <button class="btn btn-sm btn-danger delete-btn"><i class="fa fa-trash"></i> Delete</button>`;
                                },
                                cellClick: function (e, cell) {
                                    var data = cell.getRow().getData();
                                    if (
                                        e.target.classList.contains("edit-btn")
                                    ) {
                                        document.getElementById(
                                            "editCode"
                                        ).value = data.code;
                                        document.getElementById(
                                            "editService"
                                        ).value = data.opd_service;
                                        document.getElementById(
                                            "editRateForNewPatient"
                                        ).value = data.new_patient;
                                        document.getElementById(
                                            "editRateForOldPatient"
                                        ).value = data.old_patient;

                                        document.getElementById(
                                            "editServiceForm"
                                        ).dataset.rowId = data.code;

                                        var editModal = new bootstrap.Modal(
                                            document.getElementById(
                                                "editServiceModal"
                                            )
                                        );
                                        editModal.show();
                                    } else if (
                                        e.target.classList.contains(
                                            "delete-btn"
                                        )
                                    ) {
                                        var deleteModal = new bootstrap.Modal(
                                            document.getElementById(
                                                "deleteServiceModal"
                                            )
                                        );
                                        document.getElementById(
                                            "confirmDeleteBtn"
                                        ).dataset.rowId = data.code;
                                        deleteModal.show();
                                    }
                                },
                            },
                        ],
                    });
                } catch (error) {
                    console.error("Error fetching services:", error);
                }
            };
            function fetchNextServiceCode() {
                // Fetch the next service code
                fetch("/get-next-service-code")
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error("Network response was not ok");
                        }
                        return response.json();
                    })
                    .then((data) => {
                        document.getElementById("code").value =
                            data.nextServiceId;
                    })
                    .catch((error) => {
                        console.error("Error fetching next service ID:", error);
                    });
            }
        </script>
    </body>
</html>
