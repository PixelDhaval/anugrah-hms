<!doctype html>
<html lang="en">

<head>
    <title>AHMS :: Patient Complaints</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Iconic Bootstrap 4.5.0 Admin Template">
    <meta name="author" content="WrapTheme, design by: ThemeMakker.com">
    <link rel="icon" href="favicon.ico" type="image/x-icon">

    <!-- VENDOR CSS -->
    <link rel="stylesheet" href="/dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/assets/vendor/font-awesome/css/font-awesome.min.css">

    <!-- MAIN Project CSS file -->
    <link rel="stylesheet" href="../dist/assets/css/main.css">
</head>

<body data-theme="light" class="font-nunito">
    <div id="wrapper" class="theme-cyan">

        <%- include('navbar') %>



        <!-- main page content body part -->
        <div id="main-content">
            <div class="container-fluid">
                
                <div class="block-header">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <h2>Complaints</h2>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a href="index.html"><i class="fa fa-dashboard"></i></a>
                                </li>
                                <li class="breadcrumb-item">Complaints</li>
                            </ul>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12"></div>
                    </div>
                </div>

                <div class="row clearfix">
                    
                    <div class="col-md-12">
                        <div class="card patients-list">
                            <div class="header">
                                <h2>Add Complaints</h2>
                            </div>
                            
                            <div class="row container align-items-end">
                                <div class="col-md-4">
                                    <label
                                        for="weight"
                                        class="form-label"
                                        >Weight</label
                                    >
                                    <input
                                        type="number"
                                        
                                        class="form-control"
                                        id="weight"
                                        name="weight"
                                    
                                    />
                                    
                                </div>
                            </div>
                                <div class="container my-3 row">
                                <div class="col-md-2">
                                    <div class="input-group">
                                        <span class="input-group-text" id="">BP</span>
                                        <input type="text" class="form-control" id="bp">
                                      </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="input-group">
                                        <span class="input-group-text" id="">Pulse</span>
                                        <input type="text" class="form-control" id="pulse">
                                      </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="input-group">
                                        <span class="input-group-text" id="">SpO2</span>
                                        <input type="text" class="form-control" id="spo2">
                                      </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="input-group">
                                        <span class="input-group-text" id="">Temp</span>
                                        <input type="text" class="form-control" id="temp">
                                        <span class="input-group-text" id="">C</span>

                                      </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="input-group">
                                        <span class="input-group-text" id="">Sugar</span>
                                        <input type="text" class="form-control" id="sugar">

                                      </div>
                                </div>
                            </div>
                            <div class="container mt-3 col-sm-12">

                                <h5>Most Common</h5>
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Enter New Complaint"
                                        id="customComplaint">
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary" type="button"
                                            onclick="addCustomComplaint()">Add</button>
                                    </div>
                                </div>

                                <div class="input-group mt-3 mb-3">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="icon-magnifier"></i></span>
                                    </div>
                                    <input type="text" class="form-control" placeholder="Search Complaint"
                                        id="searchInput" onkeyup="searchComplaints()">
                                </div>
                                <div class="selected-buttons mb-3"></div>

                                <div class="most-common" id="mostCommonButtons">
                                    
                                </div>

                                <div class="d-flex justify-content-start mt-3 mb-3">
                                    <!-- <a href="/manage-appointment" class="btn btn-primary" role="button" id="submit-complaints" onclick="submitComplaints()">Submit</a> -->
                                     <button class="btn btn-primary"  id="submit-complaints" onclick="submitComplaints()">Submit</button>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Javascript-->
    <script src="../dist/assets/bundles/libscripts.bundle.js"></script>
    <script src="../dist/assets/bundles/vendorscripts.bundle.js"></script>

    <!-- page vendor js file -->
    <script src="../dist/assets/bundles/apexcharts.bundle.js"></script>

    <!-- page js file -->
    <script src="../dist/assets/bundles/mainscripts.bundle.js"></script>
    <script src="../../js/hospital/index.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            fetch('get-user-name')
            .then(response => response.json())
            .then(data => {
                document.getElementById("login-name").innerHTML = data.name
                if(data.gender == "female"){
                    document.getElementById("login-img").src = "../dist/assets/images/user-f.jpg"
                } else if (data.gender == "male"){
                document.getElementById("login-img").src = "../dist/assets/images/user-m.jpg"

                }
            })
        })

        function getUrlParameter(name) {
            const queryString = window.location.search.substring(1);
            const params = queryString.split('&');
            
            for (let i = 0; i < params.length; i++) {
                const pair = params[i].split('=');
                if (pair[0] === name) {
                    return decodeURIComponent(pair[1].replace(/\+/g, ' '));
                }
            }
            return null;
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            fetchComplaints();
            const patientId = getUrlParameter('patientId');
            const doctorId = getUrlParameter('doctorId');
            const weight = getUrlParameter('w');
            $("#weight").val(weight)
    
            console.log('doctor id:' + doctorId);
            console.log('patient id:' + patientId);
        });
    
        function addButton(button) {
            const selectedButtonsDiv = document.querySelector('.selected-buttons');
            const buttonText = button.innerText;
    
            const existingButton = Array.from(selectedButtonsDiv.children).find(child => child.innerText === buttonText);
            if (existingButton) {
                selectedButtonsDiv.removeChild(existingButton);
                button.classList.remove('btn-secondary');
                button.classList.add('btn-outline-secondary');
            } else {
                const newButton = document.createElement('button');
                newButton.className = 'btn btn-secondary selected-button mb-2';
                newButton.innerText = buttonText;
                newButton.onclick = function () {
                    selectedButtonsDiv.removeChild(newButton);
                    const originalButton = Array.from(document.querySelectorAll('.most-common button')).find(btn => btn.innerText === buttonText);
                    if (originalButton) {
                        originalButton.classList.remove('btn-secondary');
                        originalButton.classList.add('btn-outline-secondary');
                    }
                };
                selectedButtonsDiv.appendChild(newButton);
                button.classList.remove('btn-outline-secondary');
                button.classList.add('btn-secondary');
            }
        }
    
        function addCustomComplaint() {
            const customComplaintInput = document.getElementById('customComplaint');
            const complaintText = customComplaintInput.value.trim();
        
            if (complaintText === '') return;
        
            fetch('/add-complaint', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ complaint: complaintText }),
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const selectedButtonsDiv = document.querySelector('.selected-buttons');
                    const mostCommonButtonsDiv = document.getElementById('mostCommonButtons');
        
                    const newButton = document.createElement('button');
                    newButton.className = 'btn btn-secondary selected-button mb-2';
                    newButton.innerText = complaintText;
                    newButton.onclick = function () {
                        selectedButtonsDiv.removeChild(newButton);
                    };
        
                    selectedButtonsDiv.appendChild(newButton);
        
                    const mostCommonButton = document.createElement('button');
                    mostCommonButton.className = 'btn btn-outline-secondary mb-2';
                    mostCommonButton.innerText = complaintText;
                    mostCommonButton.onclick = function () {
                        addButton(mostCommonButton);
                    };
        
                    mostCommonButtonsDiv.appendChild(mostCommonButton);
        
                    customComplaintInput.value = '';
                } else {
                    console.error('Error adding complaint:', data.error);
                }
            })
            .catch(error => {
                console.error('Error adding complaint:', error);
            });
        }
    
        function searchComplaints() {
            const searchInput = document.getElementById('searchInput').value.toLowerCase();
            const buttons = document.querySelectorAll('.most-common button');
    
            buttons.forEach(button => {
                const complaint = button.innerText.toLowerCase();
                if (complaint.includes(searchInput)) {
                    button.style.display = 'inline-block';
                } else {
                    button.style.display = 'none';
                }
            });
        }
    
        function fetchComplaints() {
            fetch('/fetch-complaints')
                .then(response => response.json())
                .then(complaintData => {
                    const container = document.getElementById('mostCommonButtons');
                    container.innerHTML = ''; 
    
                    complaintData.forEach(complaint => {
                        const button = document.createElement('button');
                        button.className = 'btn btn-outline-secondary m-1';
                        button.textContent = complaint.complaint;
                        button.onclick = function () { addButton(button); };
                        container.appendChild(button);
                    });
                })
                .catch(error => {
                    console.error('Error fetching complaints:', error);
                });
        }
    
        function submitComplaints() {
            const selectedComplaints = Array.from(document.querySelectorAll('.selected-buttons .selected-button')).map(btn => btn.innerText);
            const patientId = getUrlParameter('patientId');
            const doctorId = getUrlParameter('doctorId');
            
            
        
           
        
            fetch('/add-appointment', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    patient_id: patientId,
                    doctor_id: doctorId,
                    complaints: selectedComplaints.join(', '),
                    weight: document.getElementById("weight").value,
                    bp: document.getElementById("bp").value,
                    pulse: document.getElementById("pulse").value,
                    spo2: document.getElementById("spo2").value,
                    temp: document.getElementById("temp").value,
                    sugar: document.getElementById("sugar").value
                }),
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Appointment added successfully.');
                    document.querySelector('.selected-buttons').innerHTML = '';
                    window.location.href = '/all-patients';
                } else {
                    console.error('Error adding appointment:', data.error);
                }
            })
            .catch(error => {
                console.error('Error adding appointment:', error);
            });
        }
        
    </script>
    

</body>

</html>